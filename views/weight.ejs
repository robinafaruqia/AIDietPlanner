<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weight Tracking - AI Diet Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background: #f8f9fa;
            min-height: 100vh;
        }
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 0;
            color: white;
            margin-bottom: 30px;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            border: none;
            margin-bottom: 20px;
        }
        .stat-card {
            text-align: center;
            padding: 25px 15px;
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
        .stat-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }
        .stat-value {
            font-size: 2.2rem;
            font-weight: bold;
        }
        .stat-label {
            color: #888;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .stat-card.start .stat-icon { color: #6366f1; }
        .stat-card.current .stat-icon { color: #8b5cf6; }
        .stat-card.target .stat-icon { color: #ec4899; }
        .stat-card.progress .stat-icon { color: #22c55e; }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 10px;
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        .form-control {
            border-radius: 10px;
            padding: 12px 15px;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .chart-container {
            position: relative;
            height: 300px;
        }
        .history-table {
            max-height: 400px;
            overflow-y: auto;
        }
        .history-table table {
            margin-bottom: 0;
        }
        .weight-change {
            font-weight: 600;
            font-size: 13px;
        }
        .weight-change.positive { color: #ef4444; }
        .weight-change.negative { color: #22c55e; }
        .progress-ring {
            width: 150px;
            height: 150px;
            margin: 0 auto;
        }
        .quick-stats {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 15px;
        }
        .quick-stat {
            background: #f8f9fa;
            padding: 10px 20px;
            border-radius: 10px;
            text-align: center;
        }
        .quick-stat .value {
            font-weight: bold;
            color: #667eea;
        }
        .quick-stat .label {
            font-size: 12px;
            color: #888;
        }
        .toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
        }
        .achievement-toast {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            padding: 15px 20px;
            margin-bottom: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            animation: slideIn 0.5s ease, fadeOut 0.5s ease 4.5s forwards;
            display: flex;
            align-items: center;
            gap: 15px;
            max-width: 320px;
        }
        .achievement-toast .toast-icon {
            width: 50px;
            height: 50px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .achievement-toast .toast-content h6 {
            margin: 0;
            font-size: 12px;
            opacity: 0.8;
        }
        .achievement-toast .toast-content p {
            margin: 0;
            font-weight: 600;
        }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
    </style>
</head>
<body>
    <% const activePage = 'weight'; %>
    <%- include('partials/navbar') %>

    <div class="page-header">
        <div class="container">
            <h1><i class="bi bi-graph-up"></i> Weight Tracking</h1>
            <p class="mb-0">Track your progress and reach your goals</p>
        </div>
    </div>

    <div class="container pb-5">
        <div class="row mb-4">
            <div class="col-md-3 col-6">
                <div class="card stat-card start">
                    <div class="stat-icon"><i class="bi bi-flag"></i></div>
                    <div class="stat-value" id="startWeight">--</div>
                    <div class="stat-label">Start Weight</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card stat-card current">
                    <div class="stat-icon"><i class="bi bi-speedometer2"></i></div>
                    <div class="stat-value" id="currentWeight">--</div>
                    <div class="stat-label">Current Weight</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card stat-card target">
                    <div class="stat-icon"><i class="bi bi-bullseye"></i></div>
                    <div class="stat-value" id="targetWeight">--</div>
                    <div class="stat-label">Target Weight</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card stat-card progress">
                    <div class="stat-icon"><i class="bi bi-trophy"></i></div>
                    <div class="stat-value" id="weightLost">--</div>
                    <div class="stat-label">Progress</div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-graph-up"></i> Weight History</h5>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary active" data-range="30">30 Days</button>
                            <button class="btn btn-outline-primary" data-range="90">90 Days</button>
                            <button class="btn btn-outline-primary" data-range="365">1 Year</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="weightChart"></canvas>
                        </div>
                        <div class="quick-stats" id="quickStats"></div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Weight Log</h5>
                        <button class="btn btn-outline-secondary btn-sm" onclick="exportWeightCSV()">
                            <i class="bi bi-download"></i> Export CSV
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="history-table">
                            <table class="table table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Date</th>
                                        <th>Weight</th>
                                        <th>Change</th>
                                        <th>Note</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="historyTable"></tbody>
                            </table>
                        </div>
                        <div id="noHistory" class="text-center py-5" style="display: none;">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">No weight entries yet. Log your first weight!</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Log Weight</h5>
                    </div>
                    <div class="card-body">
                        <div id="logSuccess" class="alert alert-success" style="display: none;"></div>
                        <div id="logError" class="alert alert-danger" style="display: none;"></div>
                        
                        <form id="logWeightForm">
                            <div class="mb-3">
                                <label class="form-label">Weight (kg)</label>
                                <input type="number" class="form-control form-control-lg" id="newWeight" step="0.1" min="20" max="300" required placeholder="Enter weight">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Date</label>
                                <input type="date" class="form-control" id="weightDate" value="<%= new Date().toISOString().split('T')[0] %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Note (optional)</label>
                                <input type="text" class="form-control" id="weightNote" placeholder="e.g., After workout">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-lg"></i> Log Weight
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-bullseye"></i> Set Goal</h5>
                    </div>
                    <div class="card-body">
                        <div id="goalSuccess" class="alert alert-success" style="display: none;"></div>
                        
                        <form id="setGoalForm">
                            <div class="mb-3">
                                <label class="form-label">Target Weight (kg)</label>
                                <input type="number" class="form-control" id="goalWeight" step="0.1" min="20" max="300" value="<%= user.targetWeight || '' %>" placeholder="Your goal weight">
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="bi bi-check-lg"></i> Update Goal
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card" id="progressCard" style="display: none;">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Goal Progress</h5>
                    </div>
                    <div class="card-body text-center">
                        <canvas id="progressChart" width="150" height="150"></canvas>
                        <div class="mt-3">
                            <span id="progressPercent" class="h3 text-primary">0%</span>
                            <p class="text-muted mb-0">of goal reached</p>
                        </div>
                        <div id="toGoText" class="mt-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let weightChart = null;
        let progressChart = null;
        let weightHistory = [];

        $(document).ready(function() {
            loadStats();
            loadHistory();
        });

        async function loadStats() {
            try {
                const response = await $.get('/api/weight/stats');
                console.log('Weight stats response:', response);
                
                if (response.success && response.stats) {
                    const s = response.stats;
                    console.log('Stats data:', s);
                    
                    $('#startWeight').text(s.startWeight ? s.startWeight + ' kg' : '--');
                    $('#currentWeight').text(s.currentWeight ? s.currentWeight + ' kg' : '--');
                    $('#targetWeight').text(s.targetWeight ? s.targetWeight + ' kg' : '--');
                    
                    // Show progress (lost weight) - check for both null and undefined
                    if (s.lost !== null && s.lost !== undefined) {
                        const prefix = s.lost > 0 ? '-' : '+';
                        const color = s.lost > 0 ? '#22c55e' : '#ef4444';
                        $('#weightLost').html(`<span style="color: ${color}">${prefix}${Math.abs(s.lost)} kg</span>`);
                    } else {
                        $('#weightLost').text('--');
                    }

                    let quickHtml = '';
                    if (s.weeklyChange !== null) {
                        const wColor = s.weeklyChange <= 0 ? '#22c55e' : '#ef4444';
                        quickHtml += `<div class="quick-stat"><div class="value" style="color: ${wColor}">${s.weeklyChange > 0 ? '+' : ''}${s.weeklyChange} kg</div><div class="label">This Week</div></div>`;
                    }
                    if (s.monthlyChange !== null) {
                        const mColor = s.monthlyChange <= 0 ? '#22c55e' : '#ef4444';
                        quickHtml += `<div class="quick-stat"><div class="value" style="color: ${mColor}">${s.monthlyChange > 0 ? '+' : ''}${s.monthlyChange} kg</div><div class="label">This Month</div></div>`;
                    }
                    if (s.daysOnPlan) {
                        quickHtml += `<div class="quick-stat"><div class="value">${s.daysOnPlan}</div><div class="label">Days Tracking</div></div>`;
                    }
                    $('#quickStats').html(quickHtml);

                    if (s.targetWeight && s.percentToGoal !== null) {
                        $('#progressCard').show();
                        $('#progressPercent').text(Math.min(100, Math.max(0, s.percentToGoal)) + '%');
                        
                        if (s.toGo !== null) {
                            const toGoText = s.toGo > 0 
                                ? `<span class="text-muted">${s.toGo} kg to go</span>`
                                : `<span class="text-success">Goal reached! ${Math.abs(s.toGo)} kg below target</span>`;
                            $('#toGoText').html(toGoText);
                        }
                        
                        updateProgressChart(s.percentToGoal);
                    }
                } else if (response.success && !response.stats) {
                    console.log('No weight stats yet:', response.message);
                    // Reset all fields to default
                    $('#startWeight').text('--');
                    $('#currentWeight').text('--');
                    $('#targetWeight').text('--');
                    $('#weightLost').text('--');
                    $('#quickStats').html('');
                    $('#progressCard').hide();
                }
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        }

        async function loadHistory() {
            try {
                const response = await $.get('/api/weight/history');
                if (response.success) {
                    weightHistory = response.history;
                    updateChart(30);
                    renderHistoryTable();
                }
            } catch (error) {
                console.error('Error loading history:', error);
            }
        }

        function updateChart(days) {
            const cutoff = new Date();
            cutoff.setDate(cutoff.getDate() - days);
            
            const filtered = weightHistory.filter(e => new Date(e.date) >= cutoff);
            
            const labels = filtered.map(e => new Date(e.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
            const data = filtered.map(e => e.weight);

            if (weightChart) {
                weightChart.destroy();
            }

            const ctx = document.getElementById('weightChart').getContext('2d');
            weightChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Weight (kg)',
                        data: data,
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: false
                        }
                    }
                }
            });
        }

        function updateProgressChart(percent) {
            const value = Math.min(100, Math.max(0, percent));
            
            if (progressChart) {
                progressChart.destroy();
            }

            const ctx = document.getElementById('progressChart').getContext('2d');
            progressChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [value, 100 - value],
                        backgroundColor: ['#667eea', '#e9ecef'],
                        borderWidth: 0
                    }]
                },
                options: {
                    cutout: '75%',
                    plugins: { legend: { display: false } }
                }
            });
        }

        function renderHistoryTable() {
            if (weightHistory.length === 0) {
                $('#historyTable').empty();
                $('#noHistory').show();
                return;
            }

            $('#noHistory').hide();
            
            const sorted = [...weightHistory].sort((a, b) => new Date(b.date) - new Date(a.date));
            
            let html = '';
            sorted.forEach((entry, i) => {
                const date = new Date(entry.date).toLocaleDateString('en-US', { 
                    year: 'numeric', month: 'short', day: 'numeric' 
                });
                
                let change = '';
                if (i < sorted.length - 1) {
                    const diff = entry.weight - sorted[i + 1].weight;
                    if (diff !== 0) {
                        const cls = diff > 0 ? 'positive' : 'negative';
                        change = `<span class="weight-change ${cls}">${diff > 0 ? '+' : ''}${diff.toFixed(1)} kg</span>`;
                    }
                }

                html += `
                    <tr>
                        <td>${date}</td>
                        <td><strong>${entry.weight} kg</strong></td>
                        <td>${change || '-'}</td>
                        <td><small class="text-muted">${entry.note || '-'}</small></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteEntry('${entry._id}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
            
            $('#historyTable').html(html);
        }

        $('[data-range]').click(function() {
            $('[data-range]').removeClass('active');
            $(this).addClass('active');
            updateChart(parseInt($(this).data('range')));
        });

        $('#logWeightForm').on('submit', async function(e) {
            e.preventDefault();
            $('#logSuccess, #logError').hide();

            try {
                const response = await $.ajax({
                    url: '/api/weight/log',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        weight: parseFloat($('#newWeight').val()),
                        date: $('#weightDate').val(),
                        note: $('#weightNote').val()
                    })
                });

                if (response.success) {
                    $('#logSuccess').text('Weight logged successfully!').show();
                    $('#newWeight').val('');
                    $('#weightNote').val('');
                    loadStats();
                    loadHistory();
                    
                    if (response.newAchievements && response.newAchievements.length > 0) {
                        response.newAchievements.forEach(a => showAchievementToast(a));
                    }
                }
            } catch (error) {
                $('#logError').text(error.responseJSON?.error || 'Failed to log weight').show();
            }
        });

        $('#setGoalForm').on('submit', async function(e) {
            e.preventDefault();
            $('#goalSuccess').hide();

            try {
                const response = await $.ajax({
                    url: '/api/weight/goal',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        targetWeight: $('#goalWeight').val() || null
                    })
                });

                if (response.success) {
                    $('#goalSuccess').text('Goal updated!').show();
                    loadStats();
                }
            } catch (error) {
                alert(error.responseJSON?.error || 'Failed to update goal');
            }
        });

        async function deleteEntry(entryId) {
            if (!confirm('Delete this weight entry?')) return;

            try {
                await $.ajax({
                    url: `/api/weight/entry/${entryId}`,
                    method: 'DELETE'
                });
                loadStats();
                loadHistory();
            } catch (error) {
                alert(error.responseJSON?.error || 'Failed to delete entry');
            }
        }

        function exportWeightCSV() {
            window.location.href = '/api/weight/export/csv';
        }

        function showAchievementToast(achievement) {
            const toast = $(`
                <div class="achievement-toast">
                    <div class="toast-icon">
                        <i class="bi ${achievement.icon || 'bi-trophy'}"></i>
                    </div>
                    <div class="toast-content">
                        <h6>Achievement Unlocked!</h6>
                        <p>${achievement.name}</p>
                    </div>
                </div>
            `);
            
            if (!$('.toast-container').length) {
                $('body').append('<div class="toast-container"></div>');
            }
            
            $('.toast-container').append(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 5000);
        }

    </script>
</body>
</html>
