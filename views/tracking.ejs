        $('#btnAnalyzePhoto').click(async () => {
            if (!selectedFoodPhoto) return;

            $('#photo-upload-section').hide();
            $('#photo-analyzing').show();
            $('#photo-error').hide();
            $('#photo-analysis-results').hide();
            $('#btnAnalyzePhoto').hide();

            const formData = new FormData();
            formData.append('foodImage', selectedFoodPhoto);

            try {
                const response = await fetch('/api/food-recognition/analyze', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                $('#photo-analyzing').hide();

                if (!result.success) {
                    throw new Error(result.error || 'Analysis failed');
                }

                const analysis = result.analysis;
                const isCached = result.cached === true;

                if (!analysis.isFood) {
                    throw new Error(analysis.message || 'This doesn\'t appear to be a food image');
                }

                analyzedFoodData = analysis;
                displayPhotoAnalysis(analysis, isCached);

            } catch (error) {
                $('#photo-analyzing').hide();
                $('#photo-upload-section').show();
                $('#btnAnalyzePhoto').show();
                $('#photo-error-message').text(error.message);
                $('#photo-error').show();
            }
        });

        function displayPhotoAnalysis(analysis, isCached = false) {
            $('#analyzed-photo-thumb').attr('src', $('#photoPreview').attr('src'));
            $('#analyzed-food-name').text(analysis.foodName || 'Unknown Food');
            $('#analyzed-food-desc').text(analysis.description || '');
            $('#analyzed-serving').text(analysis.servingSize || 'Standard serving');
            
            // Show cached indicator for instant results
            if (isCached) {
                if ($('#cached-indicator').length === 0) {
                    $('#analyzed-food-name').after('<span id="cached-indicator" class="badge bg-info ms-2" title="Retrieved from cache for faster results"><i class="bi bi-lightning-fill"></i> Instant</span>');
                }
                $('#cached-indicator').show();
            } else {
                $('#cached-indicator').hide();
            }
            
            const confidenceBadge = $('#analyzed-confidence');
            confidenceBadge.text(analysis.confidence || 'medium');
            confidenceBadge.removeClass('bg-success bg-warning bg-danger');
            if (analysis.confidence === 'high') {
                confidenceBadge.addClass('bg-success');
            } else if (analysis.confidence === 'medium') {
                confidenceBadge.addClass('bg-warning');
            } else {
                confidenceBadge.addClass('bg-danger');
            }

            const nutrition = analysis.nutrition || {};
            $('#photo-calories').text(nutrition.calories || 0);
            $('#photo-protein').text((nutrition.protein || 0) + 'g');
            $('#photo-carbs').text((nutrition.carbs || 0) + 'g');
            $('#photo-fat').text((nutrition.fat || 0) + 'g');

            const ingredientsList = $('#photo-ingredients');
            ingredientsList.empty();
            (analysis.ingredients || []).forEach(ing => {
                ingredientsList.append(`<li><i class="bi bi-dot"></i> ${escapeHtml(ing)}</li>`);
            });

            const healthScore = analysis.healthScore || 5;
            const healthBadge = $('.health-score-badge');
            healthBadge.text(healthScore).removeClass('score-low score-medium score-high');
            if (healthScore <= 3) {
                healthBadge.addClass('score-low');
            } else if (healthScore <= 6) {
                healthBadge.addClass('score-medium');
            } else {
                healthBadge.addClass('score-high');
            }
            $('#photo-health-notes').text(analysis.healthNotes || '');

            const alternatives = analysis.alternatives || [];
            if (alternatives.length > 0) {
                const altList = $('#photo-alternatives');
                altList.empty();
                alternatives.forEach(alt => {
                    altList.append(`<li><i class="bi bi-arrow-right text-success"></i> ${escapeHtml(alt)}</li>`);
                });
                $('#photo-alternatives-card').show();
            } else {
                $('#photo-alternatives-card').hide();
            }

            $('#photo-analysis-results').show();
            $('#btnAddAnalyzedFood').show();
        }

        $('#btnAddAnalyzedFood').click(() => {
