    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentDate = new Date();
        let currentLog = null;
        let macroChart = null;
        let weeklyChart = null;
        let weightChart = null;
        let calculatedGoalsData = null;

        function getDateString(date) {
            // Use local date, not UTC (toISOString uses UTC which can cause date mismatches)
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatDate(date) {
            const today = new Date();
            const yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);
            
            if (getDateString(date) === getDateString(today)) return 'Today';
            if (getDateString(date) === getDateString(yesterday)) return 'Yesterday';
            
            return date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function loadDayData() {
            const dateString = getDateString(currentDate);
            $('#currentDate').text(formatDate(currentDate));
            $('#dateSubtext').text(dateString);

            try {
                const response = await $.get(`/api/nutrition/log/${dateString}`);
                if (response.success) {
                    currentLog = response.log;
                    updateDisplay(response.log);
                    
                    // Show warning if database not connected
                    if (response.message && response.message.includes('Database not connected')) {
                        console.warn('Database not connected - data will not persist');
                        $('#dbWarning').remove();
                        $('main .container').prepend(`
                            <div id="dbWarning" class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>Database not connected.</strong> Your data won't be saved. Please check the server connection.
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `);
                    } else {
                        $('#dbWarning').remove();
                    }
                }
            } catch (error) {
                console.error('Error loading data:', error);
                $('#dbWarning').remove();
                $('main .container').prepend(`
                    <div id="dbWarning" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle"></i>
                        <strong>Failed to load data.</strong> ${error.responseJSON?.error || 'Server error'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `);
            }
        }

        function updateDisplay(log) {
            const totals = log.dailyTotals || {};
            const goals = log.goals || { calories: 2000, protein: 50, carbs: 250, fat: 65, fiber: 25 };
            const burned = log.caloriesBurned || 0;

            // Energy Balance
            $('#caloriesIn').text(totals.calories || 0);
            $('#caloriesBurned').text(burned);
            $('#caloriesNet').text((totals.calories || 0) - burned);

            // Circular Progress
            updateCircularProgress(totals.calories || 0, goals.calories);
            $('#caloriesValue').text(totals.calories || 0);
            $('#caloriesGoal').text(goals.calories);

            // Macro Bars
            updateMacroBar('protein', totals.protein || 0, goals.protein);
            updateMacroBar('carbs', totals.carbs || 0, goals.carbs);
            updateMacroBar('fat', totals.fat || 0, goals.fat);
            updateMacroBar('fiber', totals.fiber || 0, goals.fiber);

            // Update goals in modal
            $('#goalCalories').val(goals.calories);
            $('#goalProtein').val(goals.protein);
            $('#goalCarbs').val(goals.carbs);
            $('#goalFat').val(goals.fat);
            $('#goalFiber').val(goals.fiber);

            // Update charts
            updateMacroChart(totals);
            
            // Render food diary
            renderFoodDiary(log.meals || []);
            
            // Render exercises
            renderExercises(log.exercises || []);
            
            // Water
            renderWaterGlasses(log.water || 0);
            
            // Mood
            updateMoodSelector(log.mood || '');
            
            // Biometrics
            $('#currentWeight').text(log.biometrics?.weight || '--');
            $('#currentBodyFat').text(log.biometrics?.bodyFat ? log.biometrics.bodyFat + '%' : '--');
            if (log.biometrics?.weight) {
                $('#bioWeight').val(log.biometrics.weight);
            }
            if (log.biometrics?.bodyFat) {
                $('#bioBodyFat').val(log.biometrics.bodyFat);
            }
        }

        function updateCircularProgress(value, goal) {
            const percentage = Math.min(100, (value / goal) * 100);
            const circumference = 2 * Math.PI * 58;
            const offset = circumference - (percentage / 100) * circumference;
            $('#caloriesRing .progress-value').css('stroke-dashoffset', offset);
        }

        function updateMacroBar(name, value, goal) {
            const percentage = Math.min(100, (value / goal) * 100);
            $(`#${name}Value`).text(value);
            $(`#${name}Goal`).text(goal);
            $(`#${name}Bar`).css('width', percentage + '%');
        }

        function updateMacroChart(totals) {
            const ctx = document.getElementById('macroChart').getContext('2d');
            
            if (macroChart) macroChart.destroy();
            
            const protein = totals.protein || 0;
            const carbs = totals.carbs || 0;
            const fat = totals.fat || 0;
            
            if (protein + carbs + fat === 0) {
                macroChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['No data'],
                        datasets: [{
                            data: [1],
                            backgroundColor: ['#e5e7eb']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'right' } }
                    }
                });
                return;
            }
            
            macroChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [`Protein ${protein}g`, `Carbs ${carbs}g`, `Fat ${fat}g`],
                    datasets: [{
                        data: [protein * 4, carbs * 4, fat * 9],
                        backgroundColor: ['#22c55e', '#f59e0b', '#3b82f6'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '60%',
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        }

        function renderFoodDiary(meals) {
            const mealTypes = ['breakfast', 'lunch', 'dinner', 'snack'];
            const mealLabels = { breakfast: 'Breakfast', lunch: 'Lunch', dinner: 'Dinner', snack: 'Snacks' };
            const mealIcons = { breakfast: 'bi-sunrise', lunch: 'bi-sun', dinner: 'bi-moon-stars', snack: 'bi-apple' };
            
            let html = '';
            
            mealTypes.forEach(type => {
                const typeMeals = meals.filter(m => m.mealType === type);
                const typeCalories = typeMeals.reduce((sum, m) => sum + (m.calories || 0), 0);
                
                html += `
                    <div class="meal-section ${type}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0"><i class="bi ${mealIcons[type]} me-2"></i>${mealLabels[type]}</h6>
                            <span class="badge bg-secondary">${typeCalories} cal</span>
                        </div>
                `;
                
                if (typeMeals.length === 0) {
                    html += `<p class="text-muted small mb-0">No ${type} logged</p>`;
                } else {
                    typeMeals.forEach(meal => {
                        html += `
                            <div class="food-item">
                                <div>
                                    <strong>${escapeHtml(meal.name)}</strong>
                                    <br><small class="text-muted">${escapeHtml(meal.servingSize || '1 serving')} • ${meal.calories} cal</small>
                                </div>
                                <button class="btn btn-sm btn-outline-danger btn-remove-meal" data-meal-id="${meal._id}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        `;
                    });
                }
                
                html += '</div>';
            });
            
            $('#foodDiary').html(html);
        }

        function renderExercises(exercises) {
            if (!exercises || exercises.length === 0) {
                $('#exerciseList').html('<p class="text-muted text-center mb-0">No exercises logged</p>');
                return;
            }
            
            const html = exercises.map(ex => `
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <strong>${escapeHtml(ex.name)}</strong>
                        <br><small class="text-muted">${ex.duration} min • ${ex.caloriesBurned} cal burned</small>
                    </div>
                    <button class="btn btn-sm btn-outline-danger btn-remove-exercise" data-exercise-id="${ex._id}">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `).join('');
            
            $('#exerciseList').html(html);
        }

        function renderWaterGlasses(count) {
            let html = '';
            for (let i = 1; i <= 8; i++) {
                html += `<div class="water-glass ${i <= count ? 'filled' : ''}" data-water-count="${i}" title="${i} glasses"></div>`;
            }
            $('#waterGlasses').html(html);
            $('#waterCount').text(count);
        }

        function updateMoodSelector(mood) {
            $('.mood-btn').removeClass('active');
            if (mood) {
                $(`.mood-btn[data-mood="${mood}"]`).addClass('active');
            }
        }

        async function setWater(glasses) {
            try {
                await $.ajax({
                    url: '/api/nutrition/water',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), glasses })
                });
                renderWaterGlasses(glasses);
            } catch (error) {
                console.error('Error updating water:', error);
            }
        }

        async function setMood(mood) {
            try {
                await $.ajax({
                    url: '/api/nutrition/mood',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), mood })
                });
                updateMoodSelector(mood);
            } catch (error) {
                console.error('Error updating mood:', error);
            }
        }

        async function addMeal() {
            const mealName = $('#mealName').val().trim();
            const data = {
                date: getDateString(currentDate),
                mealType: $('input[name="mealType"]:checked').val(),
                name: mealName,
                servingSize: $('#servingSize').val() || '1 serving',
                calories: parseInt($('#mealCalories').val()) || 0,
                protein: parseInt($('#mealProtein').val()) || 0,
                carbs: parseInt($('#mealCarbs').val()) || 0,
                fat: parseInt($('#mealFat').val()) || 0,
                fiber: parseInt($('#mealFiber').val()) || 0
            };

            if (!mealName) {
                alert('Please enter a food name');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/meal',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addMealModal'));
                    if (modal) modal.hide();
                    $('#addMealForm')[0].reset();
                    await loadDayData();
                    loadWeeklyChart();
                } else {
                    alert('Failed to add food: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Meal add error:', error);
                alert('Failed to add food: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function removeMeal(mealId) {
            if (!confirm('Remove this food?')) return;
            
            try {
                await $.ajax({
                    url: `/api/nutrition/log/meal/${getDateString(currentDate)}/${mealId}`,
                    method: 'DELETE'
                });
                loadDayData();
                loadWeeklyChart();
            } catch (error) {
                alert('Failed to remove food');
            }
        }

        async function addExercise() {
            const exerciseName = $('#exerciseName').val().trim();
            const data = {
                date: getDateString(currentDate),
                name: exerciseName,
                type: $('#exerciseType').val(),
                duration: parseInt($('#exerciseDuration').val()) || 0,
                caloriesBurned: parseInt($('#exerciseCalories').val()) || 0
            };

            if (!exerciseName) {
                alert('Please enter an exercise name');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/exercise',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addExerciseModal'));
                    if (modal) modal.hide();
                    $('#exerciseName').val('');
                    $('#exerciseDuration').val('');
                    $('#exerciseCalories').val('');
                    await loadDayData();
                } else {
                    alert('Failed to add exercise: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Exercise add error:', error);
                alert('Failed to add exercise: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function removeExercise(exerciseId) {
            if (!confirm('Remove this exercise?')) return;
            
            try {
                await $.ajax({
                    url: `/api/nutrition/log/exercise/${getDateString(currentDate)}/${exerciseId}`,
                    method: 'DELETE'
                });
                loadDayData();
            } catch (error) {
                alert('Failed to remove exercise');
            }
        }

        async function saveGoals() {
            const goals = {
                calories: parseInt($('#goalCalories').val()) || 2000,
                protein: parseInt($('#goalProtein').val()) || 50,
                carbs: parseInt($('#goalCarbs').val()) || 250,
                fat: parseInt($('#goalFat').val()) || 65,
                fiber: parseInt($('#goalFiber').val()) || 25
            };

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/goals',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), goals })
                });
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('goalsModal'));
                    if (modal) modal.hide();
                    await loadDayData();
                } else {
                    alert('Failed to save goals: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Goals save error:', error);
                alert('Failed to save goals: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function saveBiometrics() {
            const data = {
                date: getDateString(currentDate),
                weight: parseFloat($('#bioWeight').val()) || undefined,
                bodyFat: parseFloat($('#bioBodyFat').val()) || undefined,
                waist: parseFloat($('#bioWaist').val()) || undefined
            };

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/biometrics',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('biometricsModal'));
                    if (modal) modal.hide();
                    await loadDayData();
                    loadWeightChart();
                } else {
                    alert('Failed to save biometrics: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Biometrics save error:', error);
                alert('Failed to save biometrics: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function calculateGoals() {
            const data = {
                weight: parseFloat($('#wizardWeight').val()),
                height: parseFloat($('#wizardHeight').val()),
                age: parseInt($('#wizardAge').val()) || 30,
                gender: $('#wizardGender').val(),
                activityLevel: $('#wizardActivity').val(),
                goal: $('#wizardGoal').val()
            };

            if (!data.weight || !data.height) {
                alert('Please enter weight and height');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/calculate-goals',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });

                if (response.success) {
                    calculatedGoalsData = response.goals;
                    $('#calculatedGoals').html(`
                        <h6>Your Calculated Goals:</h6>
                        <p class="mb-1"><strong>BMR:</strong> ${response.bmr} cal/day</p>
                        <p class="mb-1"><strong>TDEE:</strong> ${response.tdee} cal/day</p>
                        <hr>
                        <p class="mb-1"><strong>Calories:</strong> ${response.goals.calories}</p>
                        <p class="mb-1"><strong>Protein:</strong> ${response.goals.protein}g</p>
                        <p class="mb-1"><strong>Carbs:</strong> ${response.goals.carbs}g</p>
                        <p class="mb-1"><strong>Fat:</strong> ${response.goals.fat}g</p>
                        <p class="mb-0"><strong>Fiber:</strong> ${response.goals.fiber}g</p>
                    `).show();
                    $('#btnApplyGoals').show();
                }
            } catch (error) {
                alert('Failed to calculate goals');
            }
        }

        async function applyCalculatedGoals() {
            if (!calculatedGoalsData) return;
            
            try {
                const response = await $.ajax({
                    url: '/api/nutrition/goals',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), goals: calculatedGoalsData })
                });
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('goalWizardModal'));
                    if (modal) modal.hide();
                    await loadDayData();
                    alert('Goals applied successfully!');
                } else {
                    alert('Failed to apply goals: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Apply goals error:', error);
                alert('Failed to apply goals: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function loadWeeklyChart() {
            try {
                const response = await $.get('/api/nutrition/history/7');
                if (!response.success) return;

                const labels = [];
                const data = [];
                
                for (let i = 6; i >= 0; i--) {
                    const date = new Date();
                    date.setDate(date.getDate() - i);
                    const dateStr = getDateString(date);
                    labels.push(date.toLocaleDateString('en-US', { weekday: 'short' }));
                    const log = response.history.find(h => h.dateString === dateStr);
                    data.push(log?.dailyTotals?.calories || 0);
                }

                if (weeklyChart) weeklyChart.destroy();
                
                const ctx = document.getElementById('weeklyChart').getContext('2d');
                weeklyChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Calories',
                            data,
                            backgroundColor: 'rgba(102, 126, 234, 0.7)',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            } catch (error) {
                console.error('Error loading weekly chart:', error);
            }
        }

        async function loadWeightChart() {
            try {
                const response = await $.get('/api/nutrition/biometrics/history/30');
                if (!response.success || response.history.length === 0) {
                    return;
                }

                const labels = response.history.map(h => h.date.slice(5));
                const data = response.history.map(h => h.weight);

                if (weightChart) weightChart.destroy();
                
                const ctx = document.getElementById('weightChart').getContext('2d');
                weightChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Weight',
                            data,
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            fill: true,
                            tension: 0.3
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: false } }
                    }
                });
            } catch (error) {
                console.error('Error loading weight chart:', error);
            }
        }

        async function loadStreak() {
            try {
                const response = await $.get('/api/nutrition/streak');
                if (response.success && response.streak > 0) {
                    $('#streakCount').text(response.streak);
                    $('#streakBadge').show();
                }
            } catch (error) {
                console.error('Error loading streak:', error);
            }
        }

        // Event Listeners
        $('#prevDay').click(() => {
            currentDate.setDate(currentDate.getDate() - 1);
            loadDayData();
        });

        $('#nextDay').click(() => {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            if (currentDate < tomorrow) {
                currentDate.setDate(currentDate.getDate() + 1);
                loadDayData();
            }
        });

        $('#todayBtn').click(() => {
            currentDate = new Date();
            loadDayData();
        });

        $('#moodSelector').on('click', '.mood-btn', function() {
            const mood = $(this).data('mood');
            setMood(mood);
        });

        // Modal button handlers
        $('#btnAddMeal').click(() => addMeal());
        $('#btnAddExercise').click(() => addExercise());
        $('#btnSaveGoals').click(() => saveGoals());
        $('#btnCalculateGoals').click(() => calculateGoals());
        $('#btnApplyGoals').click(() => applyCalculatedGoals());
        $('#btnSaveBiometrics').click(() => saveBiometrics());

        // Event delegation for dynamically rendered elements
        $('#foodDiary').on('click', '.btn-remove-meal', function() {
            const mealId = $(this).data('meal-id');
            removeMeal(mealId);
        });

        $('#exerciseList').on('click', '.btn-remove-exercise', function() {
            const exerciseId = $(this).data('exercise-id');
            removeExercise(exerciseId);
        });

        $('#waterGlasses').on('click', '.water-glass', function() {
            const count = $(this).data('water-count');
            setWater(count);
        });

        function exportNutritionCSV(days) {
            window.location.href = `/api/nutrition/export/csv?days=${days}`;
        }

        // Favorites functionality
        let userFavorites = [];
        const isLoggedIn = <%= user ? 'true' : 'false' %>;

        async function loadFavorites() {
            if (!isLoggedIn) return;
            
            try {
                const response = await $.get('/api/favorites');
                if (response.success) {
                    userFavorites = response.favorites;
                    renderFavorites(userFavorites);
                }
            } catch (error) {
                console.error('Error loading favorites:', error);
                if (error.status === 401) {
                    $('#favoritesList').html('<p class="text-muted text-center small mb-0"><a href="/login">Log in</a> to save favorite meals</p>');
                } else {
                    $('#favoritesList').html('<p class="text-muted text-center small mb-0">Failed to load favorites</p>');
                }
            }
        }

        function renderFavorites(favorites) {
            if (!favorites || favorites.length === 0) {
                $('#favoritesList').html('<p class="text-muted text-center small mb-0">No favorites yet. Add meals to your favorites for quick logging!</p>');
                return;
            }

            const mealTypeIcons = {
                breakfast: 'bi-sunrise text-warning',
                lunch: 'bi-sun text-success',
                dinner: 'bi-moon-stars text-primary',
                snack: 'bi-apple text-secondary'
            };

            const html = favorites.map(fav => `
                <div class="favorite-item d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div class="flex-grow-1" style="min-width: 0;">
                        <div class="d-flex align-items-center">
                            <i class="bi ${mealTypeIcons[fav.mealType] || 'bi-circle'} me-2"></i>
                            <strong class="text-truncate" style="max-width: 120px;" title="${escapeHtml(fav.name)}">${escapeHtml(fav.name)}</strong>
                        </div>
                        <small class="text-muted">${fav.calories} cal</small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-success btn-log-favorite" data-fav-id="${fav.id}" title="Log to today">
                            <i class="bi bi-plus-circle"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-delete-favorite" data-fav-id="${fav.id}" title="Remove">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');

            $('#favoritesList').html(html);
        }

        async function logFavorite(favoriteId) {
            try {
                const response = await $.ajax({
                    url: `/api/favorites/${favoriteId}/log`,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate) })
                });

                if (response.success) {
                    await loadDayData();
                    loadWeeklyChart();
                    showToast('success', 'Meal Logged!', response.message);
                } else {
                    alert('Failed to log favorite: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error logging favorite:', error);
                alert('Failed to log favorite: ' + (error.responseJSON?.error || 'Server error'));
            }
        }

        async function deleteFavorite(favoriteId) {
            if (!confirm('Remove this meal from favorites?')) return;

            try {
                const response = await $.ajax({
                    url: `/api/favorites/${favoriteId}`,
                    method: 'DELETE'
                });

                if (response.success) {
                    loadFavorites();
                    showToast('success', 'Removed', 'Favorite removed successfully');
                } else {
                    alert('Failed to remove favorite');
                }
            } catch (error) {
                console.error('Error deleting favorite:', error);
                alert('Failed to remove favorite');
            }
        }

        async function addToFavorites() {
            const mealName = $('#mealName').val().trim();
            if (!mealName) {
                alert('Please enter a food name');
                return;
            }

            const data = {
                name: mealName,
                mealType: $('input[name="mealType"]:checked').val(),
                servingSize: $('#servingSize').val() || '1 serving',
                calories: parseInt($('#mealCalories').val()) || 0,
                protein: parseInt($('#mealProtein').val()) || 0,
                carbs: parseInt($('#mealCarbs').val()) || 0,
                fat: parseInt($('#mealFat').val()) || 0,
                fiber: parseInt($('#mealFiber').val()) || 0
            };

            try {
                const response = await $.ajax({
                    url: '/api/favorites',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });

                if (response.success) {
                    showToast('success', 'Saved!', `${escapeHtml(mealName)} added to favorites`);
                    loadFavorites();
                } else {
                    alert('Failed to save favorite: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error saving favorite:', error);
                const msg = error.responseJSON?.error || 'Failed to save favorite';
                alert(msg);
            }
        }

        function showToast(type, title, message) {
            const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            const toast = $(`
                <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
                    <div class="toast show" role="alert">
                        <div class="toast-header ${bgClass} text-white">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                            <strong class="me-auto">${escapeHtml(title)}</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">${escapeHtml(message)}</div>
                    </div>
                </div>
            `);
            $('body').append(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // Event handlers for favorites
        $('#favoritesList').on('click', '.btn-log-favorite', function() {
            const favId = $(this).data('fav-id');
            logFavorite(favId);
        });

        $('#favoritesList').on('click', '.btn-delete-favorite', function() {
            const favId = $(this).data('fav-id');
            deleteFavorite(favId);
        });

        $('#refreshFavorites').click(() => loadFavorites());

        $('#btnAddToFavorites').click(() => addToFavorites());

        // Barcode Scanner functionality
        let html5QrCode = null;
        let scannedProductData = null;
        let isScanning = false;

        function initBarcodeScanner() {
            if (html5QrCode) {
                return;
            }

            html5QrCode = new Html5Qrcode("barcode-scanner-container");
        }

        async function startScanning() {
            if (isScanning) return;

            $('#scanner-view').show();
            $('#product-preview').hide();
            $('#scanner-error').hide();
            $('#scanner-status').html('<span class="text-muted"><i class="bi bi-camera-video"></i> Initializing camera...</span>');

            initBarcodeScanner();

            const config = {
                fps: 10,
                qrbox: { width: 250, height: 100 },
                aspectRatio: 1.5,
                formatsToSupport: [
                    Html5QrcodeSupportedFormats.EAN_13,
                    Html5QrcodeSupportedFormats.EAN_8,
                    Html5QrcodeSupportedFormats.UPC_A,
                    Html5QrcodeSupportedFormats.UPC_E,
                    Html5QrcodeSupportedFormats.CODE_128,
                    Html5QrcodeSupportedFormats.CODE_39
                ]
            };

            try {
                await html5QrCode.start(
                    { facingMode: "environment" },
                    config,
                    onBarcodeDetected,
                    (errorMessage) => {
                        // Ignore scan errors (expected when no barcode in view)
                    }
                );
                isScanning = true;
                $('#scanner-status').html('<span class="text-success"><i class="bi bi-check-circle"></i> Camera active - point at a barcode</span>');
            } catch (err) {
                console.error('Camera error:', err);
                let errorMsg = 'Could not access camera.';
                if (err.toString().includes('NotAllowedError')) {
                    errorMsg = 'Camera permission denied. Please allow camera access and try again.';
                } else if (err.toString().includes('NotFoundError')) {
                    errorMsg = 'No camera found on this device.';
                } else if (err.toString().includes('NotReadableError')) {
                    errorMsg = 'Camera is in use by another application.';
                }
                $('#scanner-status').html(`<span class="text-danger"><i class="bi bi-x-circle"></i> ${errorMsg}</span>`);
            }
        }

        async function stopScanning() {
            if (html5QrCode && isScanning) {
                try {
                    await html5QrCode.stop();
                    isScanning = false;
                } catch (err) {
                    console.error('Error stopping scanner:', err);
                }
            }
        }

        async function onBarcodeDetected(decodedText, decodedResult) {
            await stopScanning();
            $('#scanner-status').html('<span class="text-info"><i class="bi bi-hourglass-split"></i> Looking up product...</span>');
            lookupBarcode(decodedText);
        }

        async function lookupBarcode(barcode) {
            const cleanBarcode = barcode.replace(/\D/g, '');
            
            if (cleanBarcode.length < 8 || cleanBarcode.length > 14) {
                showScannerError('Invalid barcode format. Please scan a UPC or EAN barcode (8-14 digits).');
                return;
            }

            try {
                const response = await $.get(`/api/nutrition/barcode/${cleanBarcode}`);
                
                if (response.success) {
                    scannedProductData = response;
                    showProductPreview(response);
                } else {
                    showScannerError(response.error || 'Product not found in database. Try entering the food manually.');
                }
            } catch (error) {
                console.error('Barcode lookup error:', error);
                showScannerError('Failed to look up product. Please check your internet connection and try again.');
            }
        }

        function showProductPreview(product) {
            $('#scanner-view').hide();
            $('#scanner-error').hide();
            $('#product-preview').show();

            $('#scanned-product-name').text(product.name);
            $('#scanned-product-brand').text(product.brand || '');
            $('#scanned-barcode-badge').text(product.barcode);

            if (product.image) {
                $('#scanned-product-image').attr('src', product.image).show();
                $('#no-product-image').hide();
            } else {
                $('#scanned-product-image').hide();
                $('#no-product-image').show();
            }

            if (product.nutriscore) {
                $('#scanned-nutriscore')
                    .text('Nutri-Score ' + product.nutriscore.toUpperCase())
                    .removeClass('nutriscore-a nutriscore-b nutriscore-c nutriscore-d nutriscore-e')
                    .addClass('nutriscore-' + product.nutriscore.toLowerCase())
                    .show();
            } else {
                $('#scanned-nutriscore').hide();
            }

            $('#preview-calories').text(product.calories);
            $('#preview-protein').text(product.protein + 'g');
            $('#preview-carbs').text(product.carbs + 'g');
            $('#preview-fat').text(product.fat + 'g');
            $('#preview-fiber').text(product.fiber + 'g');
            $('#preview-serving-size').text('Per ' + product.servingSize);
        }

        function showScannerError(message) {
            $('#scanner-view').hide();
            $('#product-preview').hide();
            $('#scanner-error').show();
            $('#scanner-error-message').text(message);
        }

        function addScannedProductToMealForm() {
            if (!scannedProductData) return;

            const barcodeModal = bootstrap.Modal.getInstance(document.getElementById('barcodeScannerModal'));
            if (barcodeModal) barcodeModal.hide();

            const mealModal = new bootstrap.Modal(document.getElementById('addMealModal'));

            let displayName = scannedProductData.name;
            if (scannedProductData.brand) {
                displayName = `${scannedProductData.brand} - ${scannedProductData.name}`;
            }

            $('#mealName').val(displayName);
            $('#servingSize').val(scannedProductData.servingSize || '1 serving');
            $('#mealCalories').val(scannedProductData.calories || 0);
            $('#mealProtein').val(scannedProductData.protein || 0);
            $('#mealCarbs').val(scannedProductData.carbs || 0);
            $('#mealFat').val(scannedProductData.fat || 0);
            $('#mealFiber').val(scannedProductData.fiber || 0);

            mealModal.show();
            scannedProductData = null;
        }

        // Barcode Scanner Modal Events
        const barcodeScannerModal = document.getElementById('barcodeScannerModal');
        
        barcodeScannerModal.addEventListener('shown.bs.modal', () => {
            startScanning();
        });

        barcodeScannerModal.addEventListener('hidden.bs.modal', () => {
            stopScanning();
            $('#scanner-view').show();
            $('#product-preview').hide();
            $('#scanner-error').hide();
            $('#manualBarcodeInput').val('');
            scannedProductData = null;
        });

        $('#btnManualLookup').click(() => {
            const barcode = $('#manualBarcodeInput').val().trim();
            if (barcode) {
                stopScanning();
                $('#scanner-status').html('<span class="text-info"><i class="bi bi-hourglass-split"></i> Looking up product...</span>');
                lookupBarcode(barcode);
            }
        });

        $('#manualBarcodeInput').on('keypress', (e) => {
            if (e.which === 13) {
                e.preventDefault();
                $('#btnManualLookup').click();
            }
        });

        $('#btnScanAgain, #btnTryAgain').click(() => {
            $('#scanner-view').show();
            $('#product-preview').hide();
            $('#scanner-error').hide();
            scannedProductData = null;
            startScanning();
        });

        $('#btnAddScannedProduct').click(() => {
            addScannedProductToMealForm();
        });

        // Initialize
        $(document).ready(() => {
            loadDayData();
            loadWeeklyChart();
            loadWeightChart();
            loadStreak();
            loadFavorites();
        });
    </script>
</body>
</html>
