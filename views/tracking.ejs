<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nutrition Tracking - AI Diet Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #E85D3B 0%, #D14B2A 100%);
            --calories-color: #ef4444;
            --protein-color: #22c55e;
            --carbs-color: #f59e0b;
            --fat-color: #3b82f6;
            --fiber-color: #8b5cf6;
        }
        body {
            background: #f0f2f5;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar {
            background: var(--primary-gradient) !important;
        }
        .card {
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            border: none;
            margin-bottom: 20px;
        }
        .card-header {
            border-radius: 16px 16px 0 0 !important;
            font-weight: 600;
        }
        
        /* Circular Progress */
        .circular-progress {
            position: relative;
            width: 140px;
            height: 140px;
            margin: 0 auto;
        }
        .circular-progress svg {
            transform: rotate(-90deg);
        }
        .circular-progress .progress-ring {
            fill: none;
            stroke-width: 12;
            stroke-linecap: round;
        }
        .circular-progress .progress-bg {
            stroke: #e5e7eb;
        }
        .circular-progress .progress-value {
            transition: stroke-dashoffset 0.5s ease;
        }
        .circular-progress .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        .circular-progress .progress-number {
            font-size: 1.8rem;
            font-weight: bold;
            display: block;
        }
        .circular-progress .progress-label {
            font-size: 0.75rem;
            color: #6b7280;
        }
        
        /* Macro Bars */
        .macro-bar {
            background: #f3f4f6;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 10px;
        }
        .macro-bar .progress {
            height: 8px;
            border-radius: 4px;
            background: #e5e7eb;
        }
        .macro-bar .progress-bar {
            border-radius: 4px;
        }
        .macro-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 0.9rem;
        }
        
        /* Date Navigation */
        .date-nav {
            background: var(--primary-gradient);
            padding: 15px 0;
            color: white;
            margin-bottom: 20px;
        }
        .date-nav button {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            transition: all 0.2s;
        }
        .date-nav button:hover {
            background: rgba(255,255,255,0.3);
        }
        
        /* Food Diary */
        .meal-section {
            border-left: 4px solid;
            padding-left: 15px;
            margin-bottom: 20px;
        }
        .meal-section.breakfast { border-color: #f59e0b; }
        .meal-section.lunch { border-color: #22c55e; }
        .meal-section.dinner { border-color: #3b82f6; }
        .meal-section.snack { border-color: #8b5cf6; }
        
        .food-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f3f4f6;
        }
        .food-item:last-child {
            border-bottom: none;
        }
        
        /* Stats Cards */
        .stat-card {
            text-align: center;
            padding: 20px;
            border-radius: 12px;
            background: white;
        }
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
        }
        .stat-label {
            font-size: 0.85rem;
            color: #6b7280;
        }
        
        /* Water Tracker */
        .water-glass {
            width: 32px;
            height: 40px;
            border: 2px solid #60a5fa;
            border-radius: 0 0 8px 8px;
            margin: 4px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
        }
        .water-glass.filled {
            background: linear-gradient(to top, #60a5fa 100%, transparent 100%);
        }
        .water-glass:hover {
            transform: scale(1.1);
        }
        
        /* Streak Badge - Enhanced */
        .streak-badge {
            color: white;
            padding: 10px 18px;
            border-radius: 24px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            position: relative;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .streak-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        }
        
        /* Streak Badge Tiers */
        .streak-badge.streak-starting {
            background: linear-gradient(135deg, #6b7280, #4b5563);
        }
        .streak-badge.streak-bronze {
            background: linear-gradient(135deg, #cd7f32, #a0522d);
        }
        .streak-badge.streak-silver {
            background: linear-gradient(135deg, #c0c0c0, #a8a8a8);
            color: #333;
        }
        .streak-badge.streak-gold {
            background: linear-gradient(135deg, #ffd700, #ffb347);
            color: #333;
        }
        .streak-badge.streak-platinum {
            background: linear-gradient(135deg, #e5e4e2, #a0b2c6);
            color: #333;
        }
        .streak-badge.streak-diamond {
            background: linear-gradient(135deg, #b9f2ff, #89cff0);
            color: #333;
        }
        .streak-badge.streak-legendary {
            background: linear-gradient(135deg, #ff6b35, #f72585, #7209b7);
            background-size: 200% 200%;
            animation: legendaryGradient 3s ease infinite;
        }
        
        @keyframes legendaryGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        /* Flame Animation */
        .streak-flame {
            display: inline-block;
            font-size: 1.2rem;
            animation: flameFlicker 0.5s ease-in-out infinite alternate;
        }
        .streak-badge.streak-legendary .streak-flame {
            animation: flameFlicker 0.3s ease-in-out infinite alternate, flamePulse 1s ease-in-out infinite;
        }
        
        @keyframes flameFlicker {
            0% { transform: scale(1) rotate(-3deg); }
            100% { transform: scale(1.1) rotate(3deg); }
        }
        
        @keyframes flamePulse {
            0%, 100% { filter: drop-shadow(0 0 3px #ff6b35); }
            50% { filter: drop-shadow(0 0 8px #ff6b35) drop-shadow(0 0 15px #f72585); }
        }
        
        /* Streak Glow Effects */
        .streak-badge.streak-gold {
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
        }
        .streak-badge.streak-platinum {
            box-shadow: 0 4px 15px rgba(160, 178, 198, 0.5);
        }
        .streak-badge.streak-diamond {
            box-shadow: 0 4px 15px rgba(137, 207, 240, 0.6);
            animation: diamondShimmer 2s ease-in-out infinite;
        }
        .streak-badge.streak-legendary {
            box-shadow: 0 4px 20px rgba(247, 37, 133, 0.5);
            animation: legendaryGradient 3s ease infinite, legendaryPulse 2s ease-in-out infinite;
        }
        
        @keyframes diamondShimmer {
            0%, 100% { box-shadow: 0 4px 15px rgba(137, 207, 240, 0.6); }
            50% { box-shadow: 0 6px 25px rgba(137, 207, 240, 0.8), 0 0 30px rgba(185, 242, 255, 0.4); }
        }
        
        @keyframes legendaryPulse {
            0%, 100% { box-shadow: 0 4px 20px rgba(247, 37, 133, 0.5); }
            50% { box-shadow: 0 6px 30px rgba(247, 37, 133, 0.7), 0 0 40px rgba(114, 9, 183, 0.5); }
        }
        
        /* Milestone Icon */
        .streak-milestone-icon {
            font-size: 1rem;
            margin-left: 4px;
        }
        
        /* Streak Tooltip */
        .streak-tooltip {
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.9);
            color: white;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: normal;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            margin-bottom: 8px;
            z-index: 100;
        }
        .streak-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: rgba(0,0,0,0.9);
        }
        .streak-badge:hover .streak-tooltip {
            opacity: 1;
            visibility: visible;
        }
        
        /* Celebration Toast */
        .celebration-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.8);
            background: linear-gradient(135deg, #E85D3B, #D14B2A);
            color: white;
            padding: 30px 50px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            z-index: 9999;
            opacity: 0;
            animation: celebrationAppear 0.5s ease forwards;
        }
        .celebration-toast.hiding {
            animation: celebrationDisappear 0.5s ease forwards;
        }
        
        @keyframes celebrationAppear {
            0% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
            50% { transform: translate(-50%, -50%) scale(1.05); }
            100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }
        
        @keyframes celebrationDisappear {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
            100% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
        }
        
        .celebration-icon {
            font-size: 4rem;
            margin-bottom: 15px;
            animation: celebrationBounce 0.6s ease infinite;
        }
        
        @keyframes celebrationBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        
        .celebration-title {
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 8px;
        }
        
        .celebration-message {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            top: -10px;
            z-index: 9998;
            animation: confettiFall 3s ease-out forwards;
        }
        
        @keyframes confettiFall {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }
        
        /* Mood Selector */
        .mood-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid #e5e7eb;
            background: white;
            font-size: 1.5rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .mood-btn:hover, .mood-btn.active {
            transform: scale(1.1);
            border-color: #E85D3B;
        }
        .mood-btn.active {
            background: #f0f0ff;
        }
        
        /* Energy Balance */
        .energy-balance {
            background: linear-gradient(135deg, #1e3a5f, #2d5a87);
            color: white;
            border-radius: 16px;
            padding: 24px;
        }
        .energy-value {
            font-size: 2.5rem;
            font-weight: bold;
        }
        .energy-label {
            font-size: 0.9rem;
            opacity: 0.8;
        }
        
        .btn-primary {
            background: var(--primary-gradient);
            border: none;
        }
        
        /* Barcode Scanner Styles */
        #barcode-scanner-container {
            width: 100%;
            min-height: 300px;
            background: #000;
            border-radius: 8px;
            overflow: hidden;
            position: relative;
        }
        #barcode-scanner-container video {
            width: 100%;
            height: auto;
        }
        .scanner-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 250px;
            height: 100px;
            border: 3px solid #22c55e;
            border-radius: 8px;
            box-shadow: 0 0 0 9999px rgba(0,0,0,0.5);
            pointer-events: none;
        }
        .scanner-line {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #22c55e;
            animation: scan 2s linear infinite;
        }
        @keyframes scan {
            0%, 100% { top: 0; }
            50% { top: 100%; }
        }
        .scanned-product-preview {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 16px;
            margin-top: 16px;
        }
        .scanned-product-preview img {
            max-width: 80px;
            max-height: 80px;
            object-fit: contain;
            border-radius: 8px;
        }
        .nutriscore {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: uppercase;
        }
        .nutriscore-a { background: #038141; color: white; }
        .nutriscore-b { background: #85bb2f; color: white; }
        .nutriscore-c { background: #fecb02; color: #333; }
        .nutriscore-d { background: #ee8100; color: white; }
        .nutriscore-e { background: #e63e11; color: white; }
        
        /* Exercise Library Styles */
        .exercise-card {
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .exercise-card:hover {
            border-color: #E85D3B;
            background: #f8f9ff;
        }
        .exercise-card.selected {
            border-color: #E85D3B;
            background: #f0f0ff;
            box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.2);
        }
        .exercise-card .exercise-info {
            flex: 1;
        }
        .exercise-card .exercise-name {
            font-weight: 500;
            margin-bottom: 2px;
        }
        .exercise-card .exercise-meta {
            font-size: 0.8rem;
            color: #6b7280;
        }
        .exercise-card .cal-indicator {
            background: #fef3c7;
            color: #92400e;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .duration-btn.active {
            background: var(--primary-gradient);
            border-color: #E85D3B;
            color: white;
        }
        #exerciseCategoriesAccordion .accordion-button {
            padding: 12px 16px;
            font-weight: 500;
        }
        #exerciseCategoriesAccordion .accordion-button:not(.collapsed) {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
            color: #E85D3B;
        }
        #exerciseCategoriesAccordion .accordion-body {
            padding: 12px;
            max-height: 250px;
            overflow-y: auto;
        }
        #selectedExercisePanel {
            border: 2px solid #E85D3B;
        }
        #calorieCalculation {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(59, 130, 246, 0.1));
            border: none;
        }
        
        /* Fasting Timer Styles - Override global card styles */
        .fasting-card {
            background: linear-gradient(135deg, #1e1e2e, #2d2d44) !important;
            border-radius: 16px !important;
            color: white !important;
            overflow: hidden;
            border: 1px solid rgba(168, 85, 247, 0.2) !important;
            box-shadow: 0 4px 20px rgba(168, 85, 247, 0.15) !important;
        }
        .fasting-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(168, 85, 247, 0.25) !important;
            background: linear-gradient(135deg, #1e1e2e, #2d2d44) !important;
        }
        .fasting-card .card-header {
            background: transparent !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
            color: white !important;
        }
        .fasting-card .card-header span,
        .fasting-card .card-header i {
            color: white !important;
        }
        .fasting-card .card-body {
            background: transparent !important;
            color: white !important;
        }
        .fasting-card .card-body * {
            color: inherit;
        }
        .fasting-card .form-check-input {
            background-color: rgba(255,255,255,0.2) !important;
            border-color: rgba(255,255,255,0.3) !important;
        }
        .fasting-card .form-check-input:checked {
            background-color: #a855f7 !important;
            border-color: #a855f7 !important;
        }
        .fasting-card input[type="time"] {
            background: rgba(255,255,255,0.1) !important;
            border: 1px solid rgba(255,255,255,0.2) !important;
            color: white !important;
            border-radius: 8px;
            padding: 8px 12px;
        }
        .fasting-card input[type="time"]:focus {
            border-color: #a855f7 !important;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.2) !important;
        }
        .fasting-timer-container {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 0 auto;
        }
        .fasting-timer-ring {
            transform: rotate(-90deg);
        }
        .fasting-timer-bg {
            fill: none;
            stroke: rgba(255,255,255,0.1);
            stroke-width: 10;
        }
        .fasting-timer-progress {
            fill: none;
            stroke-width: 10;
            stroke-linecap: round;
            transition: stroke-dashoffset 1s ease, stroke 0.3s ease;
        }
        .fasting-timer-progress.fasting {
            stroke: #a855f7;
        }
        .fasting-timer-progress.eating {
            stroke: #22c55e;
        }
        .fasting-timer-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        .fasting-timer-status {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.9;
        }
        .fasting-timer-time {
            font-size: 2rem;
            font-weight: bold;
            line-height: 1.2;
        }
        .fasting-timer-label {
            font-size: 0.75rem;
            opacity: 0.7;
        }
        .fasting-status-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .fasting-status-badge.fasting {
            background: rgba(168, 85, 247, 0.2);
            color: #c084fc;
        }
        .fasting-status-badge.eating {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
        }
        .fasting-window-info {
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
            padding: 12px;
        }
        .fasting-window-info .label {
            font-size: 0.75rem;
            opacity: 0.7;
        }
        .fasting-window-info .value {
            font-size: 1rem;
            font-weight: 600;
        }
        .fasting-stats {
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
            border-top: 1px solid rgba(255,255,255,0.1);
        }
        .fasting-stat {
            text-align: center;
        }
        .fasting-stat-value {
            font-size: 1.5rem;
            font-weight: bold;
        }
        .fasting-stat-label {
            font-size: 0.7rem;
            opacity: 0.7;
            text-transform: uppercase;
        }
        .fasting-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
        }
        .fasting-schedule-selector {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .fasting-schedule-btn {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .fasting-schedule-btn:hover {
            background: rgba(255,255,255,0.2);
        }
        .fasting-schedule-btn.active {
            background: #a855f7;
            border-color: #a855f7;
        }
        .fasting-action-btn {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .fasting-action-btn.start-fast {
            background: linear-gradient(135deg, #a855f7, #7c3aed);
            color: white;
        }
        .fasting-action-btn.start-fast:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);
        }
        .fasting-action-btn.break-fast {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
        }
        .fasting-action-btn.break-fast:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
        }
        .fasting-disabled-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            z-index: 10;
        }
        .fasting-disabled-overlay p,
        .fasting-disabled-overlay i {
            color: white !important;
        }
        .pulse-animation {
            animation: pulse 2s ease-in-out infinite;
        }
        
        /* Fasting card text colors - ensure white text */
        .fasting-card .fasting-toggle,
        .fasting-card .fasting-toggle span,
        .fasting-card small,
        .fasting-card .opacity-75,
        .fasting-card .label,
        .fasting-card .value,
        .fasting-card .fasting-stat-value,
        .fasting-card .fasting-stat-label,
        .fasting-card .fasting-timer-status,
        .fasting-card .fasting-timer-time,
        .fasting-card .fasting-timer-label {
            color: white !important;
        }
        
        /* Dark mode - ensure fasting card maintains its unique style */
        [data-theme="dark"] .fasting-card {
            background: linear-gradient(135deg, #1e1e2e, #2d2d44) !important;
            border-color: rgba(168, 85, 247, 0.3) !important;
        }
        [data-theme="dark"] .fasting-card .card-header {
            background: transparent !important;
            color: white !important;
        }
        [data-theme="dark"] .fasting-card .card-body {
            background: transparent !important;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* Food Photo Recognition Styles */
        .photo-upload-area {
            transition: all 0.3s ease;
            background: var(--body-bg, #f9f9fb);
        }
        .photo-upload-area:hover,
        .photo-upload-area.drag-over {
            border-color: #E85D3B !important;
            background: rgba(63, 54, 155, 0.05);
        }
        .photo-upload-area.drag-over {
            transform: scale(1.02);
        }
        .health-score-badge {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2rem;
            color: white;
            background: linear-gradient(135deg, #10b981, #059669);
        }
        .health-score-badge.score-low {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }
        .health-score-badge.score-medium {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }
        .health-score-badge.score-high {
            background: linear-gradient(135deg, #10b981, #059669);
        }
        #photo-ingredients li,
        #photo-alternatives li {
            padding: 4px 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        #photo-ingredients li:last-child,
        #photo-alternatives li:last-child {
            border-bottom: none;
        }

        /* Biometric Card Styles */
        .biometric-card {
            background: linear-gradient(135deg, #0ea5e9, #0284c7) !important;
            border-radius: 16px !important;
            color: white !important;
            border: none !important;
        }
        .biometric-card:hover {
            background: linear-gradient(135deg, #0ea5e9, #0284c7) !important;
        }
        .biometric-card .card-header {
            background: transparent !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
            color: white !important;
        }
        .biometric-card .card-body {
            color: white !important;
        }
        .biometric-stat {
            text-align: center;
            padding: 10px;
        }
        .biometric-stat-icon {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px;
            font-size: 1.2rem;
        }
        .biometric-stat-value {
            font-size: 1.5rem;
            font-weight: bold;
        }
        .biometric-stat-label {
            font-size: 0.7rem;
            opacity: 0.8;
            text-transform: uppercase;
        }
        .biometric-sync-btn {
            background: rgba(255,255,255,0.2) !important;
            border: none !important;
            color: white !important;
        }
        .biometric-sync-btn:hover {
            background: rgba(255,255,255,0.3) !important;
        }

        .form-check-input:checked {
            background-color: #a855f7;
            border-color: #a855f7;
        }
        .toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
        }
        .achievement-toast {
            background: linear-gradient(135deg, #E85D3B 0%, #D14B2A 100%);
            color: white;
            border-radius: 15px;
            padding: 15px 20px;
            margin-bottom: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            animation: slideIn 0.5s ease, fadeOut 0.5s ease 4.5s forwards;
            display: flex;
            align-items: center;
            gap: 15px;
            max-width: 320px;
        }
        .achievement-toast .toast-icon {
            width: 50px;
            height: 50px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .achievement-toast .toast-content h6 {
            margin: 0;
            font-size: 12px;
            opacity: 0.8;
        }
        .achievement-toast .toast-content p {
            margin: 0;
            font-weight: 600;
        }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
    </style>
</head>
<body>
    <% const activePage = 'tracking'; %>
    <%- include('partials/navbar') %>

    <!-- Date Navigation -->
    <div class="date-nav">
        <div class="container">
            <div class="d-flex justify-content-center align-items-center gap-3">
                <button id="prevDay"><i class="bi bi-chevron-left"></i></button>
                <div class="text-center" style="min-width: 180px;">
                    <h5 class="mb-0" id="currentDate">Today</h5>
                    <small id="dateSubtext"></small>
                </div>
                <button id="nextDay"><i class="bi bi-chevron-right"></i></button>
                <button class="btn btn-sm btn-light ms-2" id="todayBtn">Today</button>
            </div>
        </div>
    </div>

    <div class="container pb-5">
        <div class="row">
            <!-- Left Column - Main Content -->
            <div class="col-lg-8">
                <!-- Energy Balance Card -->
                <div class="energy-balance mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center border-end">
                            <div class="energy-value" id="caloriesIn">0</div>
                            <div class="energy-label"><i class="bi bi-arrow-down-circle"></i> Eaten</div>
                        </div>
                        <div class="col-md-4 text-center border-end">
                            <div class="energy-value" id="caloriesBurned">0</div>
                            <div class="energy-label"><i class="bi bi-fire"></i> Burned</div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="energy-value" id="caloriesNet">0</div>
                            <div class="energy-label"><i class="bi bi-calculator"></i> Net</div>
                        </div>
                    </div>
                </div>

                <!-- Macros Overview -->
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-pie-chart-fill text-primary"></i> Nutrition Summary</span>
                        <span class="streak-badge streak-starting" id="streakBadge" style="display:none;">
                            <span class="streak-tooltip" id="streakTooltip">Keep going!</span>
                            <span class="streak-flame" id="streakFlame">🔥</span>
                            <span><span id="streakCount">0</span> day streak</span>
                            <span class="streak-milestone-icon" id="streakMilestoneIcon"></span>
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center mb-4">
                                <div class="circular-progress" id="caloriesRing">
                                    <svg width="140" height="140">
                                        <circle class="progress-ring progress-bg" cx="70" cy="70" r="58"></circle>
                                        <circle class="progress-ring progress-value" cx="70" cy="70" r="58" 
                                                stroke="var(--calories-color)" stroke-dasharray="364.4" stroke-dashoffset="364.4"></circle>
                                    </svg>
                                    <div class="progress-text">
                                        <span class="progress-number" id="caloriesValue">0</span>
                                        <span class="progress-label">of <span id="caloriesGoal">2000</span></span>
                                    </div>
                                </div>
                                <div class="mt-2 fw-bold">Calories</div>
                            </div>
                            <div class="col-md-8">
                                <canvas id="macroChart" height="140"></canvas>
                            </div>
                        </div>
                        
                        <hr>
                        
                        <!-- Macro Bars -->
                        <div class="macro-bar">
                            <div class="macro-label">
                                <span><i class="bi bi-circle-fill text-success"></i> Protein</span>
                                <span><span id="proteinValue">0</span>g / <span id="proteinGoal">50</span>g</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-success" id="proteinBar" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="macro-bar">
                            <div class="macro-label">
                                <span><i class="bi bi-circle-fill text-warning"></i> Carbs</span>
                                <span><span id="carbsValue">0</span>g / <span id="carbsGoal">250</span>g</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-warning" id="carbsBar" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="macro-bar">
                            <div class="macro-label">
                                <span><i class="bi bi-circle-fill text-primary"></i> Fat</span>
                                <span><span id="fatValue">0</span>g / <span id="fatGoal">65</span>g</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-primary" id="fatBar" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="macro-bar">
                            <div class="macro-label">
                                <span><i class="bi bi-circle-fill text-secondary"></i> Fiber</span>
                                <span><span id="fiberValue">0</span>g / <span id="fiberGoal">25</span>g</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-secondary" id="fiberBar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Food Diary -->
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-journal-text text-success"></i> Food Diary</span>
                        <div class="btn-group">
                            <button class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#foodPhotoModal">
                                <i class="bi bi-camera"></i> Photo
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#barcodeScannerModal">
                                <i class="bi bi-upc-scan"></i> Barcode
                            </button>
                            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addMealModal">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>
                    </div>
                    <div class="card-body" id="foodDiary">
                        <!-- Meals will be rendered here -->
                    </div>
                </div>

                <!-- Exercise Log -->
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-lightning-charge text-warning"></i> Exercise</span>
                        <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#addExerciseModal">
                            <i class="bi bi-plus-lg"></i> Add Exercise
                        </button>
                    </div>
                    <div class="card-body" id="exerciseList">
                        <p class="text-muted text-center mb-0">No exercises logged</p>
                    </div>
                </div>
            </div>

            <!-- Right Column - Sidebar -->
            <div class="col-lg-4">
                <!-- Intermittent Fasting Tracker -->
                <div class="card fasting-card" id="fastingTrackerCard" style="position: relative;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-clock-history"></i> Fasting Tracker</span>
                        <span class="fasting-status-badge fasting" id="fastingStatusBadge">Fasting</span>
                    </div>
                    <div class="card-body">
                        <!-- Fasting Toggle -->
                        <div class="fasting-toggle mb-3">
                            <span>Enable Fasting</span>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="fastingEnabledToggle" style="width: 3em; height: 1.5em;">
                            </div>
                        </div>

                        <!-- Schedule Selector -->
                        <div class="mb-3" id="fastingScheduleSection">
                            <small class="d-block mb-2 opacity-75">Fasting Schedule</small>
                            <div class="fasting-schedule-selector">
                                <button class="fasting-schedule-btn active" data-schedule="16:8">16:8</button>
                                <button class="fasting-schedule-btn" data-schedule="18:6">18:6</button>
                                <button class="fasting-schedule-btn" data-schedule="20:4">20:4</button>
                                <button class="fasting-schedule-btn" data-schedule="custom">Custom</button>
                            </div>
                        </div>

                        <!-- Custom Time Inputs (hidden by default) -->
                        <div class="row mb-3" id="customTimeInputs" style="display: none;">
                            <div class="col-6">
                                <label class="form-label small opacity-75">Eating Start</label>
                                <input type="time" class="form-control form-control-sm bg-dark text-white border-secondary" id="eatingWindowStart" value="12:00">
                            </div>
                            <div class="col-6">
                                <label class="form-label small opacity-75">Eating End</label>
                                <input type="time" class="form-control form-control-sm bg-dark text-white border-secondary" id="eatingWindowEnd" value="20:00">
                            </div>
                        </div>

                        <!-- Timer Display -->
                        <div class="fasting-timer-container my-4">
                            <svg class="fasting-timer-ring" width="180" height="180">
                                <circle class="fasting-timer-bg" cx="90" cy="90" r="80"></circle>
                                <circle class="fasting-timer-progress fasting" id="fastingTimerProgress" cx="90" cy="90" r="80" 
                                        stroke-dasharray="502.65" stroke-dashoffset="502.65"></circle>
                            </svg>
                            <div class="fasting-timer-center">
                                <div class="fasting-timer-status" id="fastingTimerStatus">Fasting</div>
                                <div class="fasting-timer-time pulse-animation" id="fastingTimerTime">--:--</div>
                                <div class="fasting-timer-label" id="fastingTimerLabel">remaining</div>
                            </div>
                        </div>

                        <!-- Window Info -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <div class="fasting-window-info text-center">
                                    <div class="label">Eating Window</div>
                                    <div class="value" id="eatingWindowDisplay">12:00 - 20:00</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="fasting-window-info text-center">
                                    <div class="label">Next Window</div>
                                    <div class="value" id="nextWindowDisplay">--:--</div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <button class="fasting-action-btn start-fast" id="fastingActionBtn">
                            <i class="bi bi-play-fill me-2"></i>Start Fast
                        </button>

                        <!-- Weekly Stats -->
                        <div class="fasting-stats mt-3">
                            <div class="fasting-stat">
                                <div class="fasting-stat-value" id="fastingStreakValue">0</div>
                                <div class="fasting-stat-label">Streak</div>
                            </div>
                            <div class="fasting-stat">
                                <div class="fasting-stat-value" id="fastingCompletedValue">0</div>
                                <div class="fasting-stat-label">Completed</div>
                            </div>
                            <div class="fasting-stat">
                                <div class="fasting-stat-value" id="fastingRateValue">0%</div>
                                <div class="fasting-stat-label">Success</div>
                            </div>
                        </div>
                    </div>

                    <!-- Disabled Overlay (shown when fasting is disabled) -->
                    <div class="fasting-disabled-overlay" id="fastingDisabledOverlay">
                        <div class="text-center p-3">
                            <i class="bi bi-clock-history fs-1 mb-2 d-block opacity-50"></i>
                            <p class="mb-2">Fasting tracking is disabled</p>
                            <button class="btn btn-sm btn-outline-light" id="enableFastingBtn">Enable Fasting</button>
                        </div>
                    </div>
                </div>

                <!-- Biometric Data Card -->
                <% if (user) { %>
                <div class="card biometric-card" id="biometricCard">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-activity"></i> Health Metrics</span>
                        <button class="btn btn-sm biometric-sync-btn" id="syncBiometricBtn" title="Sync with connected devices">
                            <i class="bi bi-arrow-repeat"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <div class="biometric-stat">
                                    <div class="biometric-stat-icon">
                                        <i class="bi bi-footprints"></i>
                                    </div>
                                    <div class="biometric-stat-value" id="biometric-steps">--</div>
                                    <div class="biometric-stat-label">Steps</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="biometric-stat">
                                    <div class="biometric-stat-icon">
                                        <i class="bi bi-heart-pulse"></i>
                                    </div>
                                    <div class="biometric-stat-value" id="biometric-heart">--</div>
                                    <div class="biometric-stat-label">BPM</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="biometric-stat">
                                    <div class="biometric-stat-icon">
                                        <i class="bi bi-fire"></i>
                                    </div>
                                    <div class="biometric-stat-value" id="biometric-burned">--</div>
                                    <div class="biometric-stat-label">Burned</div>
                                </div>
                            </div>
                        </div>

                        <!-- Connection Status -->
                        <div id="biometric-connection-status" class="text-center small opacity-75 mb-2">
                            <span id="biometric-status-text">Not connected</span>
                        </div>

                        <!-- Manual Entry / Connect Button -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm biometric-sync-btn flex-grow-1" data-bs-toggle="modal" data-bs-target="#biometricManualModal">
                                <i class="bi bi-pencil-square"></i> Manual Entry
                            </button>
                            <a href="/profile?tab=biometric" class="btn btn-sm biometric-sync-btn flex-grow-1">
                                <i class="bi bi-link-45deg"></i> Connect
                            </a>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Water Intake -->
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="bi bi-droplet-fill text-info"></i> Water Intake
                    </div>
                    <div class="card-body text-center">
                        <div class="d-flex flex-wrap justify-content-center mb-2" id="waterGlasses">
                            <!-- Water glasses will be rendered here -->
                        </div>
                        <div class="mt-2">
                            <span id="waterCount" class="fs-4 fw-bold text-info">0</span>
                            <span class="text-muted">/ 8 glasses</span>
                        </div>
                    </div>
                </div>

                <!-- Mood Tracker -->
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="bi bi-emoji-smile text-warning"></i> How do you feel?
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-around" id="moodSelector">
                            <button class="mood-btn" data-mood="great" title="Great">😄</button>
                            <button class="mood-btn" data-mood="good" title="Good">🙂</button>
                            <button class="mood-btn" data-mood="okay" title="Okay">😐</button>
                            <button class="mood-btn" data-mood="tired" title="Tired">😴</button>
                            <button class="mood-btn" data-mood="stressed" title="Stressed">😓</button>
                        </div>
                    </div>
                </div>

                <!-- Weight Tracker -->
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-speedometer2 text-danger"></i> Biometrics</span>
                        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#biometricsModal">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="fs-4 fw-bold" id="currentWeight">--</div>
                                <small class="text-muted">Weight (kg)</small>
                            </div>
                            <div class="col-6">
                                <div class="fs-4 fw-bold" id="currentBodyFat">--</div>
                                <small class="text-muted">Body Fat %</small>
                            </div>
                        </div>
                        <canvas id="weightChart" height="120" class="mt-3"></canvas>
                    </div>
                </div>

                <!-- Weekly Trend -->
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="bi bi-graph-up text-success"></i> 7-Day Calories
                    </div>
                    <div class="card-body">
                        <canvas id="weeklyChart" height="150"></canvas>
                    </div>
                </div>

                <!-- Favorite Meals -->
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-star-fill text-warning"></i> Favorite Meals</span>
                        <button class="btn btn-sm btn-outline-warning" id="refreshFavorites" title="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="card-body" id="favoritesList" style="max-height: 300px; overflow-y: auto;">
                        <% if (!user) { %>
                            <p class="text-muted text-center small mb-0">
                                <a href="/login">Log in</a> to save favorite meals
                            </p>
                        <% } else { %>
                            <p class="text-muted text-center small mb-0">Loading favorites...</p>
                        <% } %>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="bi bi-gear text-secondary"></i> Settings
                    </div>
                    <div class="card-body">
                        <button class="btn btn-outline-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#goalsModal">
                            <i class="bi bi-bullseye"></i> Set Daily Goals
                        </button>
                        <button class="btn btn-outline-info w-100 mb-2" data-bs-toggle="modal" data-bs-target="#goalWizardModal">
                            <i class="bi bi-calculator"></i> Goal Calculator
                        </button>
                        <a href="/plan" class="btn btn-outline-success w-100 mb-2">
                            <i class="bi bi-magic"></i> Generate Meal Plan
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary w-100 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-download"></i> Export Data
                            </button>
                            <ul class="dropdown-menu w-100">
                                <li><a class="dropdown-item" href="#" onclick="exportNutritionCSV(30); return false;"><i class="bi bi-filetype-csv me-2"></i>Export CSV (30 days)</a></li>
                                <li><a class="dropdown-item" href="#" onclick="exportNutritionCSV(90); return false;"><i class="bi bi-filetype-csv me-2"></i>Export CSV (90 days)</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Food Photo Recognition Modal -->
    <div class="modal fade" id="foodPhotoModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-camera text-info"></i> Analyze Food Photo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Upload Section -->
                    <div id="photo-upload-section">
                        <div class="photo-upload-area text-center p-4 border-2 border-dashed rounded-3" 
                             id="photoDropZone" style="border: 2px dashed #dee2e6; cursor: pointer;">
                            <i class="bi bi-cloud-arrow-up fs-1 text-muted mb-3 d-block"></i>
                            <p class="mb-2">Drag & drop a food photo here</p>
                            <p class="text-muted small">or click to select from your device</p>
                            <input type="file" id="foodPhotoInput" accept="image/*" class="d-none">
                            <button type="button" class="btn btn-outline-primary mt-2" id="btnSelectPhoto">
                                <i class="bi bi-image"></i> Select Photo
                            </button>
                            <button type="button" class="btn btn-outline-secondary mt-2 ms-2" id="btnTakePhoto">
                                <i class="bi bi-camera"></i> Take Photo
                            </button>
                        </div>
                        <div id="photo-preview-container" class="mt-3" style="display: none;">
                            <img id="photoPreview" class="img-fluid rounded" style="max-height: 300px; display: block; margin: 0 auto;">
                            <div class="text-center mt-2">
                                <button type="button" class="btn btn-sm btn-outline-danger" id="btnRemovePhoto">
                                    <i class="bi bi-trash"></i> Remove
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Analyzing Indicator -->
                    <div id="photo-analyzing" class="text-center py-5" style="display: none;">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Analyzing...</span>
                        </div>
                        <p class="text-muted">AI is analyzing your food photo...</p>
                        <p class="text-muted small">This may take a few seconds</p>
                    </div>

                    <!-- Analysis Results -->
                    <div id="photo-analysis-results" style="display: none;">
                        <div class="analysis-header d-flex align-items-center gap-3 mb-3">
                            <img id="analyzed-photo-thumb" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                            <div>
                                <h5 class="mb-1" id="analyzed-food-name">Food Name</h5>
                                <p class="text-muted small mb-1" id="analyzed-food-desc">Description</p>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-info" id="analyzed-serving">Serving</span>
                                    <span class="badge" id="analyzed-confidence">Confidence</span>
                                </div>
                            </div>
                        </div>

                        <div class="nutrition-summary bg-light rounded p-3 mb-3">
                            <div class="row text-center">
                                <div class="col">
                                    <div class="fs-4 fw-bold text-danger" id="photo-calories">0</div>
                                    <small class="text-muted">Calories</small>
                                </div>
                                <div class="col">
                                    <div class="fs-4 fw-bold text-success" id="photo-protein">0g</div>
                                    <small class="text-muted">Protein</small>
                                </div>
                                <div class="col">
                                    <div class="fs-4 fw-bold text-warning" id="photo-carbs">0g</div>
                                    <small class="text-muted">Carbs</small>
                                </div>
                                <div class="col">
                                    <div class="fs-4 fw-bold text-info" id="photo-fat">0g</div>
                                    <small class="text-muted">Fat</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-white py-2">
                                        <small class="fw-bold"><i class="bi bi-list-ul"></i> Detected Ingredients</small>
                                    </div>
                                    <div class="card-body py-2">
                                        <ul class="list-unstyled mb-0 small" id="photo-ingredients"></ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header bg-white py-2">
                                        <small class="fw-bold"><i class="bi bi-heart-pulse"></i> Health Score</small>
                                    </div>
                                    <div class="card-body py-2">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="health-score-badge" id="photo-health-score">0</div>
                                            <small class="text-muted">/10</small>
                                        </div>
                                        <p class="small text-muted mb-0" id="photo-health-notes"></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-3" id="photo-alternatives-card" style="display: none;">
                            <div class="card-header bg-white py-2">
                                <small class="fw-bold"><i class="bi bi-lightbulb"></i> Healthier Alternatives</small>
                            </div>
                            <div class="card-body py-2">
                                <ul class="list-unstyled mb-0 small" id="photo-alternatives"></ul>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <div id="photo-error" class="alert alert-danger" style="display: none;">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span id="photo-error-message">Error analyzing photo</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnAnalyzePhoto" style="display: none;">
                        <i class="bi bi-magic"></i> Analyze
                    </button>
                    <button type="button" class="btn btn-success" id="btnAddAnalyzedFood" style="display: none;">
                        <i class="bi bi-plus-lg"></i> Add to Diary
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Meal Modal -->
    <div class="modal fade" id="addMealModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Log Food</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="addMealForm">
                        <div class="mb-3">
                            <label class="form-label">Meal Type</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="mealType" id="mealBreakfast" value="breakfast" checked>
                                <label class="btn btn-outline-warning" for="mealBreakfast">Breakfast</label>
                                <input type="radio" class="btn-check" name="mealType" id="mealLunch" value="lunch">
                                <label class="btn btn-outline-success" for="mealLunch">Lunch</label>
                                <input type="radio" class="btn-check" name="mealType" id="mealDinner" value="dinner">
                                <label class="btn btn-outline-primary" for="mealDinner">Dinner</label>
                                <input type="radio" class="btn-check" name="mealType" id="mealSnack" value="snack">
                                <label class="btn btn-outline-secondary" for="mealSnack">Snack</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Food Name</label>
                            <input type="text" class="form-control" id="mealName" placeholder="e.g., Grilled Chicken Salad" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Serving Size</label>
                            <input type="text" class="form-control" id="servingSize" placeholder="e.g., 1 cup, 100g" value="1 serving">
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Calories</label>
                                <input type="number" class="form-control" id="mealCalories" placeholder="0" min="0">
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Protein (g)</label>
                                <input type="number" class="form-control" id="mealProtein" placeholder="0" min="0">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 mb-3">
                                <label class="form-label">Carbs (g)</label>
                                <input type="number" class="form-control" id="mealCarbs" placeholder="0" min="0">
                            </div>
                            <div class="col-4 mb-3">
                                <label class="form-label">Fat (g)</label>
                                <input type="number" class="form-control" id="mealFat" placeholder="0" min="0">
                            </div>
                            <div class="col-4 mb-3">
                                <label class="form-label">Fiber (g)</label>
                                <input type="number" class="form-control" id="mealFiber" placeholder="0" min="0">
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <% if (user) { %>
                    <button type="button" class="btn btn-outline-warning" id="btnAddToFavorites" title="Save to favorites for quick logging later">
                        <i class="bi bi-star"></i> Add to Favorites
                    </button>
                    <% } %>
                    <button type="button" class="btn btn-primary" id="btnAddMeal">
                        <i class="bi bi-plus-lg"></i> Add Food
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Biometric Manual Entry Modal -->
    <div class="modal fade" id="biometricManualModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-activity"></i> Log Health Metrics</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="biometricManualForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="manualSteps" class="form-label">Steps</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-footprints"></i></span>
                                    <input type="number" class="form-control" id="manualSteps" placeholder="e.g., 8000" min="0">
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="manualHeartRate" class="form-label">Heart Rate (BPM)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-heart-pulse"></i></span>
                                    <input type="number" class="form-control" id="manualHeartRate" placeholder="e.g., 72" min="30" max="220">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="manualWeight" class="form-label">Weight (kg)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
                                    <input type="number" class="form-control" id="manualWeight" placeholder="e.g., 70.5" min="20" max="300" step="0.1">
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="manualSleep" class="form-label">Sleep (hours)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-moon-stars"></i></span>
                                    <input type="number" class="form-control" id="manualSleep" placeholder="e.g., 7.5" min="0" max="24" step="0.5">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="manualCaloriesBurned" class="form-label">Calories Burned</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-fire"></i></span>
                                <input type="number" class="form-control" id="manualCaloriesBurned" placeholder="e.g., 2000" min="0">
                            </div>
                            <small class="text-muted">Total calories burned today (including BMR + activity)</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveBiometric">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Exercise Modal -->
    <div class="modal fade" id="addExerciseModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-lightning-charge"></i> Log Exercise</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Tabs for Library vs Custom -->
                    <ul class="nav nav-tabs mb-3" id="exerciseModalTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="library-tab" data-bs-toggle="tab" data-bs-target="#libraryPane" type="button" role="tab">
                                <i class="bi bi-collection"></i> Library
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="custom-tab" data-bs-toggle="tab" data-bs-target="#customPane" type="button" role="tab">
                                <i class="bi bi-pencil"></i> Custom
                            </button>
                        </li>
                    </ul>
                    
                    <div class="tab-content">
                        <!-- Library Tab -->
                        <div class="tab-pane fade show active" id="libraryPane" role="tabpanel">
                            <!-- Search -->
                            <div class="mb-3">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" id="exerciseSearch" placeholder="Search exercises...">
                                </div>
                            </div>
                            
                            <!-- Search Results (hidden by default) -->
                            <div id="exerciseSearchResults" class="mb-3" style="display: none;">
                                <h6 class="text-muted mb-2">Search Results</h6>
                                <div id="searchResultsList"></div>
                            </div>
                            
                            <!-- Exercise Categories Accordion -->
                            <div class="accordion" id="exerciseCategoriesAccordion">
                                <!-- Categories will be populated by JS -->
                            </div>
                            
                            <!-- Selected Exercise Panel -->
                            <div id="selectedExercisePanel" class="mt-3 p-3 bg-light rounded" style="display: none;">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="mb-1" id="selectedExerciseName">Running</h6>
                                        <small class="text-muted" id="selectedExerciseCategory">Cardio</small>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" id="clearSelectedExercise">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                                
                                <!-- Weight Input -->
                                <div class="mb-3">
                                    <label class="form-label">Your Weight (kg)</label>
                                    <input type="number" class="form-control" id="libraryExerciseWeight" placeholder="70" step="0.1">
                                    <small class="text-muted">Used to calculate calories burned</small>
                                </div>
                                
                                <!-- Duration with Quick Buttons -->
                                <div class="mb-3">
                                    <label class="form-label">Duration</label>
                                    <div class="btn-group w-100 mb-2" role="group">
                                        <button type="button" class="btn btn-outline-primary duration-btn" data-duration="15">15 min</button>
                                        <button type="button" class="btn btn-outline-primary duration-btn" data-duration="30">30 min</button>
                                        <button type="button" class="btn btn-outline-primary duration-btn" data-duration="45">45 min</button>
                                        <button type="button" class="btn btn-outline-primary duration-btn" data-duration="60">60 min</button>
                                    </div>
                                    <input type="number" class="form-control" id="libraryExerciseDuration" placeholder="30" min="1">
                                </div>
                                
                                <!-- Calorie Calculation Display -->
                                <div class="alert alert-info mb-0" id="calorieCalculation">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-fire"></i> Estimated Calories:</span>
                                        <strong class="fs-4" id="calculatedCalories">0</strong>
                                    </div>
                                    <small class="text-muted" id="calorieCalculationDetail">for 30 minutes</small>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Custom Tab -->
                        <div class="tab-pane fade" id="customPane" role="tabpanel">
                            <div class="mb-3">
                                <label class="form-label">Exercise Name</label>
                                <input type="text" class="form-control" id="exerciseName" placeholder="e.g., Running, Weight Training">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" id="exerciseType">
                                    <option value="cardio">Cardio</option>
                                    <option value="strength">Strength</option>
                                    <option value="flexibility">Flexibility/Yoga</option>
                                    <option value="sports">Sports</option>
                                    <option value="daily">Daily Activities</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label">Duration (min)</label>
                                    <input type="number" class="form-control" id="exerciseDuration" placeholder="30" min="0">
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label">Calories Burned</label>
                                    <input type="number" class="form-control" id="exerciseCalories" placeholder="200" min="0">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" id="btnAddExercise">
                        <i class="bi bi-plus-lg"></i> Add Exercise
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Goals Modal -->
    <div class="modal fade" id="goalsModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-bullseye"></i> Daily Goals</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Calorie Goal</label>
                        <input type="number" class="form-control" id="goalCalories" value="2000">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Protein (g)</label>
                        <input type="number" class="form-control" id="goalProtein" value="50">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Carbs (g)</label>
                        <input type="number" class="form-control" id="goalCarbs" value="250">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fat (g)</label>
                        <input type="number" class="form-control" id="goalFat" value="65">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fiber (g)</label>
                        <input type="number" class="form-control" id="goalFiber" value="25">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveGoals">Save Goals</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Goal Calculator Modal -->
    <div class="modal fade" id="goalWizardModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calculator"></i> Calculate Your Goals</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Weight (kg)</label>
                            <input type="number" class="form-control" id="wizardWeight" placeholder="70">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Height (cm)</label>
                            <input type="number" class="form-control" id="wizardHeight" placeholder="170">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Age</label>
                            <input type="number" class="form-control" id="wizardAge" placeholder="30">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Gender</label>
                            <select class="form-select" id="wizardGender">
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Activity Level</label>
                        <select class="form-select" id="wizardActivity">
                            <option value="sedentary">Sedentary (little/no exercise)</option>
                            <option value="light">Light (1-3 days/week)</option>
                            <option value="moderate" selected>Moderate (3-5 days/week)</option>
                            <option value="active">Active (6-7 days/week)</option>
                            <option value="veryActive">Very Active (hard exercise daily)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Goal</label>
                        <select class="form-select" id="wizardGoal">
                            <option value="lose">Lose Weight</option>
                            <option value="maintain" selected>Maintain Weight</option>
                            <option value="gain">Gain Muscle</option>
                        </select>
                    </div>
                    <div id="calculatedGoals" class="alert alert-info" style="display:none;">
                        <!-- Results will appear here -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" id="btnCalculateGoals">
                        <i class="bi bi-calculator"></i> Calculate
                    </button>
                    <button type="button" class="btn btn-primary" id="btnApplyGoals" style="display:none;">
                        Apply Goals
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Biometrics Modal -->
    <div class="modal fade" id="biometricsModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-speedometer2"></i> Log Biometrics</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Weight (kg)</label>
                            <input type="number" class="form-control" id="bioWeight" step="0.1">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Body Fat %</label>
                            <input type="number" class="form-control" id="bioBodyFat" step="0.1">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Waist (cm)</label>
                        <input type="number" class="form-control" id="bioWaist" step="0.1">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveBiometrics">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Barcode Scanner Modal -->
    <div class="modal fade" id="barcodeScannerModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-upc-scan"></i> Scan Food Barcode</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Scanner View -->
                    <div id="scanner-view">
                        <div class="text-center mb-3">
                            <p class="text-muted mb-2">Position the barcode within the frame</p>
                        </div>
                        <div id="barcode-scanner-container">
                            <div class="scanner-overlay">
                                <div class="scanner-line"></div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="input-group">
                                <input type="text" class="form-control" id="manualBarcodeInput" 
                                       placeholder="Or enter barcode manually (8-14 digits)" 
                                       pattern="\d{8,14}" maxlength="14">
                                <button class="btn btn-outline-primary" type="button" id="btnManualLookup">
                                    <i class="bi bi-search"></i> Look Up
                                </button>
                            </div>
                        </div>
                        <div id="scanner-status" class="text-center mt-3">
                            <span class="text-muted"><i class="bi bi-camera-video"></i> Initializing camera...</span>
                        </div>
                    </div>

                    <!-- Product Preview (hidden initially) -->
                    <div id="product-preview" style="display: none;">
                        <div class="scanned-product-preview">
                            <div class="d-flex gap-3">
                                <div id="product-image-container">
                                    <img id="scanned-product-image" src="" alt="Product" style="display:none;">
                                    <div id="no-product-image" class="bg-light d-flex align-items-center justify-content-center" 
                                         style="width:80px;height:80px;border-radius:8px;">
                                        <i class="bi bi-box-seam text-muted fs-2"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 id="scanned-product-name" class="mb-1">Product Name</h5>
                                    <p id="scanned-product-brand" class="text-muted small mb-2"></p>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <span id="scanned-nutriscore" class="nutriscore" style="display:none;"></span>
                                        <span class="badge bg-secondary" id="scanned-barcode-badge"></span>
                                    </div>
                                </div>
                            </div>
                            <hr>
                            <div class="row text-center">
                                <div class="col">
                                    <div class="fs-5 fw-bold text-danger" id="preview-calories">0</div>
                                    <small class="text-muted">Calories</small>
                                </div>
                                <div class="col">
                                    <div class="fs-5 fw-bold text-success" id="preview-protein">0g</div>
                                    <small class="text-muted">Protein</small>
                                </div>
                                <div class="col">
                                    <div class="fs-5 fw-bold text-warning" id="preview-carbs">0g</div>
                                    <small class="text-muted">Carbs</small>
                                </div>
                                <div class="col">
                                    <div class="fs-5 fw-bold text-primary" id="preview-fat">0g</div>
                                    <small class="text-muted">Fat</small>
                                </div>
                                <div class="col">
                                    <div class="fs-5 fw-bold text-secondary" id="preview-fiber">0g</div>
                                    <small class="text-muted">Fiber</small>
                                </div>
                            </div>
                            <p class="text-muted small text-center mt-2 mb-0" id="preview-serving-size"></p>
                        </div>
                        
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-outline-secondary flex-grow-1" id="btnScanAgain">
                                <i class="bi bi-arrow-repeat"></i> Scan Another
                            </button>
                            <button class="btn btn-primary flex-grow-1" id="btnAddScannedProduct">
                                <i class="bi bi-plus-lg"></i> Add to Food Diary
                            </button>
                        </div>
                    </div>

                    <!-- Error View (hidden initially) -->
                    <div id="scanner-error" style="display: none;">
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <span id="scanner-error-message">Product not found</span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-outline-secondary flex-grow-1" id="btnTryAgain">
                                <i class="bi bi-arrow-repeat"></i> Try Again
                            </button>
                            <button class="btn btn-primary flex-grow-1" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#addMealModal">
                                <i class="bi bi-pencil"></i> Enter Manually
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentDate = new Date();
        let currentLog = null;
        let macroChart = null;
        let weeklyChart = null;
        let weightChart = null;
        let calculatedGoalsData = null;

        function getDateString(date) {
            // Use local date, not UTC (toISOString uses UTC which can cause date mismatches)
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatDate(date) {
            const today = new Date();
            const yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);
            
            if (getDateString(date) === getDateString(today)) return 'Today';
            if (getDateString(date) === getDateString(yesterday)) return 'Yesterday';
            
            return date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function loadDayData() {
            const dateString = getDateString(currentDate);
            $('#currentDate').text(formatDate(currentDate));
            $('#dateSubtext').text(dateString);

            try {
                const response = await $.get(`/api/nutrition/log/${dateString}`);
                if (response.success) {
                    currentLog = response.log;
                    updateDisplay(response.log);
                    
                    // Show warning if database not connected
                    if (response.message && response.message.includes('Database not connected')) {
                        console.warn('Database not connected - data will not persist');
                        $('#dbWarning').remove();
                        $('main .container').prepend(`
                            <div id="dbWarning" class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>Database not connected.</strong> Your data won't be saved. Please check the server connection.
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        `);
                    } else {
                        $('#dbWarning').remove();
                    }
                }
            } catch (error) {
                console.error('Error loading data:', error);
                $('#dbWarning').remove();
                $('main .container').prepend(`
                    <div id="dbWarning" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle"></i>
                        <strong>Failed to load data.</strong> ${error.responseJSON?.error || 'Server error'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `);
            }
        }

        function updateDisplay(log) {
            const totals = log.dailyTotals || {};
            const goals = log.goals || { calories: 2000, protein: 50, carbs: 250, fat: 65, fiber: 25 };
            const burned = log.caloriesBurned || 0;

            // Energy Balance
            $('#caloriesIn').text(totals.calories || 0);
            $('#caloriesBurned').text(burned);
            $('#caloriesNet').text((totals.calories || 0) - burned);

            // Circular Progress
            updateCircularProgress(totals.calories || 0, goals.calories);
            $('#caloriesValue').text(totals.calories || 0);
            $('#caloriesGoal').text(goals.calories);

            // Macro Bars
            updateMacroBar('protein', totals.protein || 0, goals.protein);
            updateMacroBar('carbs', totals.carbs || 0, goals.carbs);
            updateMacroBar('fat', totals.fat || 0, goals.fat);
            updateMacroBar('fiber', totals.fiber || 0, goals.fiber);

            // Update goals in modal
            $('#goalCalories').val(goals.calories);
            $('#goalProtein').val(goals.protein);
            $('#goalCarbs').val(goals.carbs);
            $('#goalFat').val(goals.fat);
            $('#goalFiber').val(goals.fiber);

            // Update charts
            updateMacroChart(totals);
            
            // Render food diary
            renderFoodDiary(log.meals || []);
            
            // Render exercises
            renderExercises(log.exercises || []);
            
            // Water
            renderWaterGlasses(log.water || 0);
            
            // Mood
            updateMoodSelector(log.mood || '');
            
            // Biometrics
            $('#currentWeight').text(log.biometrics?.weight || '--');
            $('#currentBodyFat').text(log.biometrics?.bodyFat ? log.biometrics.bodyFat + '%' : '--');
            if (log.biometrics?.weight) {
                $('#bioWeight').val(log.biometrics.weight);
            }
            if (log.biometrics?.bodyFat) {
                $('#bioBodyFat').val(log.biometrics.bodyFat);
            }
        }

        function updateCircularProgress(value, goal) {
            const percentage = Math.min(100, (value / goal) * 100);
            const circumference = 2 * Math.PI * 58;
            const offset = circumference - (percentage / 100) * circumference;
            $('#caloriesRing .progress-value').css('stroke-dashoffset', offset);
        }

        function updateMacroBar(name, value, goal) {
            const percentage = Math.min(100, (value / goal) * 100);
            $(`#${name}Value`).text(value);
            $(`#${name}Goal`).text(goal);
            $(`#${name}Bar`).css('width', percentage + '%');
        }

        function updateMacroChart(totals) {
            const ctx = document.getElementById('macroChart').getContext('2d');
            
            if (macroChart) macroChart.destroy();
            
            const protein = totals.protein || 0;
            const carbs = totals.carbs || 0;
            const fat = totals.fat || 0;
            
            if (protein + carbs + fat === 0) {
                macroChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['No data'],
                        datasets: [{
                            data: [1],
                            backgroundColor: ['#e5e7eb']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'right' } }
                    }
                });
                return;
            }
            
            macroChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [`Protein ${protein}g`, `Carbs ${carbs}g`, `Fat ${fat}g`],
                    datasets: [{
                        data: [protein * 4, carbs * 4, fat * 9],
                        backgroundColor: ['#22c55e', '#f59e0b', '#3b82f6'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '60%',
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        }

        function renderFoodDiary(meals) {
            const mealTypes = ['breakfast', 'lunch', 'dinner', 'snack'];
            const mealLabels = { breakfast: 'Breakfast', lunch: 'Lunch', dinner: 'Dinner', snack: 'Snacks' };
            const mealIcons = { breakfast: 'bi-sunrise', lunch: 'bi-sun', dinner: 'bi-moon-stars', snack: 'bi-apple' };
            
            let html = '';
            
            mealTypes.forEach(type => {
                const typeMeals = meals.filter(m => m.mealType === type);
                const typeCalories = typeMeals.reduce((sum, m) => sum + (m.calories || 0), 0);
                
                html += `
                    <div class="meal-section ${type}">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0"><i class="bi ${mealIcons[type]} me-2"></i>${mealLabels[type]}</h6>
                            <span class="badge bg-secondary">${typeCalories} cal</span>
                        </div>
                `;
                
                if (typeMeals.length === 0) {
                    html += `<p class="text-muted small mb-0">No ${type} logged</p>`;
                } else {
                    typeMeals.forEach(meal => {
                        html += `
                            <div class="food-item">
                                <div>
                                    <strong>${escapeHtml(meal.name)}</strong>
                                    <br><small class="text-muted">${escapeHtml(meal.servingSize || '1 serving')} • ${meal.calories} cal</small>
                                </div>
                                <button class="btn btn-sm btn-outline-danger btn-remove-meal" data-meal-id="${meal._id}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        `;
                    });
                }
                
                html += '</div>';
            });
            
            $('#foodDiary').html(html);
        }

        function renderExercises(exercises) {
            if (!exercises || exercises.length === 0) {
                $('#exerciseList').html('<p class="text-muted text-center mb-0">No exercises logged</p>');
                return;
            }
            
            const html = exercises.map(ex => `
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <strong>${escapeHtml(ex.name)}</strong>
                        <br><small class="text-muted">${ex.duration} min • ${ex.caloriesBurned} cal burned</small>
                    </div>
                    <button class="btn btn-sm btn-outline-danger btn-remove-exercise" data-exercise-id="${ex._id}">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `).join('');
            
            $('#exerciseList').html(html);
        }

        function renderWaterGlasses(count) {
            let html = '';
            for (let i = 1; i <= 8; i++) {
                html += `<div class="water-glass ${i <= count ? 'filled' : ''}" data-water-count="${i}" title="${i} glasses"></div>`;
            }
            $('#waterGlasses').html(html);
            $('#waterCount').text(count);
        }

        function updateMoodSelector(mood) {
            $('.mood-btn').removeClass('active');
            if (mood) {
                $(`.mood-btn[data-mood="${mood}"]`).addClass('active');
            }
        }

        async function setWater(glasses) {
            try {
                await $.ajax({
                    url: '/api/nutrition/water',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), glasses })
                });
                renderWaterGlasses(glasses);
            } catch (error) {
                console.error('Error updating water:', error);
            }
        }

        async function setMood(mood) {
            try {
                await $.ajax({
                    url: '/api/nutrition/mood',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), mood })
                });
                updateMoodSelector(mood);
            } catch (error) {
                console.error('Error updating mood:', error);
            }
        }

        async function addMeal() {
            const mealName = $('#mealName').val().trim();
            const data = {
                date: getDateString(currentDate),
                mealType: $('input[name="mealType"]:checked').val(),
                name: mealName,
                servingSize: $('#servingSize').val() || '1 serving',
                calories: parseInt($('#mealCalories').val()) || 0,
                protein: parseInt($('#mealProtein').val()) || 0,
                carbs: parseInt($('#mealCarbs').val()) || 0,
                fat: parseInt($('#mealFat').val()) || 0,
                fiber: parseInt($('#mealFiber').val()) || 0
            };

            if (!mealName) {
                alert('Please enter a food name');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/meal',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addMealModal'));
                    if (modal) modal.hide();
                    $('#addMealForm')[0].reset();
                    await loadDayData();
                    loadWeeklyChart();
                    
                    if (response.newAchievements && response.newAchievements.length > 0) {
                        response.newAchievements.forEach(a => showAchievementToast(a));
                    }
                } else {
                    alert('Failed to add food: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Meal add error:', error);
                alert('Failed to add food: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function removeMeal(mealId) {
            if (!confirm('Remove this food?')) return;
            
            try {
                await $.ajax({
                    url: `/api/nutrition/log/meal/${getDateString(currentDate)}/${mealId}`,
                    method: 'DELETE'
                });
                loadDayData();
                loadWeeklyChart();
            } catch (error) {
                alert('Failed to remove food');
            }
        }

        async function addExercise() {
            const exerciseName = $('#exerciseName').val().trim();
            const data = {
                date: getDateString(currentDate),
                name: exerciseName,
                type: $('#exerciseType').val(),
                duration: parseInt($('#exerciseDuration').val()) || 0,
                caloriesBurned: parseInt($('#exerciseCalories').val()) || 0
            };

            if (!exerciseName) {
                alert('Please enter an exercise name');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/exercise',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addExerciseModal'));
                    if (modal) modal.hide();
                    $('#exerciseName').val('');
                    $('#exerciseDuration').val('');
                    $('#exerciseCalories').val('');
                    await loadDayData();
                } else {
                    alert('Failed to add exercise: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Exercise add error:', error);
                alert('Failed to add exercise: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function removeExercise(exerciseId) {
            if (!confirm('Remove this exercise?')) return;
            
            try {
                await $.ajax({
                    url: `/api/nutrition/log/exercise/${getDateString(currentDate)}/${exerciseId}`,
                    method: 'DELETE'
                });
                loadDayData();
            } catch (error) {
                alert('Failed to remove exercise');
            }
        }

        async function saveGoals() {
            const goals = {
                calories: parseInt($('#goalCalories').val()) || 2000,
                protein: parseInt($('#goalProtein').val()) || 50,
                carbs: parseInt($('#goalCarbs').val()) || 250,
                fat: parseInt($('#goalFat').val()) || 65,
                fiber: parseInt($('#goalFiber').val()) || 25
            };

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/goals',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), goals })
                });
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('goalsModal'));
                    if (modal) modal.hide();
                    await loadDayData();
                } else {
                    alert('Failed to save goals: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Goals save error:', error);
                alert('Failed to save goals: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function saveBiometrics() {
            const data = {
                date: getDateString(currentDate),
                weight: parseFloat($('#bioWeight').val()) || undefined,
                bodyFat: parseFloat($('#bioBodyFat').val()) || undefined,
                waist: parseFloat($('#bioWaist').val()) || undefined
            };

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/biometrics',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('biometricsModal'));
                    if (modal) modal.hide();
                    await loadDayData();
                    loadWeightChart();
                } else {
                    alert('Failed to save biometrics: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Biometrics save error:', error);
                alert('Failed to save biometrics: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function calculateGoals() {
            const data = {
                weight: parseFloat($('#wizardWeight').val()),
                height: parseFloat($('#wizardHeight').val()),
                age: parseInt($('#wizardAge').val()) || 30,
                gender: $('#wizardGender').val(),
                activityLevel: $('#wizardActivity').val(),
                goal: $('#wizardGoal').val()
            };

            if (!data.weight || !data.height) {
                alert('Please enter weight and height');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/calculate-goals',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });

                if (response.success) {
                    calculatedGoalsData = response.goals;
                    $('#calculatedGoals').html(`
                        <h6>Your Calculated Goals:</h6>
                        <p class="mb-1"><strong>BMR:</strong> ${response.bmr} cal/day</p>
                        <p class="mb-1"><strong>TDEE:</strong> ${response.tdee} cal/day</p>
                        <hr>
                        <p class="mb-1"><strong>Calories:</strong> ${response.goals.calories}</p>
                        <p class="mb-1"><strong>Protein:</strong> ${response.goals.protein}g</p>
                        <p class="mb-1"><strong>Carbs:</strong> ${response.goals.carbs}g</p>
                        <p class="mb-1"><strong>Fat:</strong> ${response.goals.fat}g</p>
                        <p class="mb-0"><strong>Fiber:</strong> ${response.goals.fiber}g</p>
                    `).show();
                    $('#btnApplyGoals').show();
                }
            } catch (error) {
                alert('Failed to calculate goals');
            }
        }

        async function applyCalculatedGoals() {
            if (!calculatedGoalsData) return;
            
            try {
                const response = await $.ajax({
                    url: '/api/nutrition/goals',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ date: getDateString(currentDate), goals: calculatedGoalsData })
                });
                if (response.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('goalWizardModal'));
                    if (modal) modal.hide();
                    await loadDayData();
                    alert('Goals applied successfully!');
                } else {
                    alert('Failed to apply goals: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Apply goals error:', error);
                alert('Failed to apply goals: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        async function loadWeeklyChart() {
            try {
                const response = await $.get('/api/nutrition/history/7');
                if (!response.success) return;

                const labels = [];
                const data = [];
                
                for (let i = 6; i >= 0; i--) {
                    const date = new Date();
                    date.setDate(date.getDate() - i);
                    const dateStr = getDateString(date);
                    labels.push(date.toLocaleDateString('en-US', { weekday: 'short' }));
                    const log = response.history.find(h => h.dateString === dateStr);
                    data.push(log?.dailyTotals?.calories || 0);
                }

                if (weeklyChart) weeklyChart.destroy();
                
                const ctx = document.getElementById('weeklyChart').getContext('2d');
                weeklyChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Calories',
                            data,
                            backgroundColor: 'rgba(102, 126, 234, 0.7)',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            } catch (error) {
                console.error('Error loading weekly chart:', error);
            }
        }

        async function loadWeightChart() {
            try {
                const response = await $.get('/api/nutrition/biometrics/history/30');
                if (!response.success || response.history.length === 0) {
                    return;
                }

                const labels = response.history.map(h => h.date.slice(5));
                const data = response.history.map(h => h.weight);

                if (weightChart) weightChart.destroy();
                
                const ctx = document.getElementById('weightChart').getContext('2d');
                weightChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Weight',
                            data,
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            fill: true,
                            tension: 0.3
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: false } }
                    }
                });
            } catch (error) {
                console.error('Error loading weight chart:', error);
            }
        }

        const STREAK_MILESTONES = [
            { days: 3, icon: '🌱', name: 'Seedling', message: 'You\'re building a habit!' },
            { days: 7, icon: '🔥', name: 'On Fire', message: 'One week strong!' },
            { days: 14, icon: '⚡', name: 'Energized', message: 'Two weeks of dedication!' },
            { days: 30, icon: '⭐', name: 'Star', message: 'A full month! Amazing!' },
            { days: 60, icon: '🏆', name: 'Champion', message: 'Two months of consistency!' },
            { days: 90, icon: '💎', name: 'Diamond', message: 'Legendary 90-day streak!' },
            { days: 365, icon: '👑', name: 'Crown', message: 'A FULL YEAR! You\'re incredible!' }
        ];

        function getStreakTier(streak) {
            if (streak >= 90) return 'legendary';
            if (streak >= 60) return 'diamond';
            if (streak >= 30) return 'platinum';
            if (streak >= 14) return 'gold';
            if (streak >= 7) return 'silver';
            if (streak >= 3) return 'bronze';
            return 'starting';
        }

        function getCurrentMilestone(streak) {
            let current = null;
            for (const milestone of STREAK_MILESTONES) {
                if (streak >= milestone.days) {
                    current = milestone;
                }
            }
            return current;
        }

        function getNextMilestone(streak) {
            for (const milestone of STREAK_MILESTONES) {
                if (streak < milestone.days) {
                    return milestone;
                }
            }
            return null;
        }

        function showCelebration(milestone, streak) {
            const celebrationHtml = `
                <div class="celebration-toast" id="celebrationToast">
                    <div class="celebration-icon">${milestone.icon}</div>
                    <div class="celebration-title">${milestone.name} Achievement!</div>
                    <div class="celebration-message">${streak} day streak - ${milestone.message}</div>
                </div>
            `;
            
            $('body').append(celebrationHtml);
            
            const colors = ['#ff6b6b', '#ffd93d', '#6bcb77', '#4d96ff', '#9b59b6', '#e91e63'];
            for (let i = 0; i < 50; i++) {
                const confetti = $('<div class="confetti"></div>');
                confetti.css({
                    left: Math.random() * 100 + 'vw',
                    background: colors[Math.floor(Math.random() * colors.length)],
                    animationDelay: Math.random() * 0.5 + 's',
                    animationDuration: (Math.random() * 2 + 2) + 's'
                });
                $('body').append(confetti);
            }
            
            setTimeout(() => {
                $('#celebrationToast').addClass('hiding');
                setTimeout(() => {
                    $('#celebrationToast').remove();
                    $('.confetti').remove();
                }, 500);
            }, 3500);
        }

        function checkAndCelebrateMilestone(streak) {
            const lastCelebrated = parseInt(localStorage.getItem('lastCelebratedStreak') || '0');
            
            for (const milestone of STREAK_MILESTONES) {
                if (streak >= milestone.days && lastCelebrated < milestone.days) {
                    localStorage.setItem('lastCelebratedStreak', milestone.days.toString());
                    showCelebration(milestone, streak);
                    break;
                }
            }
            
            if (streak === 0) {
                localStorage.setItem('lastCelebratedStreak', '0');
            }
        }

        async function loadStreak() {
            try {
                const response = await $.get('/api/nutrition/streak');
                if (response.success && response.streak > 0) {
                    const streak = response.streak;
                    const tier = getStreakTier(streak);
                    const currentMilestone = getCurrentMilestone(streak);
                    const nextMilestone = getNextMilestone(streak);
                    
                    $('#streakCount').text(streak);
                    
                    $('#streakBadge')
                        .removeClass('streak-starting streak-bronze streak-silver streak-gold streak-platinum streak-diamond streak-legendary')
                        .addClass(`streak-${tier}`)
                        .show();
                    
                    if (currentMilestone) {
                        $('#streakMilestoneIcon').text(currentMilestone.icon).show();
                    } else {
                        $('#streakMilestoneIcon').hide();
                    }
                    
                    if (nextMilestone) {
                        const daysUntil = nextMilestone.days - streak;
                        $('#streakTooltip').html(`
                            ${currentMilestone ? currentMilestone.name + ' tier' : 'Getting started!'}<br>
                            <strong>${daysUntil} day${daysUntil !== 1 ? 's' : ''}</strong> until ${nextMilestone.icon} ${nextMilestone.name}
                        `);
                    } else {
                        $('#streakTooltip').html(`
                            ${currentMilestone.icon} ${currentMilestone.name} - Maximum tier!<br>
                            You're a legend! Keep it going!
                        `);
                    }
                    
                    checkAndCelebrateMilestone(streak);
                } else {
                    $('#streakBadge').hide();
                }
            } catch (error) {
                console.error('Error loading streak:', error);
            }
        }

