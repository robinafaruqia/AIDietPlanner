        // Barcode Scanner functionality
        let html5QrCode = null;
        let scannedProductData = null;
        let isScanning = false;

        function initBarcodeScanner() {
            if (html5QrCode) {
                return;
            }

            html5QrCode = new Html5Qrcode("barcode-scanner-container");
        }

        async function startScanning() {
            if (isScanning) return;

            $('#scanner-view').show();
            $('#product-preview').hide();
            $('#scanner-error').hide();
            $('#scanner-status').html('<span class="text-muted"><i class="bi bi-camera-video"></i> Initializing camera...</span>');

            initBarcodeScanner();

            const config = {
                fps: 10,
                qrbox: { width: 250, height: 100 },
                aspectRatio: 1.5,
                formatsToSupport: [
                    Html5QrcodeSupportedFormats.EAN_13,
                    Html5QrcodeSupportedFormats.EAN_8,
                    Html5QrcodeSupportedFormats.UPC_A,
                    Html5QrcodeSupportedFormats.UPC_E,
                    Html5QrcodeSupportedFormats.CODE_128,
                    Html5QrcodeSupportedFormats.CODE_39
                ]
            };

            try {
                await html5QrCode.start(
                    { facingMode: "environment" },
                    config,
                    onBarcodeDetected,
                    (errorMessage) => {
                        // Ignore scan errors (expected when no barcode in view)
                    }
                );
                isScanning = true;
                $('#scanner-status').html('<span class="text-success"><i class="bi bi-check-circle"></i> Camera active - point at a barcode</span>');
            } catch (err) {
                console.error('Camera error:', err);
                let errorMsg = 'Could not access camera.';
                if (err.toString().includes('NotAllowedError')) {
                    errorMsg = 'Camera permission denied. Please allow camera access and try again.';
                } else if (err.toString().includes('NotFoundError')) {
                    errorMsg = 'No camera found on this device.';
                } else if (err.toString().includes('NotReadableError')) {
                    errorMsg = 'Camera is in use by another application.';
                }
                $('#scanner-status').html(`<span class="text-danger"><i class="bi bi-x-circle"></i> ${errorMsg}</span>`);
            }
        }

        async function stopScanning() {
            if (html5QrCode && isScanning) {
                try {
                    await html5QrCode.stop();
                    isScanning = false;
                } catch (err) {
                    console.error('Error stopping scanner:', err);
                }
            }
        }

        async function onBarcodeDetected(decodedText, decodedResult) {
            await stopScanning();
            $('#scanner-status').html('<span class="text-info"><i class="bi bi-hourglass-split"></i> Looking up product...</span>');
            lookupBarcode(decodedText);
        }

        async function lookupBarcode(barcode) {
            const cleanBarcode = barcode.replace(/\D/g, '');
            
            if (cleanBarcode.length < 8 || cleanBarcode.length > 14) {
                showScannerError('Invalid barcode format. Please scan a UPC or EAN barcode (8-14 digits).');
                return;
            }

            try {
                const response = await $.get(`/api/nutrition/barcode/${cleanBarcode}`);
                
                if (response.success) {
                    scannedProductData = response;
                    showProductPreview(response);
                } else {
                    showScannerError(response.error || 'Product not found in database. Try entering the food manually.');
                }
            } catch (error) {
                console.error('Barcode lookup error:', error);
                showScannerError('Failed to look up product. Please check your internet connection and try again.');
            }
        }

