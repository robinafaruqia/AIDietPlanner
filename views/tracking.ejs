            $('#mealCalories').val(Math.round(nutrition.calories) || 0);
            $('#mealProtein').val(Math.round(nutrition.protein) || 0);
            $('#mealCarbs').val(Math.round(nutrition.carbs) || 0);
            $('#mealFat').val(Math.round(nutrition.fat) || 0);
            $('#mealFiber').val(Math.round(nutrition.fiber) || 0);

            // Set meal type based on time of day
            const mealType = getCurrentMealType();
            $(`input[name="mealType"][value="${mealType}"]`).prop('checked', true);

            mealModal.show();
        });

        // Food Photo Modal Events
        const foodPhotoModal = document.getElementById('foodPhotoModal');
        
        foodPhotoModal.addEventListener('hidden.bs.modal', () => {
            selectedFoodPhoto = null;
            analyzedFoodData = null;
            foodPhotoInput.value = '';
            $('#photoPreview').attr('src', '');
            $('#photo-preview-container').hide();
            $('#photo-upload-section').show();
            $('#photo-analyzing').hide();
            $('#photo-analysis-results').hide();
            $('#photo-error').hide();
            $('#btnAnalyzePhoto').hide();
            $('#btnAddAnalyzedFood').hide();
        });

        function getCurrentMealType() {
            const hour = new Date().getHours();
            if (hour < 10) return 'breakfast';
            if (hour < 14) return 'lunch';
            if (hour < 17) return 'snack';
            return 'dinner';
        }

        // Barcode Scanner Modal Events
        const barcodeScannerModal = document.getElementById('barcodeScannerModal');
        
        barcodeScannerModal.addEventListener('shown.bs.modal', () => {
            startScanning();
        });

        barcodeScannerModal.addEventListener('hidden.bs.modal', () => {
            stopScanning();
            $('#scanner-view').show();
            $('#product-preview').hide();
            $('#scanner-error').hide();
            $('#manualBarcodeInput').val('');
            scannedProductData = null;
        });

        $('#btnManualLookup').click(() => {
            const barcode = $('#manualBarcodeInput').val().trim();
            if (barcode) {
                stopScanning();
                $('#scanner-status').html('<span class="text-info"><i class="bi bi-hourglass-split"></i> Looking up product...</span>');
                lookupBarcode(barcode);
            }
        });

        $('#manualBarcodeInput').on('keypress', (e) => {
            if (e.which === 13) {
                e.preventDefault();
                $('#btnManualLookup').click();
            }
        });

        $('#btnScanAgain, #btnTryAgain').click(() => {
            $('#scanner-view').show();
            $('#product-preview').hide();
            $('#scanner-error').hide();
            scannedProductData = null;
            startScanning();
        });

        $('#btnAddScannedProduct').click(() => {
            addScannedProductToMealForm();
        });

        // Exercise Library functionality
        let exerciseLibrary = null;
        let selectedLibraryExercise = null;
        const userWeight = <%= user && user.currentWeight ? user.currentWeight : 70 %>;

        async function loadExerciseLibrary() {
            try {
                const response = await $.get('/api/exercise-library');
                if (response.success) {
                    exerciseLibrary = response.exercises;
                    renderExerciseCategories();
                }
            } catch (error) {
                console.error('Error loading exercise library:', error);
            }
        }

        function renderExerciseCategories() {
            if (!exerciseLibrary) return;

            let html = '';
            let index = 0;
            
            for (const [key, category] of Object.entries(exerciseLibrary)) {
                const isFirst = index === 0;
                html += `
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button ${isFirst ? '' : 'collapsed'}" type="button" 
                                    data-bs-toggle="collapse" data-bs-target="#collapse-${key}">
                                <i class="bi ${category.icon} me-2"></i> ${category.name}
                                <span class="badge bg-secondary ms-2">${category.exercises.length}</span>
                            </button>
                        </h2>
                        <div id="collapse-${key}" class="accordion-collapse collapse ${isFirst ? 'show' : ''}" 
                             data-bs-parent="#exerciseCategoriesAccordion">
                            <div class="accordion-body">
                                ${category.exercises.map(ex => renderExerciseCard(ex, key)).join('')}
                            </div>
                        </div>
                    </div>
                `;
                index++;
            }
            
            $('#exerciseCategoriesAccordion').html(html);
        }

        function renderExerciseCard(exercise, categoryKey) {
            const calPerMin70kg = Math.round(exercise.calPerMinPerKg * 70);
            return `
                <div class="exercise-card" data-exercise-id="${exercise.id}" data-category="${categoryKey}">
                    <div class="exercise-info">
                        <div class="exercise-name">${escapeHtml(exercise.name)}</div>
                        <div class="exercise-meta">~${calPerMin70kg} cal/min (70kg)</div>
                    </div>
                    <span class="cal-indicator">${exercise.calPerMinPerKg.toFixed(2)} cal/min/kg</span>
                </div>
            `;
        }

        function selectLibraryExercise(exerciseId, categoryKey) {
            const category = exerciseLibrary[categoryKey];
            if (!category) return;
            
            const exercise = category.exercises.find(e => e.id === exerciseId);
            if (!exercise) return;
            
            selectedLibraryExercise = {
                ...exercise,
                category: category.name,
                categoryKey
            };
            
            $('.exercise-card').removeClass('selected');
            $(`.exercise-card[data-exercise-id="${exerciseId}"]`).addClass('selected');
            
            $('#selectedExerciseName').text(exercise.name);
            $('#selectedExerciseCategory').text(category.name);
            $('#libraryExerciseWeight').val(userWeight);
            $('#libraryExerciseDuration').val(30);
            $('.duration-btn').removeClass('active');
            $('.duration-btn[data-duration="30"]').addClass('active');
            
            $('#selectedExercisePanel').slideDown(200);
            updateCalorieCalculation();
        }

        function clearSelectedExercise() {
            selectedLibraryExercise = null;
            $('.exercise-card').removeClass('selected');
            $('#selectedExercisePanel').slideUp(200);
        }

        function updateCalorieCalculation() {
            if (!selectedLibraryExercise) return;
            
            const duration = parseInt($('#libraryExerciseDuration').val()) || 30;
            const weight = parseFloat($('#libraryExerciseWeight').val()) || userWeight;
            
            const calories = Math.round(selectedLibraryExercise.calPerMinPerKg * duration * weight);
            
            $('#calculatedCalories').text(calories);
            $('#calorieCalculationDetail').text(`for ${duration} minutes at ${weight}kg`);
        }

        async function searchExercises(query) {
            if (!query || query.trim().length < 2) {
                $('#exerciseSearchResults').hide();
                $('#exerciseCategoriesAccordion').show();
                return;
            }
            
            try {
                const response = await $.get('/api/exercise-library/search', { q: query });
                if (response.success) {
                    if (response.results.length === 0) {
                        $('#searchResultsList').html('<p class="text-muted">No exercises found</p>');
                    } else {
                        const html = response.results.map(ex => renderExerciseCard(ex, ex.categoryKey)).join('');
                        $('#searchResultsList').html(html);
                    }
                    $('#exerciseSearchResults').show();
                    $('#exerciseCategoriesAccordion').hide();
                }
            } catch (error) {
                console.error('Error searching exercises:', error);
            }
        }

        async function addExerciseFromLibrary() {
            if (!selectedLibraryExercise) {
                alert('Please select an exercise from the library');
                return;
            }
            
            const duration = parseInt($('#libraryExerciseDuration').val()) || 30;
            const weight = parseFloat($('#libraryExerciseWeight').val()) || userWeight;
            const calories = Math.round(selectedLibraryExercise.calPerMinPerKg * duration * weight);
            
            const data = {
                date: getDateString(currentDate),
                name: selectedLibraryExercise.name,
                type: selectedLibraryExercise.categoryKey,
                duration: duration,
                caloriesBurned: calories
            };
            
            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/exercise',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                
                if (response.success) {
                    const exerciseName = selectedLibraryExercise.name;
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addExerciseModal'));
                    if (modal) modal.hide();
                    clearSelectedExercise();
                    await loadDayData();
                    showToast('success', 'Exercise Logged!', `${exerciseName} - ${calories} cal burned`);
                } else {
                    alert('Failed to add exercise: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Exercise add error:', error);
                alert('Failed to add exercise: ' + (error.responseJSON?.error || error.message || 'Server error'));
            }
        }

        // Exercise library event handlers
        $('#exerciseCategoriesAccordion, #searchResultsList').on('click', '.exercise-card', function() {
            const exerciseId = $(this).data('exercise-id');
            const categoryKey = $(this).data('category');
            selectLibraryExercise(exerciseId, categoryKey);
        });

        $('#clearSelectedExercise').click(() => clearSelectedExercise());

        $('.duration-btn').click(function() {
            const duration = $(this).data('duration');
            $('#libraryExerciseDuration').val(duration);
            $('.duration-btn').removeClass('active');
            $(this).addClass('active');
            updateCalorieCalculation();
        });

        $('#libraryExerciseDuration, #libraryExerciseWeight').on('input', function() {
            $('.duration-btn').removeClass('active');
            const currentDuration = parseInt($('#libraryExerciseDuration').val());
            $(`.duration-btn[data-duration="${currentDuration}"]`).addClass('active');
            updateCalorieCalculation();
        });

        let searchTimeout;
        $('#exerciseSearch').on('input', function() {
            clearTimeout(searchTimeout);
            const query = $(this).val();
            searchTimeout = setTimeout(() => searchExercises(query), 300);
        });

        // Override the addExercise button to check which tab is active
        $('#btnAddExercise').off('click').click(function() {
            const activeTab = $('#exerciseModalTabs .nav-link.active').attr('id');
            if (activeTab === 'library-tab' && selectedLibraryExercise) {
                addExerciseFromLibrary();
            } else {
                addExercise();
            }
        });

        // Reset modal when opened
        const addExerciseModal = document.getElementById('addExerciseModal');
        addExerciseModal.addEventListener('show.bs.modal', function() {
            if (!exerciseLibrary) {
                loadExerciseLibrary();
            }
            clearSelectedExercise();
            $('#exerciseSearch').val('');
            $('#exerciseSearchResults').hide();
            $('#exerciseCategoriesAccordion').show();
            $('#libraryExerciseWeight').val(userWeight);
        });

        // Initialize
        // Fasting Tracker
        let fastingStatus = null;
        let fastingUpdateInterval = null;
        const isUserLoggedIn = <%= user ? 'true' : 'false' %>;

        async function loadFastingStatus() {
            try {
                const response = await $.get('/api/fasting/status');
                if (response.success) {
                    fastingStatus = response;
                    updateFastingUI(response);
                }
            } catch (error) {
                console.error('Error loading fasting status:', error);
            }
        }

        function updateFastingUI(status) {
            const enabled = status.fastingEnabled;
            const inFasting = status.inFastingWindow;
            const activeFast = status.activeFast;

            $('#fastingDisabledOverlay').toggle(!enabled);
            $('#fastingEnabledToggle').prop('checked', enabled);

            if (status.fastingSchedule) {
                const scheduleType = status.fastingSchedule.type || '16:8';
                $('.fasting-schedule-btn').removeClass('active');
                $(`.fasting-schedule-btn[data-schedule="${scheduleType}"]`).addClass('active');
                
                if (scheduleType === 'custom') {
                    $('#customTimeInputs').show();
                    $('#eatingWindowStart').val(status.fastingSchedule.eatingWindowStart || '12:00');
                    $('#eatingWindowEnd').val(status.fastingSchedule.eatingWindowEnd || '20:00');
                } else {
                    $('#customTimeInputs').hide();
                }

                const start = status.eatingWindowStart || status.fastingSchedule.eatingWindowStart || '12:00';
                const end = status.eatingWindowEnd || status.fastingSchedule.eatingWindowEnd || '20:00';
                $('#eatingWindowDisplay').text(`${formatTime12h(start)} - ${formatTime12h(end)}`);
            }

            if (inFasting) {
                $('#fastingStatusBadge').removeClass('eating').addClass('fasting').text('Fasting');
                $('#fastingTimerStatus').text('Fasting');
                $('#fastingTimerProgress').removeClass('eating').addClass('fasting');
            } else {
                $('#fastingStatusBadge').removeClass('fasting').addClass('eating').text('Eating');
                $('#fastingTimerStatus').text('Eating Window');
                $('#fastingTimerProgress').removeClass('fasting').addClass('eating');
            }

            $('#fastingTimerTime').text(status.timeRemainingFormatted || '--:--');
            $('#fastingTimerLabel').text('remaining');

            const circumference = 2 * Math.PI * 80;
            const progress = status.progress || 0;
            const offset = circumference - (progress / 100) * circumference;
            $('#fastingTimerProgress').css('stroke-dashoffset', offset);

            if (inFasting) {
                $('#nextWindowDisplay').text(formatTime12h(status.eatingWindowStart || '12:00'));
            } else {
                $('#nextWindowDisplay').text(formatTime12h(status.eatingWindowEnd || '20:00'));
            }

            if (activeFast) {
                $('#fastingActionBtn')
                    .removeClass('start-fast').addClass('break-fast')
                    .html('<i class="bi bi-cup-hot-fill me-2"></i>Break Fast');
                $('#fastingTimerTime').text(activeFast.elapsedFormatted);
                $('#fastingTimerLabel').text('elapsed');
            } else {
                $('#fastingActionBtn')
                    .removeClass('break-fast').addClass('start-fast')
                    .html('<i class="bi bi-play-fill me-2"></i>Start Fast');
            }
        }

        function formatTime12h(time24) {
            if (!time24) return '--:--';
            const [hours, minutes] = time24.split(':');
            const h = parseInt(hours);
            const ampm = h >= 12 ? 'PM' : 'AM';
            const h12 = h % 12 || 12;
            return `${h12}:${minutes} ${ampm}`;
        }

        async function loadFastingHistory() {
            try {
                const response = await $.get('/api/fasting/history?days=7');
                if (response.success) {
                    $('#fastingStreakValue').text(response.stats.currentStreak);
                    $('#fastingCompletedValue').text(response.stats.completedFasts);
                    $('#fastingRateValue').text(response.stats.completionRate + '%');
                }
            } catch (error) {
                console.error('Error loading fasting history:', error);
            }
        }

        async function toggleFastingEnabled() {
            if (!isUserLoggedIn) {
                alert('Please log in to use fasting tracking');
                $('#fastingEnabledToggle').prop('checked', false);
                return;
            }

            const enabled = $('#fastingEnabledToggle').is(':checked');
            
            try {
                const response = await $.ajax({
                    url: '/api/fasting/settings',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ fastingEnabled: enabled })
                });
                
                if (response.success) {
                    $('#fastingDisabledOverlay').toggle(!enabled);
                    if (enabled) {
                        loadFastingStatus();
                        loadFastingHistory();
                    }
                }
            } catch (error) {
                console.error('Error toggling fasting:', error);
                $('#fastingEnabledToggle').prop('checked', !enabled);
                if (error.status === 401) {
                    alert('Please log in to use fasting tracking');
                }
            }
        }

        async function updateFastingSchedule(scheduleType) {
            if (!isUserLoggedIn) {
                alert('Please log in to change fasting settings');
                return;
            }

            $('.fasting-schedule-btn').removeClass('active');
            $(`.fasting-schedule-btn[data-schedule="${scheduleType}"]`).addClass('active');

            if (scheduleType === 'custom') {
                $('#customTimeInputs').show();
                return;
            } else {
                $('#customTimeInputs').hide();
            }

            try {
                await $.ajax({
                    url: '/api/fasting/settings',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ scheduleType })
                });
                loadFastingStatus();
            } catch (error) {
                console.error('Error updating fasting schedule:', error);
            }
        }

        async function updateCustomSchedule() {
            if (!isUserLoggedIn) return;

            const eatingWindowStart = $('#eatingWindowStart').val();
            const eatingWindowEnd = $('#eatingWindowEnd').val();

            try {
                await $.ajax({
                    url: '/api/fasting/settings',
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        scheduleType: 'custom',
                        eatingWindowStart,
                        eatingWindowEnd
                    })
                });
                loadFastingStatus();
            } catch (error) {
                console.error('Error updating custom schedule:', error);
            }
        }

        async function handleFastingAction() {
            if (!isUserLoggedIn) {
                alert('Please log in to track fasting');
                return;
            }

            const isBreakFast = $('#fastingActionBtn').hasClass('break-fast');
            const endpoint = isBreakFast ? '/api/fasting/end' : '/api/fasting/start';

            try {
                const response = await $.ajax({
                    url: endpoint,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({})
                });

                if (response.success) {
                    if (isBreakFast && response.completed) {
                        showToast('success', 'Fast Complete!', `Congratulations! You fasted for ${response.actualDurationFormatted}`);
                    } else if (isBreakFast) {
                        showToast('info', 'Fast Ended', `You fasted for ${response.actualDurationFormatted}`);
                    } else {
                        showToast('success', 'Fast Started', 'Your fasting timer has begun');
                    }
                    loadFastingStatus();
                    loadFastingHistory();
                }
            } catch (error) {
                console.error('Error with fasting action:', error);
                alert(error.responseJSON?.error || 'Failed to perform action');
            }
        }

        function startFastingTimer() {
            if (fastingUpdateInterval) {
                clearInterval(fastingUpdateInterval);
            }
            
            fastingUpdateInterval = setInterval(() => {
                loadFastingStatus();
            }, 60000);
        }

        $('#fastingEnabledToggle').change(toggleFastingEnabled);

        $('#enableFastingBtn').click(() => {
            $('#fastingEnabledToggle').prop('checked', true).trigger('change');
        });

        $('.fasting-schedule-btn').click(function() {
            const schedule = $(this).data('schedule');
            updateFastingSchedule(schedule);
        });

        $('#eatingWindowStart, #eatingWindowEnd').change(function() {
            updateCustomSchedule();
        });

        $('#fastingActionBtn').click(handleFastingAction);

        $(document).ready(() => {
            loadDayData();
            loadWeeklyChart();
            loadWeightChart();
            loadStreak();
            loadFavorites();
            loadExerciseLibrary();
            loadFastingStatus();
            loadFastingHistory();
            startFastingTimer();
            loadBiometricData();
        });

        // ===== BIOMETRIC DATA =====
        async function loadBiometricData() {
            if (!isUserLoggedIn) return;
            
            try {
                const response = await $.get('/api/biometric/data');
                if (response.success && response.data) {
                    updateBiometricUI(response.data);
                }
            } catch (error) {
                console.error('Error loading biometric data:', error);
            }
        }

        function updateBiometricUI(data) {
            const today = new Date().toISOString().split('T')[0];
            
            // Steps
            if (data.steps) {
                const steps = data.steps[today] || data.steps.get?.(today);
                if (steps) {
                    $('#biometric-steps').text(formatNumber(steps));
                }
            }
            
            // Heart Rate
            if (data.heartRate) {
                const hr = data.heartRate[today] || data.heartRate.get?.(today);
                if (hr && hr.avg) {
                    $('#biometric-heart').text(hr.avg);
                }
            }
            
            // Calories burned
            if (data.calories) {
                const cal = data.calories[today] || data.calories.get?.(today);
                if (cal) {
                    $('#biometric-burned').text(formatNumber(cal));
                }
            }
            
            // Update connection status
            if (data.lastSync) {
                const syncDate = new Date(data.lastSync);
                const now = new Date();
                const diffMinutes = Math.floor((now - syncDate) / 60000);
                
                let statusText = 'Synced ';
                if (diffMinutes < 1) {
                    statusText += 'just now';
                } else if (diffMinutes < 60) {
                    statusText += `${diffMinutes}m ago`;
                } else if (diffMinutes < 1440) {
                    statusText += `${Math.floor(diffMinutes / 60)}h ago`;
                } else {
                    statusText += `${Math.floor(diffMinutes / 1440)}d ago`;
                }
                $('#biometric-status-text').text(statusText);
            }
        }

        function formatNumber(num) {
            if (num >= 1000) {
                return (num / 1000).toFixed(1) + 'k';
            }
            return num;
        }

        // Sync biometric data
        $('#syncBiometricBtn').click(async () => {
            const btn = $('#syncBiometricBtn');
            const originalHtml = btn.html();
            btn.html('<i class="bi bi-arrow-repeat spin"></i>');
            btn.prop('disabled', true);
            
            try {
                const statusResponse = await $.get('/api/biometric/status');
                if (statusResponse.success && statusResponse.connections.googleFit.connected) {
                    const syncResponse = await $.post('/api/biometric/sync/google-fit');
                    if (syncResponse.success) {
                        updateBiometricUI(syncResponse.data);
                        showToast('success', 'Synced', 'Biometric data updated');
                    }
                } else {
                    showToast('info', 'Not Connected', 'Connect Google Fit in your profile settings');
                }
            } catch (error) {
                console.error('Sync error:', error);
                showToast('error', 'Sync Failed', 'Could not sync biometric data');
            } finally {
                btn.html(originalHtml);
                btn.prop('disabled', false);
            }
        });

        // Manual biometric entry
        $('#btnSaveBiometric').click(async () => {
            const data = {};
            
            const steps = $('#manualSteps').val();
            const heartRate = $('#manualHeartRate').val();
            const weight = $('#manualWeight').val();
            const sleepHours = $('#manualSleep').val();
            const caloriesBurned = $('#manualCaloriesBurned').val();
            
            if (steps) data.steps = parseInt(steps);
            if (heartRate) data.heartRate = parseInt(heartRate);
            if (weight) data.weight = parseFloat(weight);
            if (sleepHours) data.sleepHours = parseFloat(sleepHours);
            if (caloriesBurned) data.caloriesBurned = parseInt(caloriesBurned);
            
            if (Object.keys(data).length === 0) {
                showToast('warning', 'No Data', 'Please enter at least one metric');
                return;
            }
            
            try {
                const response = await $.ajax({
                    url: '/api/biometric/manual-entry',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
                
                if (response.success) {
                    showToast('success', 'Saved', 'Health metrics recorded');
                    bootstrap.Modal.getInstance(document.getElementById('biometricManualModal')).hide();
                    loadBiometricData();
                    
                    // Clear form
                    $('#biometricManualForm')[0].reset();
                }
            } catch (error) {
                console.error('Save error:', error);
                showToast('error', 'Error', 'Failed to save health metrics');
            }
        });
    </script>
</body>
</html>
