<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="AI-powered personalized meal plans tailored to your health conditions and weight goals">
    <meta name="theme-color" content="#E85D3B">
    <title>AI Diet Planner - Personalized Meal Plans</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background: #FDFCFA;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Hero Section - Warm & Inviting */
        .hero-section {
            padding: 80px 0 60px;
            background: linear-gradient(135deg, #E85D3B 0%, #D14B2A 100%);
            color: white;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -30%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 60%);
            animation: float 25s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(-5%, 5%) rotate(3deg); }
        }

        /* Hero Content Animation */
        .hero-content {
            position: relative;
            z-index: 1;
        }

        .hero-title {
            animation: heroFadeIn 0.6s ease-out;
        }

        .hero-subtitle {
            animation: heroFadeIn 0.6s ease-out 0.15s both;
        }

        .hero-buttons {
            animation: heroFadeIn 0.6s ease-out 0.3s both;
        }

        @keyframes heroFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Subtle Animation for Hero Icon */
        .hero-icon {
            display: inline-block;
            animation: gentlePulse 3s ease-in-out infinite;
        }

        @keyframes gentlePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Clean Feature Cards */
        .feature-card {
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border: 1px solid rgba(0,0,0,0.05);
            background: #ffffff;
            transition: all 0.2s ease;
            overflow: hidden;
        }

        .feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: #E85D3B;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-icon {
            font-size: 2.5rem;
            color: #E85D3B;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.1);
        }

        .feature-card h4 {
            font-weight: 700;
            margin-bottom: 12px;
        }

        .feature-card p {
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* Welcome Card Enhancement */
        .welcome-card {
            background: rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 24px 32px;
            margin-bottom: 40px;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.2);
            animation: welcomeFadeIn 0.6s ease-out;
        }

        @keyframes welcomeFadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .welcome-card h4 {
            font-weight: 700;
        }

        /* CTA Buttons - Clean & Simple */
        .btn-hero {
            padding: 14px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s ease;
        }

        .btn-hero-primary {
            background: white;
            color: #E85D3B;
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

        .btn-hero-primary:hover {
            background: #FDF6E3;
            color: #D14B2A;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.18);
        }

        .btn-hero-outline {
            border: 2px solid rgba(255,255,255,0.7);
            color: white;
            background: transparent;
        }

        .btn-hero-outline:hover {
            background: rgba(255,255,255,0.1);
            border-color: white;
            color: white;
            transform: translateY(-2px);
        }

        /* Benefits Section - Clean Cards */
        .benefits-card {
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border: 1px solid rgba(0,0,0,0.05);
        }

        .benefit-item {
            padding: 16px;
            transition: all 0.2s ease;
            border-radius: 10px;
        }

        .benefit-item:hover {
            background: rgba(232, 93, 59, 0.04);
            transform: translateY(-2px);
        }

        .benefit-icon {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 1.8rem;
            transition: transform 0.3s ease;
        }

        .benefit-item:hover .benefit-icon {
            transform: scale(1.1);
        }

        .benefit-icon.primary {
            background: rgba(232, 93, 59, 0.1);
            color: #E85D3B;
        }

        .benefit-icon.success {
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
        }

        .benefit-icon.warning {
            background: rgba(245, 166, 35, 0.1);
            color: #F5A623;
        }

        /* Stats Section for Logged-in Users */
        .quick-stats {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 30px;
            animation: heroFadeIn 0.8s ease-out 0.6s both;
        }

        .quick-stat-item {
            background: rgba(255,255,255,0.15);
            border-radius: 16px;
            padding: 16px 24px;
            backdrop-filter: blur(10px);
            text-align: center;
            min-width: 120px;
        }

        .quick-stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            display: block;
        }

        .quick-stat-label {
            font-size: 0.85rem;
            opacity: 0.8;
        }

        /* Footer Enhancement */
        footer {
            background: #1a1d21 !important;
            padding: 30px 0;
        }

        footer p {
            opacity: 0.7;
        }

        /* Features Grid Animation */
        .features-section {
            position: relative;
            z-index: 1;
        }

        .features-section .col-md-3:nth-child(1) .feature-card { animation-delay: 0.1s; }
        .features-section .col-md-3:nth-child(2) .feature-card { animation-delay: 0.2s; }
        .features-section .col-md-3:nth-child(3) .feature-card { animation-delay: 0.3s; }
        .features-section .col-md-3:nth-child(4) .feature-card { animation-delay: 0.4s; }

        /* Responsive */
        @media (max-width: 768px) {
            .hero-section {
                padding: 60px 0;
            }

            .hero-title {
                font-size: 2rem;
            }

            .btn-hero {
                padding: 14px 28px;
                font-size: 1rem;
            }

            .quick-stats {
                gap: 12px;
            }

            .quick-stat-item {
                padding: 12px 16px;
                min-width: 100px;
            }
        }
    </style>
</head>
<body>
    <% const activePage = 'home'; %>
    <%- include('partials/navbar') %>

    <div class="hero-section text-center">
        <div class="container hero-content">
            <% if (typeof user !== 'undefined' && user) { %>
            <div class="welcome-card mx-auto" style="max-width: 650px;">
                <h4 class="mb-2">
                    <i class="bi bi-hand-wave me-2"></i>Welcome back, <%= user.name %>!
                </h4>
                <% if (user.currentWeight && user.targetWeight) { %>
                <p class="mb-0 opacity-85">
                    Current: <strong><%= user.currentWeight %> kg</strong> | 
                    Target: <strong><%= user.targetWeight %> kg</strong>
                    <% const progress = user.startWeight - user.currentWeight; %>
                    <% if (progress > 0) { %>
                    | <span class="badge bg-success"><i class="bi bi-arrow-down"></i> <%= progress.toFixed(1) %> kg lost</span>
                    <% } %>
                </p>
                <% } %>
            </div>
            <% } %>
            
            <h1 class="display-4 fw-bold mb-4 hero-title">
                <span class="hero-icon"><i class="bi bi-heart-pulse"></i></span> AI Diet Planner
            </h1>
            <p class="lead mb-5 hero-subtitle" style="max-width: 600px; margin: 0 auto;">
                Smart, personalized meal plans powered by AI — tailored to your health conditions, weight goals, and dietary preferences
            </p>
            
            <% if (typeof user !== 'undefined' && user) { %>
            <div class="d-flex gap-3 justify-content-center flex-wrap hero-buttons">
                <a href="/plan" class="btn btn-hero btn-hero-primary">
                    <i class="bi bi-magic me-2"></i>Create New Plan
                </a>
                <a href="/tracking" class="btn btn-hero btn-hero-outline">
                    <i class="bi bi-clipboard-data me-2"></i>Track Nutrition
                </a>
            </div>
            <div class="quick-stats">
                <div class="quick-stat-item">
                    <span class="quick-stat-value"><i class="bi bi-fire text-warning"></i></span>
                    <span class="quick-stat-label">Streaks</span>
                </div>
                <div class="quick-stat-item">
                    <span class="quick-stat-value"><i class="bi bi-trophy text-warning"></i></span>
                    <span class="quick-stat-label">Achievements</span>
                </div>
                <div class="quick-stat-item">
                    <span class="quick-stat-value"><i class="bi bi-graph-up-arrow text-success"></i></span>
                    <span class="quick-stat-label">Progress</span>
                </div>
            </div>
            <% } else { %>
            <div class="d-flex gap-3 justify-content-center flex-wrap hero-buttons">
                <a href="/register" class="btn btn-hero btn-hero-primary">
                    <i class="bi bi-rocket-takeoff me-2"></i>Get Started Free
                </a>
                <a href="/plan" class="btn btn-hero btn-hero-outline">
                    <i class="bi bi-eye me-2"></i>Try Without Account
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <div class="container my-5 features-section">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-robot feature-icon"></i>
                    <h4>AI-Powered Plans</h4>
                    <p class="text-muted mb-0">Smart meal plans customized for your health conditions and goals</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-calendar-week feature-icon"></i>
                    <h4>Weekly Planning</h4>
                    <p class="text-muted mb-0">Complete 7-day plans with breakfast, lunch, dinner & snacks</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-clipboard-data feature-icon"></i>
                    <h4>Nutrition Tracking</h4>
                    <p class="text-muted mb-0">Log meals, track macros, and monitor your daily progress</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-graph-up feature-icon"></i>
                    <h4>Weight Tracking</h4>
                    <p class="text-muted mb-0">Visualize your journey with charts and analytics</p>
                    <% if (typeof user !== 'undefined' && user) { %>
                    <a href="/weight" class="btn btn-outline-primary btn-sm mt-3">Track Now</a>
                    <% } else { %>
                    <a href="/register" class="btn btn-outline-primary btn-sm mt-3">Sign Up</a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Additional Features Row -->
        <div class="row g-4 mt-2">
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-trophy feature-icon"></i>
                    <h4>Achievements</h4>
                    <p class="text-muted mb-0">Unlock badges and celebrate your milestones</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-clock-history feature-icon"></i>
                    <h4>Fasting Tracker</h4>
                    <p class="text-muted mb-0">Monitor intermittent fasting windows easily</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-upc-scan feature-icon"></i>
                    <h4>Barcode Scanner</h4>
                    <p class="text-muted mb-0">Quickly log packaged foods by scanning</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card feature-card h-100 text-center p-4 position-relative">
                    <i class="bi bi-moon-stars feature-icon"></i>
                    <h4>Dark Mode</h4>
                    <p class="text-muted mb-0">Easy on the eyes, day or night</p>
                </div>
            </div>
        </div>
        
        <% if (!(typeof user !== 'undefined' && user)) { %>
        <div class="row mt-5">
            <div class="col-lg-8 mx-auto">
                <div class="card benefits-card p-4 p-md-5 text-center">
                    <h3 class="fw-bold mb-4">Why Create a Free Account?</h3>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="benefit-item">
                                <div class="benefit-icon primary">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                </div>
                                <h5 class="fw-bold">Save Your Plans</h5>
                                <p class="text-muted mb-0 small">Keep all your meal plans stored safely in the cloud</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="benefit-item">
                                <div class="benefit-icon success">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <h5 class="fw-bold">Track Progress</h5>
                                <p class="text-muted mb-0 small">Monitor weight, nutrition, and see your transformation</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="benefit-item">
                                <div class="benefit-icon warning">
                                    <i class="bi bi-star-fill"></i>
                                </div>
                                <h5 class="fw-bold">Earn Rewards</h5>
                                <p class="text-muted mb-0 small">Unlock achievements and build healthy streaks</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 pt-2">
                        <a href="/register" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-person-plus me-2"></i>Create Free Account
                        </a>
                        <p class="text-muted small mt-3 mb-0">
                            <i class="bi bi-shield-check me-1"></i>No credit card required • Free forever
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <footer class="text-white text-center py-4 mt-5">
        <div class="container">
            <div class="mb-3">
                <a href="/plan" class="text-white text-decoration-none me-4 opacity-75">Create Plan</a>
                <a href="/tracking" class="text-white text-decoration-none me-4 opacity-75">Tracking</a>
                <a href="/login" class="text-white text-decoration-none opacity-75">Login</a>
            </div>
            <p class="mb-0 opacity-50">&copy; 2024 AI Diet Planner. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
