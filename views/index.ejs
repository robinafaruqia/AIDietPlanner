<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Diet Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .hero-section {
            padding: 80px 0;
            color: white;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: none;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .feature-icon {
            font-size: 3rem;
            color: #667eea;
            margin-bottom: 20px;
        }
        .welcome-card {
            background: rgba(255,255,255,0.1);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body>
    <% const activePage = 'home'; %>
    <%- include('partials/navbar') %>

    <div class="hero-section text-center">
        <div class="container">
            <% if (typeof user !== 'undefined' && user) { %>
            <div class="welcome-card mx-auto" style="max-width: 600px;">
                <h4 class="mb-2">Welcome back, <%= user.name %>!</h4>
                <% if (user.currentWeight && user.targetWeight) { %>
                <p class="mb-0 opacity-75">
                    Current: <%= user.currentWeight %> kg | Target: <%= user.targetWeight %> kg
                    <% const progress = user.startWeight - user.currentWeight; %>
                    <% if (progress > 0) { %>
                    | <span class="text-success">-<%= progress.toFixed(1) %> kg</span>
                    <% } %>
                </p>
                <% } %>
            </div>
            <% } %>
            
            <h1 class="display-4 fw-bold mb-4">
                <i class="bi bi-heart-pulse"></i> AI Diet Planner
            </h1>
            <p class="lead mb-5">Personalized meal plans tailored to your weight and health conditions</p>
            
            <% if (typeof user !== 'undefined' && user) { %>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/plan" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Create Plan
                </a>
                <a href="/weight" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-graph-up"></i> Track Weight
                </a>
            </div>
            <% } else { %>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/register" class="btn btn-primary btn-lg">
                    <i class="bi bi-person-plus"></i> Get Started Free
                </a>
                <a href="/plan" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-eye"></i> Try Without Account
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <div class="container my-5">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card h-100 text-center p-4">
                    <i class="bi bi-person-check feature-icon"></i>
                    <h4>Personalized Plans</h4>
                    <p class="text-muted">Custom meal plans based on your weight and health conditions</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 text-center p-4">
                    <i class="bi bi-calendar-week feature-icon"></i>
                    <h4>Weekly Planning</h4>
                    <p class="text-muted">Complete 7-day meal plans with breakfast, lunch, dinner, and snacks</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 text-center p-4">
                    <i class="bi bi-cart feature-icon"></i>
                    <h4>Grocery Lists</h4>
                    <p class="text-muted">AI-generated shopping lists organized by category</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 text-center p-4">
                    <i class="bi bi-graph-up feature-icon"></i>
                    <h4>Weight Tracking</h4>
                    <p class="text-muted">Track your progress with charts and see your weight history</p>
                    <% if (typeof user !== 'undefined' && user) { %>
                    <a href="/weight" class="btn btn-outline-primary btn-sm mt-2">Track Now</a>
                    <% } else { %>
                    <a href="/register" class="btn btn-outline-primary btn-sm mt-2">Sign Up</a>
                    <% } %>
                </div>
            </div>
        </div>
        
        <% if (!(typeof user !== 'undefined' && user)) { %>
        <div class="row mt-5">
            <div class="col-md-8 mx-auto">
                <div class="card p-4 text-center">
                    <h3 class="mb-3">Why Create an Account?</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <i class="bi bi-save text-primary" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">Save your meal plans</p>
                        </div>
                        <div class="col-md-4">
                            <i class="bi bi-graph-up-arrow text-success" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">Track weight progress</p>
                        </div>
                        <div class="col-md-4">
                            <i class="bi bi-clock-history text-warning" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">View your history</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="/register" class="btn btn-primary">Create Free Account</a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2024 AI Diet Planner. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
