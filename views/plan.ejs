                        groceryList: response.mealPlan.groceryList || [],
                        totalCalories: response.mealPlan.totalCalories,
                        healthConditions: response.mealPlan.healthConditions,
                        weight: response.mealPlan.weight,
                        height: response.mealPlan.height,
                        createdAt: response.mealPlan.createdAt
                    }, true); // true = from history/cache
                    
                    // Scroll to result
                    $('html, body').animate({
                        scrollTop: $('#mealPlanResult').offset().top - 20
                    }, 500);
                } else {
                    alert('Failed to load meal plan');
                }
