        // Use inputs from a history item
        $(document).on('click', '.btn-use-inputs', function() {
            const weight = $(this).data('weight');
            const height = $(this).data('height');
            const conditions = $(this).data('conditions');

            // Fill form
            $('#weight').val(weight);
            $('#height').val(height);
            
            // Set health conditions in Select2
            if (conditions) {
                const condArray = conditions.split(',').filter(c => c.trim());
                $('#healthConditions').val(condArray).trigger('change');
            } else {
                $('#healthConditions').val([]).trigger('change');
