        // Download grocery list as text file
        $('#downloadGroceryList').click(function() {
            let textContent = "GROCERY LIST\n";
            textContent += "Generated by AI Diet Planner on " + new Date().toLocaleDateString() + "\n";
            textContent += "=".repeat(50) + "\n\n";
            
            $('#groceryList h5').each(function() {
                const category = $(this).text();
                textContent += category.toUpperCase() + "\n";
                textContent += "-".repeat(30) + "\n";
                
                $(this).next('ul').find('li').each(function() {
                    const item = $(this).clone().children().remove().end().text().trim();
                    const qty = $(this).find('.badge').text().trim();
                    textContent += `  [ ] ${item} - ${qty}\n`;
                });
                textContent += "\n";
            });
            
            // Create and download file
            const blob = new Blob([textContent], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'grocery-list-' + new Date().toISOString().split('T')[0] + '.txt';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        });

