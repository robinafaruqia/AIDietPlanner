        async function loadHistory(reset = false) {
            if (reset) {
                historySkip = 0;
                $('#historyTableBody').empty();
            }

            try {
                $('#historyLoading').show();
                $('#historyList').hide();
                $('#historyEmpty').hide();

                const response = await $.get(`/api/meal-plan/history/list?limit=${historyLimit}&skip=${historySkip}`);
                
                $('#historyLoading').hide();

                if (!response.success) {
                    $('#historyEmpty').show();
                    return;
                }

                if (response.history.length === 0 && historySkip === 0) {
                    $('#historyEmpty').show();
                    return;
                }

                $('#historyList').show();

                response.history.forEach(plan => {
                    const date = new Date(plan.createdAt).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    const conditions = plan.healthConditions.length > 0 
                        ? plan.healthConditions.join(', ') 
                        : '<span class="text-muted">None</span>';

                    $('#historyTableBody').append(`
                        <tr>
                            <td><small>${date}</small></td>
                            <td>${plan.weight} kg</td>
                            <td>${plan.height} cm</td>
                            <td><small>${conditions}</small></td>
                            <td>${plan.totalCalories || '-'} kcal</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary btn-view-plan" data-plan-id="${plan.id}" title="View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-success btn-use-inputs" 
                                        data-weight="${plan.weight}" 
                                        data-height="${plan.height}" 
                                        data-conditions="${plan.healthConditions.join(',')}"
                                        title="Use these inputs">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-delete-plan" data-plan-id="${plan.id}" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `);
                });

                historySkip += response.history.length;
                
                $('#historyCount').text(`Showing ${historySkip} of ${response.pagination.total} meal plans`);
                
                if (response.pagination.hasMore) {
                    $('#loadMoreHistory').show();
                } else {
                    $('#loadMoreHistory').hide();
                }
            } catch (error) {
                console.error('Error loading history:', error);
                $('#historyLoading').hide();
                $('#historyEmpty').html(`
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">Failed to load history. Please try again.</p>
                `).show();
            }
        }

