        // Update a full day's UI
        function updateDayUI(day, dayPlan) {
            updateMealUI(day, 'breakfast', dayPlan.breakfast);
            updateMealUI(day, 'lunch', dayPlan.lunch);
            updateMealUI(day, 'dinner', dayPlan.dinner);
            
            // Update snacks
            const $snacksCard = $(`#meal-${day}-snacks`);
            const snacksHtml = dayPlan.snacks.map((snack, snackIdx) => `
                <div class="mb-2 snack-item" data-snack-idx="${snackIdx}">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong class="meal-name">${escapeHtml(snack?.name || '')}</strong>
                        <div class="meal-actions">
                            <button class="btn-swap-meal" data-day="${day}" data-meal-type="snack" data-snack-idx="${snackIdx}" data-meal-name="${escapeHtml(snack?.name || '')}" title="Swap snack">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-success btn-log-meal" data-meal-key="${day}_snack_${snackIdx}" data-meal-type="snack" title="Log this snack">
                                <i class="bi bi-plus-circle"></i>
                            </button>
                        </div>
                    </div>
                    <p class="mb-1 meal-ingredients"><small>${(snack?.ingredients || []).map(i => escapeHtml(i)).join(', ')}</small></p>
                    <small class="text-muted meal-macros">${snack?.calories || 0} kcal</small>
                </div>
            `).join('');
            
            $snacksCard.find('.snack-item').remove();
            $snacksCard.find('.meal-header').after(snacksHtml);
        }
        
        // Update a single meal's UI
        function updateMealUI(day, mealType, meal, snackIdx) {
            if (mealType === 'snack' && snackIdx !== undefined) {
                const $snackItem = $(`#meal-${day}-snacks .snack-item[data-snack-idx="${snackIdx}"]`);
                $snackItem.find('.meal-name').text(meal.name || '');
                $snackItem.find('.meal-ingredients small').text((meal.ingredients || []).join(', '));
                $snackItem.find('.meal-macros').text(`${meal.calories || 0} kcal`);
                return;
            }
            
            const $mealCard = $(`#meal-${day}-${mealType}`);
            $mealCard.find('.meal-name').text(meal.name || '');
            $mealCard.find('.meal-ingredients small').text((meal.ingredients || []).join(', '));
            $mealCard.find('.meal-macros').text(
                `${meal.calories || 0} kcal | P: ${meal.protein || 0}g | C: ${meal.carbs || 0}g | F: ${meal.fat || 0}g`
            );
        }
        
        // Helper to capitalize first letter
        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }
        
        // Toast notification helper
        function showToast(type, title, message) {
            const bgClass = type === 'success' ? 'bg-success' : (type === 'danger' ? 'bg-danger' : 'bg-info');
            const toast = $(`
                <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
                    <div class="toast show" role="alert">
                        <div class="toast-header ${bgClass} text-white">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                            <strong class="me-auto">${escapeHtml(title)}</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">${escapeHtml(message)}</div>
                    </div>
                </div>
            `);
            $('body').append(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        function showAchievementToast(achievement) {
            const toast = $(`
                <div class="achievement-toast">
                    <div class="toast-icon">
                        <i class="bi ${achievement.icon || 'bi-trophy'}"></i>
                    </div>
                    <div class="toast-content">
                        <h6>Achievement Unlocked!</h6>
                        <p>${escapeHtml(achievement.name)}</p>
                    </div>
                </div>
            `);
            
            if (!$('.toast-container').length) {
                $('body').append('<div class="toast-container"></div>');
            }
            
            $('.toast-container').append(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 5000);
        }
    </script>
</body>
</html>

