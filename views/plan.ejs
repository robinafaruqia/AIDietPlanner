            $('#mealPlanResult').hide();
            $('#errorAlert').remove();
            startLoadingAnimation();

            $.ajax({
                url: '/api/meal-plan/generate',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    weight: parseFloat(weight),
                    height: parseFloat(height),
                    healthConditions: allConditions,
                    includeGroceryList: includeGroceryList,
                    forceRegenerate: true,
                    dietPreference: $('#dietPrefToggle').is(':checked') ? 'vegetarian' : 'non-vegetarian'
                }),
                success: function(response) {
                    stopLoadingAnimation();
                    $('.loading').hide();
                    if (response.success) {
                        displayMealPlan(response.mealPlan, response.cached);
                        if (response.newAchievements && response.newAchievements.length > 0) {
                            response.newAchievements.forEach(a => showAchievementToast(a));
                        }
                    } else {
                        alert('Failed to generate meal plan');
