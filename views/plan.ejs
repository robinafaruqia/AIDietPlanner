<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Meal Plan - AI Diet Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-bottom: 50px;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: none;
            margin-bottom: 20px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .meal-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .day-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: 600;
        }
        .grocery-item {
            padding: 10px;
            border-bottom: 1px solid #e9ecef;
        }
        .grocery-item:last-child {
            border-bottom: none;
        }
        .loading {
            display: none;
        }
        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            background-color: #87CEEB;
            border: none;
            color: white;
            padding: 2px 8px;
            border-radius: 12px;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove {
            color: white;
            margin-right: 4px;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove:hover {
            color: #e0e0e0;
            background: transparent;
        }
        .select2-container--bootstrap-5 .select2-dropdown .select2-results__option--selected {
            background-color: #87CEEB;
            color: white;
        }
        .select2-container--bootstrap-5 .select2-dropdown .select2-results__option--highlighted {
            background-color: #5cb8d6;
            color: white;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-heart-pulse"></i> AI Diet Planner
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/plan">Create Plan</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/tracking">Tracking</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0"><i class="bi bi-clipboard-data"></i> Create Your Meal Plan</h3>
                    </div>
                    <div class="card-body">
                        <form id="mealPlanForm">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="weight" class="form-label">Weight (kg)</label>
                                    <input type="number" class="form-control" id="weight" name="weight" 
                                           placeholder="Enter your weight" required min="1" step="0.1">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="height" class="form-label">Height (cm)</label>
                                    <input type="number" class="form-control" id="height" name="height" 
                                           placeholder="Enter your height" required min="50" max="250" step="0.1">
                                    <small class="form-text text-muted">e.g., 170 for 170 cm (5'7")</small>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="healthConditions" class="form-label">Health Condition(s)</label>
                                    <select class="form-select" id="healthConditions" name="healthConditions" multiple>
                                        <% if (typeof healthConditions !== 'undefined' && healthConditions.length) { %>
                                            <% healthConditions.forEach(function(condition) { %>
                                                <option value="<%= condition.id %>"><%= condition.name %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label for="customCondition" class="form-label">Other Condition (optional)</label>
                                    <input type="text" class="form-control" id="customCondition" name="customCondition" 
                                           placeholder="e.g., Lactose intolerance, Nut allergy, Vegetarian">
                                    <small class="form-text text-muted">Add any condition not listed above</small>
                                </div>
                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="includeGroceryList" checked>
                                        <label class="form-check-label" for="includeGroceryList">
                                            <i class="bi bi-cart"></i> Include Grocery List
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-magic"></i> Generate Meal Plan
                            </button>
                        </form>

                        <div class="loading text-center mt-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">Generating your personalized meal plan...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="mealPlanResult" style="display: none;">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><i class="bi bi-check-circle"></i> Your Weekly Meal Plan</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Daily Calories:</strong> <span id="totalCalories"></span> kcal
                        <br>
                        <strong>Weight:</strong> <span id="weightDisplay"></span> kg | <strong>Height:</strong> <span id="heightDisplay"></span> cm
                        <br>
                        <strong>Health Conditions Considered:</strong> <span id="healthConditionsDisplay"></span>
                    </div>
                    <div id="weeklyPlan"></div>
                </div>
            </div>

            <div class="card" id="groceryListCard" style="display: none;">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0"><i class="bi bi-cart"></i> Grocery List</h3>
                </div>
                <div class="card-body">
                    <div id="groceryList"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize Select2 for health conditions
            $('#healthConditions').select2({
                theme: 'bootstrap-5',
                placeholder: 'Select health conditions...',
                allowClear: true,
                width: '100%',
                closeOnSelect: false
            });

            $('#mealPlanForm').on('submit', function(e) {
                e.preventDefault();
                
                const weight = $('#weight').val();
                const height = $('#height').val();
                const selectedConditions = $('#healthConditions').val() || [];
                const customCondition = $('#customCondition').val()?.trim();
                const includeGroceryList = $('#includeGroceryList').is(':checked');
                
                // Combine selected conditions with custom condition
                let allConditions = [...selectedConditions];
                if (customCondition) {
                    allConditions.push(customCondition);
                }
                
                if (!weight || weight <= 0) {
                    alert('Please enter a valid weight');
                    return;
                }
                
                if (!height || height <= 0) {
                    alert('Please enter a valid height');
                    return;
                }

                $('.loading').show();
                $('#mealPlanResult').hide();
                $('#errorAlert').remove();

                $.ajax({
                    url: '/api/meal-plan/generate',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        weight: parseFloat(weight),
                        height: parseFloat(height),
                        healthConditions: allConditions,
                        includeGroceryList: includeGroceryList
                    }),
                    success: function(response) {
                        $('.loading').hide();
                        if (response.success) {
                            displayMealPlan(response.mealPlan);
                        } else {
                            alert('Failed to generate meal plan');
                        }
                    },
                    error: function(xhr) {
                        $('.loading').hide();
                        const response = xhr.responseJSON || {};
                        const errorMsg = response.error || 'Failed to generate meal plan';
                        const errorDetails = response.details || '';
                        const errorCode = response.code || '';
                        const errorHelp = response.help || '';
                        
                        console.error('API Error:', response);
                        
                        // Show user-friendly error with help
                        showError(errorMsg, errorDetails, errorHelp, errorCode);
                    }
                });
            });

            function safeText(value) {
                if (value === null || value === undefined) return '';
                return escapeHtml(String(value));
            }

            function safeNumber(value) {
                const n = Number(value);
                return Number.isFinite(n) ? n : 0;
            }

            function safeJoin(arr) {
                if (!Array.isArray(arr)) return '';
                return arr.map(v => safeText(v)).filter(Boolean).join(', ');
            }

            function displayMealPlan(mealPlan) {
                $('#totalCalories').text(safeNumber(mealPlan.totalCalories));
                $('#weightDisplay').text(safeNumber(mealPlan.weight || $('#weight').val()));
                $('#heightDisplay').text(safeNumber(mealPlan.height || $('#height').val()));

                const hc = Array.isArray(mealPlan.healthConditions) ? mealPlan.healthConditions : [];
                $('#healthConditionsDisplay').text(
                    hc.length > 0
                        ? hc.map(v => String(v)).join(', ')
                        : 'None'
                );

                const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
                const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
                
                let weeklyPlanHtml = '';
                days.forEach((day, index) => {
                    const dayPlan = mealPlan.weeklyPlan[day];
                    if (dayPlan) {
                        const breakfast = dayPlan.breakfast || {};
                        const lunch = dayPlan.lunch || {};
                        const dinner = dayPlan.dinner || {};
                        const snacks = Array.isArray(dayPlan.snacks) ? dayPlan.snacks : [];

                        // Store meals for logging
                        window.mealData = window.mealData || {};
                        window.mealData[`${day}_breakfast`] = breakfast;
                        window.mealData[`${day}_lunch`] = lunch;
                        window.mealData[`${day}_dinner`] = dinner;
                        snacks.forEach((s, i) => window.mealData[`${day}_snack_${i}`] = s);

                        weeklyPlanHtml += `
                            <div class="card mb-3">
                                <div class="day-header">${dayNames[index]}</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-sunrise"></i> Breakfast
                                                    <button class="btn btn-sm btn-outline-success float-end" onclick="logMeal('${day}_breakfast', 'breakfast')" title="Log this meal">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                </h6>
                                                <strong>${safeText(breakfast.name)}</strong>
                                                <p class="mb-1"><small>${safeJoin(breakfast.ingredients)}</small></p>
                                                <small class="text-muted">${safeNumber(breakfast.calories)} kcal | P: ${safeNumber(breakfast.protein)}g | C: ${safeNumber(breakfast.carbs)}g | F: ${safeNumber(breakfast.fat)}g</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-sun"></i> Lunch
                                                    <button class="btn btn-sm btn-outline-success float-end" onclick="logMeal('${day}_lunch', 'lunch')" title="Log this meal">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                </h6>
                                                <strong>${safeText(lunch.name)}</strong>
                                                <p class="mb-1"><small>${safeJoin(lunch.ingredients)}</small></p>
                                                <small class="text-muted">${safeNumber(lunch.calories)} kcal | P: ${safeNumber(lunch.protein)}g | C: ${safeNumber(lunch.carbs)}g | F: ${safeNumber(lunch.fat)}g</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-moon"></i> Dinner
                                                    <button class="btn btn-sm btn-outline-success float-end" onclick="logMeal('${day}_dinner', 'dinner')" title="Log this meal">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                </h6>
                                                <strong>${safeText(dinner.name)}</strong>
                                                <p class="mb-1"><small>${safeJoin(dinner.ingredients)}</small></p>
                                                <small class="text-muted">${safeNumber(dinner.calories)} kcal | P: ${safeNumber(dinner.protein)}g | C: ${safeNumber(dinner.carbs)}g | F: ${safeNumber(dinner.fat)}g</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-apple"></i> Snacks</h6>
                                                ${snacks.map((snack, snackIdx) => `
                                                    <div class="mb-2">
                                                        <strong>${safeText(snack?.name)}</strong>
                                                        <button class="btn btn-sm btn-outline-success float-end" onclick="logMeal('${day}_snack_${snackIdx}', 'snack')" title="Log this snack">
                                                            <i class="bi bi-plus-circle"></i>
                                                        </button>
                                                        <p class="mb-1"><small>${safeJoin(snack?.ingredients)}</small></p>
                                                        <small class="text-muted">${safeNumber(snack?.calories)} kcal</small>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                });
                $('#weeklyPlan').html(weeklyPlanHtml);

                // Display grocery list only if it exists and has items
                if (mealPlan.groceryList && mealPlan.groceryList.length > 0) {
                    const groceryByCategory = {};
                    mealPlan.groceryList.forEach(item => {
                        if (!groceryByCategory[item.category]) {
                            groceryByCategory[item.category] = [];
                        }
                        groceryByCategory[item.category].push(item);
                    });

                    let groceryHtml = '';
                    Object.keys(groceryByCategory).forEach(category => {
                        groceryHtml += `
                            <h5 class="mt-3 mb-3">${safeText(category)}</h5>
                            <ul class="list-group">
                                ${groceryByCategory[category].map(item => `
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        ${safeText(item.item)}
                                        <span class="badge bg-primary rounded-pill">${safeText(item.quantity)}</span>
                                    </li>
                                `).join('')}
                            </ul>
                        `;
                    });
                    $('#groceryList').html(groceryHtml);
                    $('#groceryListCard').show();
                } else {
                    $('#groceryListCard').hide();
                }

                $('#mealPlanResult').show();
                $('html, body').animate({
                    scrollTop: $('#mealPlanResult').offset().top
                }, 500);
            }
            
            // Show error message with details and help
            function showError(title, details, help, code) {
                // Hide any existing error
                $('#errorAlert').remove();
                
                // Create error HTML
                const errorHtml = `
                    <div id="errorAlert" class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill"></i> ${escapeHtml(title)}
                        </h5>
                        ${details ? `<p class="mb-2">${escapeHtml(details)}</p>` : ''}
                        ${help ? `
                            <hr>
                            <p class="mb-0">
                                <strong><i class="bi bi-lightbulb"></i> How to fix:</strong><br>
                                ${escapeHtml(help)}
                            </p>
                        ` : ''}
                        ${code ? `<small class="text-muted d-block mt-2">Error code: ${escapeHtml(code)}</small>` : ''}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                
                // Insert after the form
                $('#mealPlanForm').after(errorHtml);
                
                // Scroll to error
                $('html, body').animate({
                    scrollTop: $('#errorAlert').offset().top - 100
                }, 300);
            }
            
            // Helper to escape HTML to prevent XSS
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        });

        // Log meal to nutrition tracker
        async function logMeal(mealKey, mealType) {
            const meal = window.mealData?.[mealKey];
            if (!meal || !meal.name) {
                alert('Meal data not found');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/from-plan',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        mealType: mealType,
                        meal: meal
                    })
                });

                if (response.success) {
                    // Show success toast
                    const toast = $(`
                        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
                            <div class="toast show" role="alert">
                                <div class="toast-header bg-success text-white">
                                    <i class="bi bi-check-circle me-2"></i>
                                    <strong class="me-auto">Meal Logged!</strong>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                                </div>
                                <div class="toast-body">
                                    ${escapeHtml(meal.name)} has been added to your nutrition log.
                                    <a href="/tracking" class="btn btn-sm btn-outline-primary mt-2">View Tracking</a>
                                </div>
                            </div>
                        </div>
                    `);
                    $('body').append(toast);
                    setTimeout(() => toast.remove(), 4000);
                }
            } catch (error) {
                const msg = error.responseJSON?.error || 'Failed to log meal';
                alert(msg);
            }
        }
    </script>
</body>
</html>

