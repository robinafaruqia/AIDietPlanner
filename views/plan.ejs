<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Meal Plan - AI Diet Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-bottom: 50px;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: none;
            margin-bottom: 20px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .meal-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .day-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: 600;
        }
        .grocery-item {
            padding: 10px;
            border-bottom: 1px solid #e9ecef;
        }
        .grocery-item:last-child {
            border-bottom: none;
        }
        .loading {
            display: none;
        }
        .fitness-loader {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
        }
        .fitness-icons {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }
        .fitness-icon {
            font-size: 2.5rem;
            animation: bounce 1s ease-in-out infinite;
            color: #667eea;
        }
        .fitness-icon:nth-child(1) { animation-delay: 0s; color: #ef4444; }
        .fitness-icon:nth-child(2) { animation-delay: 0.2s; color: #22c55e; }
        .fitness-icon:nth-child(3) { animation-delay: 0.4s; color: #f59e0b; }
        .fitness-icon:nth-child(4) { animation-delay: 0.6s; color: #667eea; }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .loading-hint {
            font-size: 1.1rem;
            color: #6c757d;
            text-align: center;
            min-height: 50px;
            transition: opacity 0.3s ease;
        }
        .loading-hint .hint-icon {
            font-size: 1.3rem;
            margin-right: 8px;
        }
        .loading-progress {
            width: 100%;
            max-width: 400px;
            margin-top: 20px;
        }
        .loading-progress .progress {
            height: 8px;
            border-radius: 4px;
            background-color: #e9ecef;
        }
        .loading-progress .progress-bar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            animation: progressPulse 2s ease-in-out infinite;
        }
        @keyframes progressPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
        }
        .diet-toggle-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .diet-toggle-wrapper .label-nonveg,
        .diet-toggle-wrapper .label-veg {
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.3s, opacity 0.3s;
        }
        .diet-toggle-wrapper .label-nonveg { color: #dc3545; }
        .diet-toggle-wrapper .label-veg { color: #198754; }
        .diet-toggle-wrapper .label-nonveg.active { opacity: 1; }
        .diet-toggle-wrapper .label-nonveg.inactive { opacity: 0.4; }
        .diet-toggle-wrapper .label-veg.active { opacity: 1; }
        .diet-toggle-wrapper .label-veg.inactive { opacity: 0.4; }
        .diet-switch {
            position: relative;
            width: 56px;
            height: 28px;
            flex-shrink: 0;
        }
        .diet-switch input { opacity: 0; width: 0; height: 0; }
        .diet-switch .slider {
            position: absolute;
            inset: 0;
            cursor: pointer;
            border-radius: 28px;
            background-color: #dc3545;
            transition: background-color 0.3s;
        }
        .diet-switch .slider::before {
            content: '';
            position: absolute;
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background-color: #fff;
            border-radius: 50%;
            transition: transform 0.3s;
        }
        .diet-switch input:checked + .slider {
            background-color: #198754;
        }
        .diet-switch input:checked + .slider::before {
            transform: translateX(28px);
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            background-color: #87CEEB;
            border: none;
            color: white;
            padding: 2px 8px;
            border-radius: 12px;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove {
            color: white;
            margin-right: 4px;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove:hover {
            color: #e0e0e0;
            background: transparent;
        }
        .select2-container--bootstrap-5 .select2-dropdown .select2-results__option--selected {
            background-color: #87CEEB;
            color: white;
        }
        .select2-container--bootstrap-5 .select2-dropdown .select2-results__option--highlighted {
            background-color: #5cb8d6;
            color: white;
        }
        .btn-regenerate-day {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.85);
            padding: 4px 8px;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .btn-regenerate-day:hover {
            color: white;
            transform: rotate(180deg);
        }
        .btn-regenerate-day:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        .btn-regenerate-day .spinner-border {
            width: 1rem;
            height: 1rem;
        }
        .btn-swap-meal {
            background: transparent;
            border: 1px solid #6c757d;
            color: #6c757d;
            padding: 2px 6px;
            font-size: 0.75rem;
            border-radius: 4px;
            transition: all 0.2s;
        }
        .btn-swap-meal:hover {
            background: #6c757d;
            color: white;
        }
        .btn-swap-meal:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .btn-swap-meal .spinner-border {
            width: 0.75rem;
            height: 0.75rem;
        }
        .meal-card.loading-meal {
            opacity: 0.6;
            pointer-events: none;
        }
        .day-card.loading-day .card-body {
            opacity: 0.6;
            pointer-events: none;
        }
        .day-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .meal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .meal-header h6 {
            margin-bottom: 0;
        }
        .meal-actions {
            display: flex;
            gap: 4px;
        }
        .toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
        }
        .achievement-toast {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            padding: 15px 20px;
            margin-bottom: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            animation: slideIn 0.5s ease, fadeOut 0.5s ease 4.5s forwards;
            display: flex;
            align-items: center;
            gap: 15px;
            max-width: 320px;
        }
        .achievement-toast .toast-icon {
            width: 50px;
            height: 50px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .achievement-toast .toast-content h6 {
            margin: 0;
            font-size: 12px;
            opacity: 0.8;
        }
        .achievement-toast .toast-content p {
            margin: 0;
            font-weight: 600;
        }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
    </style>
</head>
<body>
    <% const activePage = 'plan'; %>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0"><i class="bi bi-clipboard-data"></i> Create Your Meal Plan</h3>
                    </div>
                    <div class="card-body">
                        <form id="mealPlanForm">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="weight" class="form-label">Weight (kg)</label>
                                    <input type="number" class="form-control" id="weight" name="weight" 
                                           placeholder="Enter your weight" required min="1" step="0.1">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="height" class="form-label">Height (cm)</label>
                                    <input type="number" class="form-control" id="height" name="height" 
                                           placeholder="Enter your height" required min="50" max="250" step="0.1">
                                    <small class="form-text text-muted">e.g., 170 for 170 cm (5'7")</small>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="healthConditions" class="form-label">Health Condition(s)</label>
                                    <select class="form-select" id="healthConditions" name="healthConditions" multiple>
                                        <% if (typeof healthConditions !== 'undefined' && healthConditions.length) { %>
                                            <% healthConditions.forEach(function(condition) { %>
                                                <option value="<%= condition.id %>"><%= condition.name %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label for="customCondition" class="form-label">Other Condition (optional)</label>
                                    <input type="text" class="form-control" id="customCondition" name="customCondition" 
                                           placeholder="e.g., Lactose intolerance, Nut allergy, Vegetarian">
                                    <small class="form-text text-muted">Add any condition not listed above</small>
                                </div>
                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="includeGroceryList" checked>
                                        <label class="form-check-label" for="includeGroceryList">
                                            <i class="bi bi-cart"></i> Include Grocery List
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Diet Preference</label>
                                    <div class="diet-toggle-wrapper">
                                        <span class="label-nonveg active"><i class="bi bi-circle-fill" style="font-size:0.55rem;vertical-align:middle;margin-right:3px"></i>Non-Veg</span>
                                        <label class="diet-switch">
                                            <input type="checkbox" id="dietPrefToggle">
                                            <span class="slider"></span>
                                        </label>
                                        <span class="label-veg inactive"><i class="bi bi-circle-fill" style="font-size:0.55rem;vertical-align:middle;margin-right:3px"></i>Veg</span>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-magic"></i> Generate Meal Plan
                            </button>
                            <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#historyModal">
                                <i class="bi bi-clock-history"></i> View History
                            </button>
                        </form>

                        <div class="loading mt-4">
                            <div class="fitness-loader">
                                <div class="fitness-icons">
                                    <i class="bi bi-heart-pulse fitness-icon"></i>
                                    <i class="bi bi-droplet fitness-icon"></i>
                                    <i class="bi bi-egg-fried fitness-icon"></i>
                                    <i class="bi bi-bicycle fitness-icon"></i>
                                </div>
                                <h5 class="text-primary mb-3">
                                    <i class="bi bi-robot"></i> AI is crafting your meal plan...
                                </h5>
                                <div class="loading-hint" id="loadingHint">
                                    <span class="hint-icon">🏊</span> Swimming through nutritional data...
                                </div>
                                <div class="loading-progress">
                                    <div class="progress">
                                        <div class="progress-bar" id="loadingProgress" style="width: 10%"></div>
                                    </div>
                                    <small class="text-muted mt-2 d-block text-center" id="loadingStep">Step 1 of 5</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="mealPlanResult" style="display: none;">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><i class="bi bi-check-circle"></i> Your Weekly Meal Plan</h3>
                </div>
                <div class="card-body">
                    <div id="cacheStatus"></div>
                    <div class="alert alert-info">
                        <strong>Daily Calories:</strong> <span id="totalCalories"></span> kcal
                        <br>
                        <strong>Weight:</strong> <span id="weightDisplay"></span> kg | <strong>Height:</strong> <span id="heightDisplay"></span> cm
                        <br>
                        <strong>Health Conditions Considered:</strong> <span id="healthConditionsDisplay"></span>
                    </div>
                    <div id="weeklyPlan"></div>
                </div>
            </div>

            <div class="card" id="groceryListCard" style="display: none;">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0"><i class="bi bi-cart"></i> Grocery List</h3>
                    <div class="btn-group">
                        <button type="button" class="btn btn-light btn-sm" id="printGroceryList" title="Print">
                            <i class="bi bi-printer"></i> Print
                        </button>
                        <button type="button" class="btn btn-light btn-sm" id="downloadGroceryList" title="Download">
                            <i class="bi bi-download"></i> Download
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="groceryList"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- History Modal -->
    <div class="modal fade" id="historyModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="bi bi-clock-history"></i> Meal Plan History</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="historyLoading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Loading history...</p>
                    </div>
                    <div id="historyEmpty" class="text-center py-4" style="display: none;">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">No meal plans generated yet.<br>Generate your first meal plan to see it here!</p>
                    </div>
                    <div id="historyList" style="display: none;">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Weight</th>
                                        <th>Height</th>
                                        <th>Health Conditions</th>
                                        <th>Calories</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="historyTableBody"></tbody>
                            </table>
                        </div>
                        <div id="historyPagination" class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted" id="historyCount"></small>
                            <button class="btn btn-outline-primary btn-sm" id="loadMoreHistory" style="display: none;">
                                Load More
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        const isUserLoggedIn = <%= user ? 'true' : 'false' %>;

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        $(document).ready(function() {
            // Diet preference toggle label sync
            $('#dietPrefToggle').on('change', function() {
                const isVeg = $(this).is(':checked');
                $('.label-veg').toggleClass('active', isVeg).toggleClass('inactive', !isVeg);
                $('.label-nonveg').toggleClass('active', !isVeg).toggleClass('inactive', isVeg);
            });

            // Initialize Select2 for health conditions
            $('#healthConditions').select2({
                theme: 'bootstrap-5',
                placeholder: 'Select health conditions...',
                allowClear: true,
                width: '100%',
                closeOnSelect: false
            });

            $('#mealPlanForm').on('submit', function(e) {
                e.preventDefault();
                
                const weight = $('#weight').val();
                const height = $('#height').val();
                const selectedConditions = $('#healthConditions').val() || [];
                const customCondition = $('#customCondition').val()?.trim();
                const includeGroceryList = $('#includeGroceryList').is(':checked');
                
                // Combine selected conditions with custom condition
                let allConditions = [...selectedConditions];
                if (customCondition) {
                    allConditions.push(customCondition);
                }
                
                if (!weight || weight <= 0) {
                    alert('Please enter a valid weight');
                    return;
                }
                
                if (!height || height <= 0) {
                    alert('Please enter a valid height');
                    return;
                }

                $('.loading').show();
                $('#mealPlanResult').hide();
                $('#errorAlert').remove();
                
                // Start loading animation with hints
                startLoadingAnimation();

                $.ajax({
                    url: '/api/meal-plan/generate',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        weight: parseFloat(weight),
                        height: parseFloat(height),
                        healthConditions: allConditions,
                        includeGroceryList: includeGroceryList,
                        dietPreference: $('#dietPrefToggle').is(':checked') ? 'vegetarian' : 'non-vegetarian'
                    }),
                    success: function(response) {
                        stopLoadingAnimation();
                        $('.loading').hide();
                        if (response.success) {
                            displayMealPlan(response.mealPlan, response.cached);
                            if (response.newAchievements && response.newAchievements.length > 0) {
                                response.newAchievements.forEach(a => showAchievementToast(a));
                            }
                        } else {
                            alert('Failed to generate meal plan');
                        }
                    },
                    error: function(xhr) {
                        stopLoadingAnimation();
                        $('.loading').hide();
                        const response = xhr.responseJSON || {};
                        const errorMsg = response.error || 'Failed to generate meal plan';
                        const errorDetails = response.details || '';
                        const errorCode = response.code || '';
                        const errorHelp = response.help || '';
                        
                        console.error('API Error:', response);
                        
                        // Show user-friendly error with help
                        showError(errorMsg, errorDetails, errorHelp, errorCode);
                    }
                });
            });

            function safeText(value) {
                if (value === null || value === undefined) return '';
                return escapeHtml(String(value));
            }

            function safeNumber(value) {
                const n = Number(value);
                return Number.isFinite(n) ? n : 0;
            }

            function safeJoin(arr) {
                if (!Array.isArray(arr)) return '';
                return arr.map(v => safeText(v)).filter(Boolean).join(', ');
            }

            function displayMealPlan(mealPlan, isCached = false) {
                $('#totalCalories').text(safeNumber(mealPlan.totalCalories));
                $('#weightDisplay').text(safeNumber(mealPlan.weight || $('#weight').val()));
                $('#heightDisplay').text(safeNumber(mealPlan.height || $('#height').val()));

                const hc = Array.isArray(mealPlan.healthConditions) ? mealPlan.healthConditions : [];
                $('#healthConditionsDisplay').text(
                    hc.length > 0
                        ? hc.map(v => String(v)).join(', ')
                        : 'None'
                );
                
                // Show cached badge and regenerate button
                if (isCached) {
                    $('#cacheStatus').html(`
                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-3">
                            <span>
                                <i class="bi bi-lightning-charge"></i> 
                                <strong>Instant Result!</strong> This meal plan was loaded from your saved plans.
                                ${mealPlan.createdAt ? `<small class="text-muted ms-2">Created: ${new Date(mealPlan.createdAt).toLocaleDateString()}</small>` : ''}
                            </span>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="regenerateBtn">
                                <i class="bi bi-arrow-clockwise"></i> Generate New Plan
                            </button>
                        </div>
                    `);
                } else {
                    $('#cacheStatus').html(`
                        <div class="alert alert-success d-flex align-items-center mb-3">
                            <i class="bi bi-stars me-2"></i>
                            <span><strong>Fresh from AI!</strong> This meal plan was just created for you.</span>
                        </div>
                    `);
                }

                const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
                const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
                
                // Store current meal plan for swap/regenerate operations
                window.currentMealPlan = mealPlan;
                
                let weeklyPlanHtml = '';
                days.forEach((day, index) => {
                    const dayPlan = mealPlan.weeklyPlan[day];
                    if (dayPlan) {
                        const breakfast = dayPlan.breakfast || {};
                        const lunch = dayPlan.lunch || {};
                        const dinner = dayPlan.dinner || {};
                        const snacks = Array.isArray(dayPlan.snacks) ? dayPlan.snacks : [];

                        // Store meals for logging
                        window.mealData = window.mealData || {};
                        window.mealData[`${day}_breakfast`] = breakfast;
                        window.mealData[`${day}_lunch`] = lunch;
                        window.mealData[`${day}_dinner`] = dinner;
                        snacks.forEach((s, i) => window.mealData[`${day}_snack_${i}`] = s);

                        weeklyPlanHtml += `
                            <div class="card mb-3 day-card" data-day="${day}" id="day-${day}">
                                <div class="day-header">
                                    <span>${dayNames[index]}</span>
                                    <button class="btn-regenerate-day" data-day="${day}" title="Regenerate this day's meals">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="meal-card" data-day="${day}" data-meal-type="breakfast" id="meal-${day}-breakfast">
                                                <div class="meal-header">
                                                    <h6><i class="bi bi-sunrise"></i> Breakfast</h6>
                                                    <div class="meal-actions">
