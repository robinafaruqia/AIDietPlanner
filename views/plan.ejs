<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Meal Plan - AI Diet Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-bottom: 50px;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: none;
            margin-bottom: 20px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
        }
        .meal-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .day-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: 600;
        }
        .grocery-item {
            padding: 10px;
            border-bottom: 1px solid #e9ecef;
        }
        .grocery-item:last-child {
            border-bottom: none;
        }
        .loading {
            display: none;
        }
        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-heart-pulse"></i> AI Diet Planner
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/plan">Create Plan</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0"><i class="bi bi-clipboard-data"></i> Create Your Meal Plan</h3>
                    </div>
                    <div class="card-body">
                        <form id="mealPlanForm">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="weight" class="form-label">Weight (kg)</label>
                                    <input type="number" class="form-control" id="weight" name="weight" 
                                           placeholder="Enter your weight" required min="1" step="0.1">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="height" class="form-label">Height (cm)</label>
                                    <input type="number" class="form-control" id="height" name="height" 
                                           placeholder="Enter your height" required min="50" max="250" step="0.1">
                                    <small class="form-text text-muted">e.g., 170 for 170 cm (5'7")</small>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="healthConditions" class="form-label">Health Condition</label>
                                    <select class="form-select" id="healthConditions" name="healthConditions">
                                        <option value="">None</option>
                                        <option value="gallstones">Gallstones</option>
                                        <option value="diabetes">Diabetes</option>
                                        <option value="high blood pressure">High Blood Pressure</option>
                                        <option value="heart disease">Heart Disease</option>
                                        <option value="obesity">Obesity</option>
                                    </select>
                                    <small class="form-text text-muted">Select your health condition for personalized meal plans</small>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="includeGroceryList" checked>
                                        <label class="form-check-label" for="includeGroceryList">
                                            <i class="bi bi-cart"></i> Include Grocery List
                                        </label>
                                        <small class="form-text text-muted d-block">Generate a shopping list based on the meal plan</small>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-magic"></i> Generate Meal Plan
                            </button>
                        </form>

                        <div class="loading text-center mt-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">Generating your personalized meal plan...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="mealPlanResult" style="display: none;">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><i class="bi bi-check-circle"></i> Your Weekly Meal Plan</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Daily Calories:</strong> <span id="totalCalories"></span> kcal
                        <br>
                        <strong>Weight:</strong> <span id="weightDisplay"></span> kg | <strong>Height:</strong> <span id="heightDisplay"></span> cm
                        <br>
                        <strong>Health Conditions Considered:</strong> <span id="healthConditionsDisplay"></span>
                    </div>
                    <div id="weeklyPlan"></div>
                </div>
            </div>

            <div class="card" id="groceryListCard" style="display: none;">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0"><i class="bi bi-cart"></i> Grocery List</h3>
                </div>
                <div class="card-body">
                    <div id="groceryList"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#mealPlanForm').on('submit', function(e) {
                e.preventDefault();
                
                const weight = $('#weight').val();
                const height = $('#height').val();
                const healthConditions = $('#healthConditions').val();
                const includeGroceryList = $('#includeGroceryList').is(':checked');
                
                if (!weight || weight <= 0) {
                    alert('Please enter a valid weight');
                    return;
                }
                
                if (!height || height <= 0) {
                    alert('Please enter a valid height');
                    return;
                }

                $('.loading').show();
                $('#mealPlanResult').hide();

                $.ajax({
                    url: '/api/meal-plan/generate',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        weight: parseFloat(weight),
                        height: parseFloat(height),
                        healthConditions: healthConditions ? [healthConditions] : [],
                        includeGroceryList: includeGroceryList
                    }),
                    success: function(response) {
                        $('.loading').hide();
                        if (response.success) {
                            displayMealPlan(response.mealPlan);
                        } else {
                            alert('Failed to generate meal plan');
                        }
                    },
                    error: function(xhr) {
                        $('.loading').hide();
                        const response = xhr.responseJSON || {};
                        const errorMsg = response.error || 'Failed to generate meal plan';
                        const errorDetails = response.details || '';
                        const errorCode = response.code || '';
                        const errorHelp = response.help || '';
                        
                        console.error('API Error:', response);
                        
                        // Show user-friendly error with help
                        showError(errorMsg, errorDetails, errorHelp, errorCode);
                    }
                });
            });

            function displayMealPlan(mealPlan) {
                $('#totalCalories').text(mealPlan.totalCalories);
                $('#weightDisplay').text(mealPlan.weight || $('#weight').val());
                $('#heightDisplay').text(mealPlan.height || $('#height').val());
                $('#healthConditionsDisplay').text(
                    mealPlan.healthConditions.length > 0 
                        ? mealPlan.healthConditions.join(', ') 
                        : 'None'
                );

                const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
                const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
                
                let weeklyPlanHtml = '';
                days.forEach((day, index) => {
                    const dayPlan = mealPlan.weeklyPlan[day];
                    if (dayPlan) {
                        weeklyPlanHtml += `
                            <div class="card mb-3">
                                <div class="day-header">${dayNames[index]}</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-sunrise"></i> Breakfast</h6>
                                                <strong>${dayPlan.breakfast.name}</strong>
                                                <p class="mb-1"><small>${dayPlan.breakfast.ingredients.join(', ')}</small></p>
                                                <small class="text-muted">${dayPlan.breakfast.calories} kcal | P: ${dayPlan.breakfast.protein}g | C: ${dayPlan.breakfast.carbs}g | F: ${dayPlan.breakfast.fat}g</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-sun"></i> Lunch</h6>
                                                <strong>${dayPlan.lunch.name}</strong>
                                                <p class="mb-1"><small>${dayPlan.lunch.ingredients.join(', ')}</small></p>
                                                <small class="text-muted">${dayPlan.lunch.calories} kcal | P: ${dayPlan.lunch.protein}g | C: ${dayPlan.lunch.carbs}g | F: ${dayPlan.lunch.fat}g</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-moon"></i> Dinner</h6>
                                                <strong>${dayPlan.dinner.name}</strong>
                                                <p class="mb-1"><small>${dayPlan.dinner.ingredients.join(', ')}</small></p>
                                                <small class="text-muted">${dayPlan.dinner.calories} kcal | P: ${dayPlan.dinner.protein}g | C: ${dayPlan.dinner.carbs}g | F: ${dayPlan.dinner.fat}g</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="meal-card">
                                                <h6><i class="bi bi-apple"></i> Snacks</h6>
                                                ${dayPlan.snacks.map(snack => `
                                                    <div>
                                                        <strong>${snack.name}</strong>
                                                        <p class="mb-1"><small>${snack.ingredients.join(', ')}</small></p>
                                                        <small class="text-muted">${snack.calories} kcal</small>
                                                    </div>
                                                `).join('')}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                });
                $('#weeklyPlan').html(weeklyPlanHtml);

                // Display grocery list only if it exists and has items
                if (mealPlan.groceryList && mealPlan.groceryList.length > 0) {
                    const groceryByCategory = {};
                    mealPlan.groceryList.forEach(item => {
                        if (!groceryByCategory[item.category]) {
                            groceryByCategory[item.category] = [];
                        }
                        groceryByCategory[item.category].push(item);
                    });

                    let groceryHtml = '';
                    Object.keys(groceryByCategory).forEach(category => {
                        groceryHtml += `
                            <h5 class="mt-3 mb-3">${category}</h5>
                            <ul class="list-group">
                                ${groceryByCategory[category].map(item => `
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        ${item.item}
                                        <span class="badge bg-primary rounded-pill">${item.quantity}</span>
                                    </li>
                                `).join('')}
                            </ul>
                        `;
                    });
                    $('#groceryList').html(groceryHtml);
                    $('#groceryListCard').show();
                } else {
                    $('#groceryListCard').hide();
                }

                $('#mealPlanResult').show();
                $('html, body').animate({
                    scrollTop: $('#mealPlanResult').offset().top
                }, 500);
            }
            
            // Show error message with details and help
            function showError(title, details, help, code) {
                // Hide any existing error
                $('#errorAlert').remove();
                
                // Create error HTML
                const errorHtml = `
                    <div id="errorAlert" class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill"></i> ${escapeHtml(title)}
                        </h5>
                        ${details ? `<p class="mb-2">${escapeHtml(details)}</p>` : ''}
                        ${help ? `
                            <hr>
                            <p class="mb-0">
                                <strong><i class="bi bi-lightbulb"></i> How to fix:</strong><br>
                                ${escapeHtml(help)}
                            </p>
                        ` : ''}
                        ${code ? `<small class="text-muted d-block mt-2">Error code: ${escapeHtml(code)}</small>` : ''}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                
                // Insert after the form
                $('#mealPlanForm').after(errorHtml);
                
                // Scroll to error
                $('html, body').animate({
                    scrollTop: $('#errorAlert').offset().top - 100
                }, 300);
            }
            
            // Helper to escape HTML to prevent XSS
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        });
    </script>
</body>
</html>

