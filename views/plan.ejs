        // Log meal to nutrition tracker
        async function logMeal(mealKey, mealType) {
            const meal = window.mealData?.[mealKey];
            if (!meal || !meal.name) {
                alert('Meal data not found');
                return;
            }

            try {
                const response = await $.ajax({
                    url: '/api/nutrition/log/from-plan',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        mealType: mealType,
                        meal: meal
                    })
                });

                if (response.success) {
                    // Show success toast
                    const toast = $(`
                        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
                            <div class="toast show" role="alert">
                                <div class="toast-header bg-success text-white">
                                    <i class="bi bi-check-circle me-2"></i>
                                    <strong class="me-auto">Meal Logged!</strong>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                                </div>
                                <div class="toast-body">
                                    ${escapeHtml(meal.name)} has been added to your nutrition log.
                                    <a href="/tracking" class="btn btn-sm btn-outline-primary mt-2">View Tracking</a>
                                </div>
                            </div>
                        </div>
                    `);
                    $('body').append(toast);
                    setTimeout(() => toast.remove(), 4000);
                } else {
                    alert('Failed to log meal: ' + (response.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Log meal error:', error);
                const msg = error.responseJSON?.error || 'Failed to log meal';
                alert(msg);
            }
        }

