            try {
                const response = await $.ajax({
                    url: `/api/meal-plan/${planId}`,
                    method: 'DELETE'
                });

                if (response.success) {
                    $row.fadeOut(300, function() {
                        $(this).remove();
                        // Reload if table is empty
                        if ($('#historyTableBody tr').length === 0) {
                            loadHistory(true);
                        }
                    });
                } else {
                    alert('Failed to delete meal plan');
                }
            } catch (error) {
                console.error('Error deleting meal plan:', error);
                alert('Failed to delete meal plan');
            }
        });

        // Regenerate a single day's meals
        $(document).on('click', '.btn-regenerate-day', async function() {
            const $btn = $(this);
            const day = $btn.data('day');
            const $dayCard = $(`#day-${day}`);
            
            if ($btn.prop('disabled')) return;
            
            const weight = $('#weight').val() || window.currentMealPlan?.weight;
            const height = $('#height').val() || window.currentMealPlan?.height;
            const healthConditions = $('#healthConditions').val() || window.currentMealPlan?.healthConditions || [];
            const customCondition = $('#customCondition').val()?.trim();
            let allConditions = [...healthConditions];
            if (customCondition) allConditions.push(customCondition);
            
            if (!weight || !height) {
                alert('Please ensure weight and height are set');
                return;
            }
            
            // Show loading state
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            $dayCard.addClass('loading-day');
            
            try {
                const response = await $.ajax({
                    url: '/api/meal-plan/regenerate-day',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        weight: parseFloat(weight),
                        height: parseFloat(height),
                        healthConditions: allConditions,
                        dayName: day,
                        dietPreference: $('#dietPrefToggle').is(':checked') ? 'vegetarian' : 'non-vegetarian'
                    })
                });
                
                if (response.success) {
                    // Update the meal plan data
                    window.currentMealPlan.weeklyPlan[day] = response.dayPlan;
                    
                    // Update meal data for logging
                    window.mealData[`${day}_breakfast`] = response.dayPlan.breakfast;
                    window.mealData[`${day}_lunch`] = response.dayPlan.lunch;
                    window.mealData[`${day}_dinner`] = response.dayPlan.dinner;
                    response.dayPlan.snacks.forEach((s, i) => window.mealData[`${day}_snack_${i}`] = s);
                    
                    // Update UI in place
                    updateDayUI(day, response.dayPlan);
                    
                    // Show success toast
                    showToast('success', 'Day Regenerated!', `${capitalizeFirst(day)}'s meals have been updated.`);
                }
            } catch (error) {
                console.error('Regenerate day error:', error);
                const msg = error.responseJSON?.error || 'Failed to regenerate day';
                showToast('danger', 'Error', msg);
            } finally {
                $btn.prop('disabled', false).html('<i class="bi bi-arrow-clockwise"></i>');
                $dayCard.removeClass('loading-day');
            }
        });
        
        // Swap a single meal
        $(document).on('click', '.btn-swap-meal', async function() {
            const $btn = $(this);
            const day = $btn.data('day');
            const mealType = $btn.data('meal-type');
            const currentMealName = $btn.data('meal-name');
            const snackIdx = $btn.data('snack-idx');
            
            if ($btn.prop('disabled')) return;
            
            const weight = $('#weight').val() || window.currentMealPlan?.weight;
            const height = $('#height').val() || window.currentMealPlan?.height;
            const healthConditions = $('#healthConditions').val() || window.currentMealPlan?.healthConditions || [];
            const customCondition = $('#customCondition').val()?.trim();
            let allConditions = [...healthConditions];
            if (customCondition) allConditions.push(customCondition);
            
            if (!weight || !height) {
                alert('Please ensure weight and height are set');
                return;
            }
            
            // Get the meal card element
            const $mealCard = mealType === 'snack' 
                ? $btn.closest('.snack-item')
                : $btn.closest('.meal-card');
            
            // Show loading state
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            $mealCard.addClass('loading-meal');
            
            try {
                const response = await $.ajax({
                    url: '/api/meal-plan/swap-meal',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        weight: parseFloat(weight),
                        height: parseFloat(height),
                        healthConditions: allConditions,
                        mealType: mealType,
                        currentMealName: currentMealName,
                        dietPreference: $('#dietPrefToggle').is(':checked') ? 'vegetarian' : 'non-vegetarian'
                    })
                });
                
                if (response.success) {
                    // Update meal plan data
                    if (mealType === 'snack' && snackIdx !== undefined) {
                        window.currentMealPlan.weeklyPlan[day].snacks[snackIdx] = response.meal;
                        window.mealData[`${day}_snack_${snackIdx}`] = response.meal;
                    } else {
                        window.currentMealPlan.weeklyPlan[day][mealType] = response.meal;
                        window.mealData[`${day}_${mealType}`] = response.meal;
                    }
                    
                    // Update UI in place
                    updateMealUI(day, mealType, response.meal, snackIdx);
                    
                    // Update the button's data-meal-name for next swap
                    $btn.data('meal-name', response.meal.name);
                    
                    // Show success toast
                    showToast('success', 'Meal Swapped!', `Now: ${response.meal.name}`);
                }
            } catch (error) {
                console.error('Swap meal error:', error);
                const msg = error.responseJSON?.error || 'Failed to swap meal';
                showToast('danger', 'Error', msg);
            } finally {
                $btn.prop('disabled', false).html('<i class="bi bi-arrow-repeat"></i>');
                $mealCard.removeClass('loading-meal');
            }
        });
        
        // Update a full day's UI
        function updateDayUI(day, dayPlan) {
            updateMealUI(day, 'breakfast', dayPlan.breakfast);
            updateMealUI(day, 'lunch', dayPlan.lunch);
            updateMealUI(day, 'dinner', dayPlan.dinner);
            
            // Update snacks
            const $snacksCard = $(`#meal-${day}-snacks`);
            const snacksHtml = dayPlan.snacks.map((snack, snackIdx) => `
                <div class="mb-2 snack-item" data-snack-idx="${snackIdx}">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong class="meal-name">${escapeHtml(snack?.name || '')}</strong>
                        <div class="meal-actions">
                            <button class="btn-swap-meal" data-day="${day}" data-meal-type="snack" data-snack-idx="${snackIdx}" data-meal-name="${escapeHtml(snack?.name || '')}" title="Swap snack">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-success btn-log-meal" data-meal-key="${day}_snack_${snackIdx}" data-meal-type="snack" title="Log this snack">
                                <i class="bi bi-plus-circle"></i>
                            </button>
                        </div>
                    </div>
                    <p class="mb-1 meal-ingredients"><small>${(snack?.ingredients || []).map(i => escapeHtml(i)).join(', ')}</small></p>
                    <small class="text-muted meal-macros">${snack?.calories || 0} kcal</small>
                </div>
            `).join('');
            
            $snacksCard.find('.snack-item').remove();
            $snacksCard.find('.meal-header').after(snacksHtml);
        }
        
        // Update a single meal's UI
        function updateMealUI(day, mealType, meal, snackIdx) {
            if (mealType === 'snack' && snackIdx !== undefined) {
                const $snackItem = $(`#meal-${day}-snacks .snack-item[data-snack-idx="${snackIdx}"]`);
                $snackItem.find('.meal-name').text(meal.name || '');
                $snackItem.find('.meal-ingredients small').text((meal.ingredients || []).join(', '));
                $snackItem.find('.meal-macros').text(`${meal.calories || 0} kcal`);
                return;
            }
            
            const $mealCard = $(`#meal-${day}-${mealType}`);
            $mealCard.find('.meal-name').text(meal.name || '');
            $mealCard.find('.meal-ingredients small').text((meal.ingredients || []).join(', '));
            $mealCard.find('.meal-macros').text(
                `${meal.calories || 0} kcal | P: ${meal.protein || 0}g | C: ${meal.carbs || 0}g | F: ${meal.fat || 0}g`
            );
        }
        
        // Helper to capitalize first letter
        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }
        
        // Toast notification helper
        function showToast(type, title, message) {
            const bgClass = type === 'success' ? 'bg-success' : (type === 'danger' ? 'bg-danger' : 'bg-info');
            const toast = $(`
                <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
                    <div class="toast show" role="alert">
                        <div class="toast-header ${bgClass} text-white">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                            <strong class="me-auto">${escapeHtml(title)}</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">${escapeHtml(message)}</div>
                    </div>
                </div>
            `);
            $('body').append(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        function showAchievementToast(achievement) {
            const toast = $(`
                <div class="achievement-toast">
                    <div class="toast-icon">
                        <i class="bi ${achievement.icon || 'bi-trophy'}"></i>
                    </div>
                    <div class="toast-content">
                        <h6>Achievement Unlocked!</h6>
                        <p>${escapeHtml(achievement.name)}</p>
                    </div>
                </div>
            `);
            
            if (!$('.toast-container').length) {
                $('body').append('<div class="toast-container"></div>');
            }
            
            $('.toast-container').append(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 5000);
        }
    </script>
</body>
</html>

