        // Loading animation with fitness hints
        let loadingInterval = null;
        let progressInterval = null;
        let currentHintIndex = 0;
        let currentProgress = 10;

        const loadingHints = [
            { icon: '🏊', text: 'Swimming through nutritional databases...' },
            { icon: '🏋️', text: 'Lifting the best protein sources for you...' },
            { icon: '🚴', text: 'Cycling through healthy carb options...' },
            { icon: '🧘', text: 'Finding balance in your macros...' },
            { icon: '🥗', text: 'Mixing fresh ingredients for your salads...' },
            { icon: '🍳', text: 'Cracking the code on perfect breakfasts...' },
            { icon: '🥑', text: 'Selecting heart-healthy fats...' },
            { icon: '💪', text: 'Building your muscle-friendly meals...' },
            { icon: '🏃', text: 'Running calculations for your calories...' },
            { icon: '🧠', text: 'AI is thinking about your health goals...' },
            { icon: '📊', text: 'Analyzing your nutritional requirements...' },
            { icon: '🌿', text: 'Gathering organic meal ideas...' },
            { icon: '🍎', text: 'Picking the freshest fruits for you...' },
            { icon: '🐟', text: 'Fishing for omega-3 rich options...' },
            { icon: '🥩', text: 'Selecting lean protein sources...' }
        ];

        const loadingSteps = [
            { progress: 20, step: 'Step 1 of 5: Analyzing health conditions...' },
            { progress: 40, step: 'Step 2 of 5: Calculating daily calories...' },
            { progress: 60, step: 'Step 3 of 5: Crafting breakfast & lunch...' },
            { progress: 75, step: 'Step 4 of 5: Designing dinner & snacks...' },
            { progress: 90, step: 'Step 5 of 5: Generating grocery list...' }
        ];

        function startLoadingAnimation() {
            currentHintIndex = 0;
            currentProgress = 10;
            let stepIndex = 0;

            // Update hints every 2.5 seconds
            loadingInterval = setInterval(() => {
                currentHintIndex = (currentHintIndex + 1) % loadingHints.length;
                const hint = loadingHints[currentHintIndex];
                $('#loadingHint').html(`<span class="hint-icon">${hint.icon}</span> ${hint.text}`);
            }, 2500);

            // Update progress every 3 seconds
            progressInterval = setInterval(() => {
                if (stepIndex < loadingSteps.length) {
                    const step = loadingSteps[stepIndex];
                    $('#loadingProgress').css('width', step.progress + '%');
                    $('#loadingStep').text(step.step);
                    stepIndex++;
                }
            }, 3000);
        }

        function stopLoadingAnimation() {
            if (loadingInterval) {
                clearInterval(loadingInterval);
                loadingInterval = null;
            }
            if (progressInterval) {
                clearInterval(progressInterval);
                progressInterval = null;
            }
            // Reset to initial state
            $('#loadingProgress').css('width', '10%');
            $('#loadingStep').text('Step 1 of 5');
            $('#loadingHint').html('<span class="hint-icon">🏊</span> Swimming through nutritional data...');
        }

        // History functionality
        let historySkip = 0;
        const historyLimit = 10;

        // Load history when modal opens
        $('#historyModal').on('show.bs.modal', function() {
            historySkip = 0;
            loadHistory(true);
        });

        async function loadHistory(reset = false) {
            if (reset) {
                historySkip = 0;
                $('#historyTableBody').empty();
            }

            try {
                $('#historyLoading').show();
                $('#historyList').hide();
                $('#historyEmpty').hide();

                const response = await $.get(`/api/meal-plan/history/list?limit=${historyLimit}&skip=${historySkip}`);
                
                $('#historyLoading').hide();

                if (!response.success) {
                    $('#historyEmpty').show();
                    return;
                }

                if (response.history.length === 0 && historySkip === 0) {
                    $('#historyEmpty').show();
                    return;
                }

                $('#historyList').show();

                response.history.forEach(plan => {
                    const date = new Date(plan.createdAt).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    const conditions = plan.healthConditions.length > 0 
                        ? plan.healthConditions.join(', ') 
                        : '<span class="text-muted">None</span>';

                    $('#historyTableBody').append(`
                        <tr>
                            <td><small>${date}</small></td>
                            <td>${plan.weight} kg</td>
                            <td>${plan.height} cm</td>
                            <td><small>${conditions}</small></td>
                            <td>${plan.totalCalories || '-'} kcal</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary btn-view-plan" data-plan-id="${plan.id}" title="View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-success btn-use-inputs" 
                                        data-weight="${plan.weight}" 
                                        data-height="${plan.height}" 
                                        data-conditions="${plan.healthConditions.join(',')}"
                                        title="Use these inputs">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-delete-plan" data-plan-id="${plan.id}" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `);
                });

                historySkip += response.history.length;
                
                $('#historyCount').text(`Showing ${historySkip} of ${response.pagination.total} meal plans`);
                
                if (response.pagination.hasMore) {
                    $('#loadMoreHistory').show();
                } else {
                    $('#loadMoreHistory').hide();
                }
            } catch (error) {
                console.error('Error loading history:', error);
                $('#historyLoading').hide();
                $('#historyEmpty').html(`
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">Failed to load history. Please try again.</p>
                `).show();
            }
        }

        // Load more history
        $('#loadMoreHistory').click(function() {
            loadHistory(false);
        });

        // View a specific meal plan from history
        $(document).on('click', '.btn-view-plan', async function() {
            const planId = $(this).data('plan-id');
            
            try {
                const response = await $.get(`/api/meal-plan/${planId}`);
                
                if (response.success && response.mealPlan) {
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('historyModal')).hide();
                    
                    // Display the meal plan
                    displayMealPlan({
                        id: response.mealPlan._id,
