<!-- Google Fonts - Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* Theme CSS Variables */
    :root {
        --body-bg: #ffffff;
        --body-bg-secondary: #f8f9fa;
        --text-color: #212529;
        --text-muted: #6c757d;
        --card-bg: #ffffff;
        --card-border: rgba(0, 0, 0, 0.125);
        --input-bg: #ffffff;
        --input-border: #ced4da;
        --input-text: #212529;
        --modal-bg: #ffffff;
        --modal-header-bg: #f8f9fa;
        --dropdown-bg: #ffffff;
        --dropdown-border: rgba(0, 0, 0, 0.15);
        --dropdown-link-hover: #f8f9fa;
        --table-bg: #ffffff;
        --table-striped-bg: rgba(0, 0, 0, 0.05);
        --table-hover-bg: rgba(0, 0, 0, 0.075);
        --border-color: #dee2e6;
        --alert-info-bg: #cff4fc;
        --alert-info-border: #b6effb;
        --alert-info-text: #055160;
        --alert-success-bg: #d1e7dd;
        --alert-success-border: #badbcc;
        --alert-success-text: #0f5132;
        --list-group-bg: #ffffff;
        --list-group-border: rgba(0, 0, 0, 0.125);
        --shadow-color: rgba(0, 0, 0, 0.2);
        --meal-card-bg: #f8f9fa;
        --select2-bg: #ffffff;
        --select2-border: #ced4da;
    }

    /* ========================================
       GLOBAL UI IMPROVEMENTS
       ======================================== */
    
    /* Inter Font Family */
    body, .btn, .form-control, .form-select, input, select, textarea {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    }

    /* Smooth Scrolling */
    html {
        scroll-behavior: smooth;
    }

    /* Page Load Animation */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    @keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Animated Cards */
    .card {
        animation: fadeInUp 0.4s ease-out;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px var(--shadow-color);
    }

    .card.no-hover:hover {
        transform: none;
        box-shadow: 0 2px 12px var(--shadow-color);
    }

    /* Staggered Animation for Multiple Cards */
    .card:nth-child(1) { animation-delay: 0s; }
    .card:nth-child(2) { animation-delay: 0.1s; }
    .card:nth-child(3) { animation-delay: 0.2s; }
    .card:nth-child(4) { animation-delay: 0.3s; }
    .card:nth-child(5) { animation-delay: 0.4s; }

    /* Enhanced Buttons */
    .btn {
        transition: all 0.2s ease;
        font-weight: 500;
        border-radius: 10px;
    }

    .btn:active {
        transform: scale(0.96);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        box-shadow: 0 4px 14px rgba(102, 126, 234, 0.4);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
        transform: translateY(-2px);
    }

    .btn-primary:active {
        transform: scale(0.96) translateY(0);
    }

    .btn-success {
        box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);
    }

    .btn-success:hover {
        box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
        transform: translateY(-2px);
    }

    .btn-danger {
        box-shadow: 0 4px 14px rgba(239, 68, 68, 0.3);
    }

    .btn-danger:hover {
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        transform: translateY(-2px);
    }

    .btn-outline-primary {
        border-width: 2px;
    }

    .btn-outline-primary:hover {
        transform: translateY(-2px);
    }

    /* Enhanced Form Inputs */
    .form-control, .form-select {
        border-radius: 10px;
        padding: 12px 16px;
        border: 2px solid var(--input-border);
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
    }

    .form-control::placeholder {
        color: var(--text-muted);
        opacity: 0.7;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 8px;
        color: var(--text-color);
    }

    /* Input Groups */
    .input-group .form-control {
        border-radius: 10px;
    }

    .input-group > :not(:first-child):not(.dropdown-menu):not(.valid-tooltip):not(.valid-feedback):not(.invalid-tooltip):not(.invalid-feedback) {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .input-group:not(.has-validation) > :not(:last-child):not(.dropdown-toggle):not(.dropdown-menu):not(.form-floating) {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    /* Skeleton Loading */
    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 8px;
    }

    .skeleton-text {
        height: 16px;
        margin-bottom: 8px;
    }

    .skeleton-text.short {
        width: 60%;
    }

    .skeleton-title {
        height: 24px;
        width: 40%;
        margin-bottom: 16px;
    }

    .skeleton-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
    }

    .skeleton-card {
        height: 150px;
    }

    [data-theme="dark"] .skeleton {
        background: linear-gradient(90deg, #2b3035 25%, #343a40 50%, #2b3035 75%);
        background-size: 200% 100%;
    }

    /* Empty State Component */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        animation: fadeIn 0.5s ease;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
        margin-bottom: 20px;
    }

    .empty-state h5 {
        font-weight: 600;
        color: var(--text-color);
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--text-muted);
        margin-bottom: 20px;
        max-width: 300px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Enhanced Toast Notifications */
    .toast-container {
        z-index: 9999;
    }

    .toast {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        animation: slideInRight 0.3s ease;
    }

    .toast-success {
        background: linear-gradient(135deg, #10b981, #059669) !important;
        color: white !important;
    }

    .toast-success .toast-header {
        background: transparent !important;
        color: white !important;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-success .toast-body {
        color: white !important;
    }

    .toast-error {
        background: linear-gradient(135deg, #ef4444, #dc2626) !important;
        color: white !important;
    }

    .toast-error .toast-header {
        background: transparent !important;
        color: white !important;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-error .toast-body {
        color: white !important;
    }

    .toast-info {
        background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
        color: white !important;
    }

    .toast-info .toast-header {
        background: transparent !important;
        color: white !important;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-info .toast-body {
        color: white !important;
    }

    /* Enhanced Progress Bars */
    .progress {
        border-radius: 10px;
        overflow: hidden;
        height: 10px;
    }

    .progress-bar {
        transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 10px;
    }

    /* Loading Spinner Enhancement */
    .spinner-border {
        animation: spin 0.8s linear infinite;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease;
    }

    [data-theme="dark"] .loading-overlay {
        background: rgba(26, 29, 33, 0.9);
    }

    /* Badge Enhancements */
    .badge {
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
    }

    /* Modal Enhancements */
    .modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
        animation: fadeInUp 0.3s ease;
    }

    .modal-header {
        border-radius: 16px 16px 0 0;
        padding: 20px 24px;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        border-radius: 0 0 16px 16px;
        padding: 16px 24px;
    }

    /* Dropdown Enhancements */
    .dropdown-menu {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        padding: 8px;
        animation: fadeInUp 0.2s ease;
    }

    .dropdown-item {
        border-radius: 8px;
        padding: 10px 16px;
        font-weight: 500;
        transition: all 0.15s ease;
    }

    .dropdown-item:hover {
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
    }

    .dropdown-item i {
        margin-right: 10px;
        width: 18px;
        text-align: center;
    }

    /* Table Enhancements */
    .table {
        border-radius: 12px;
        overflow: hidden;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        padding: 16px;
    }

    .table td {
        padding: 16px;
        vertical-align: middle;
    }

    .table-hover tbody tr {
        transition: background-color 0.15s ease;
    }

    /* Alert Enhancements */
    .alert {
        border-radius: 12px;
        border: none;
        padding: 16px 20px;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));
        color: #059669;
    }

    .alert-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.1));
        color: #dc2626;
    }

    .alert-info {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(37, 99, 235, 0.1));
        color: #2563eb;
    }

    .alert-warning {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.1));
        color: #d97706;
    }

    /* List Group Enhancements */
    .list-group {
        border-radius: 12px;
        overflow: hidden;
    }

    .list-group-item {
        border-left: none;
        border-right: none;
        padding: 16px 20px;
        transition: background-color 0.15s ease;
    }

    .list-group-item:first-child {
        border-top: none;
    }

    .list-group-item:last-child {
        border-bottom: none;
    }

    .list-group-item-action:hover {
        background-color: rgba(102, 126, 234, 0.05);
    }

    /* Navbar Enhancements */
    .navbar {
        padding: 12px 0;
        transition: all 0.3s ease;
    }

    .navbar-brand {
        font-weight: 700;
        font-size: 1.25rem;
    }

    .nav-link {
        font-weight: 500;
        padding: 8px 16px !important;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .nav-link:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .nav-link.active {
        background: rgba(255, 255, 255, 0.15);
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: var(--body-bg-secondary);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: var(--text-muted);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #667eea;
    }

    /* Focus States */
    *:focus-visible {
        outline: 2px solid #667eea;
        outline-offset: 2px;
    }

    /* Selection Color */
    ::selection {
        background: rgba(102, 126, 234, 0.3);
        color: var(--text-color);
    }

    /* Ripple Effect for Buttons */
    .btn-ripple {
        position: relative;
        overflow: hidden;
    }

    .btn-ripple::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.3s ease, height 0.3s ease;
    }

    .btn-ripple:active::after {
        width: 200px;
        height: 200px;
    }

    /* Tooltip Enhancement */
    .tooltip {
        font-family: 'Inter', sans-serif;
    }

    .tooltip-inner {
        border-radius: 8px;
        padding: 8px 12px;
        font-weight: 500;
    }

    /* Mobile Responsive Improvements */
    @media (max-width: 768px) {
        .card {
            margin-bottom: 16px;
        }

        .btn {
            padding: 10px 20px;
        }

        .form-control, .form-select {
            padding: 10px 14px;
        }

        .modal-content {
            margin: 10px;
            border-radius: 12px;
        }

        h1, .h1 { font-size: 1.75rem; }
        h2, .h2 { font-size: 1.5rem; }
        h3, .h3 { font-size: 1.25rem; }
    }

    [data-theme="dark"] {
        --body-bg: #1a1d21;
        --body-bg-secondary: #212529;
        --text-color: #e9ecef;
        --text-muted: #adb5bd;
        --card-bg: #2b3035;
        --card-border: rgba(255, 255, 255, 0.1);
        --input-bg: #343a40;
        --input-border: #495057;
        --input-text: #e9ecef;
        --modal-bg: #2b3035;
        --modal-header-bg: #343a40;
        --dropdown-bg: #2b3035;
        --dropdown-border: rgba(255, 255, 255, 0.15);
        --dropdown-link-hover: #343a40;
        --table-bg: #2b3035;
        --table-striped-bg: rgba(255, 255, 255, 0.05);
        --table-hover-bg: rgba(255, 255, 255, 0.075);
        --border-color: #495057;
        --alert-info-bg: #1a3a4a;
        --alert-info-border: #1d4a5a;
        --alert-info-text: #8ecae6;
        --alert-success-bg: #1a3a2a;
        --alert-success-border: #1d4a3a;
        --alert-success-text: #8ecaaf;
        --list-group-bg: #2b3035;
        --list-group-border: rgba(255, 255, 255, 0.1);
        --shadow-color: rgba(0, 0, 0, 0.5);
        --meal-card-bg: #343a40;
        --select2-bg: #343a40;
        --select2-border: #495057;
    }

    /* Apply theme variables to Bootstrap components */
    [data-theme="dark"] body {
        background-color: var(--body-bg) !important;
        color: var(--text-color);
    }

    [data-theme="dark"] .card {
        background-color: var(--card-bg) !important;
        border-color: var(--card-border) !important;
        color: var(--text-color);
    }

    [data-theme="dark"] .card-body,
    [data-theme="dark"] .card-header,
    [data-theme="dark"] .card-footer {
        color: var(--text-color);
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: var(--input-bg) !important;
        border-color: var(--input-border) !important;
        color: var(--input-text) !important;
    }

    [data-theme="dark"] .form-control:focus,
    [data-theme="dark"] .form-select:focus {
        background-color: var(--input-bg) !important;
        border-color: #667eea !important;
        color: var(--input-text) !important;
        box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
    }

    [data-theme="dark"] .form-control::placeholder {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .form-label {
        color: var(--text-color);
    }

    [data-theme="dark"] .form-text,
    [data-theme="dark"] .text-muted {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .form-check-label {
        color: var(--text-color);
    }

    [data-theme="dark"] .modal-content {
        background-color: var(--modal-bg);
        color: var(--text-color);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .modal-header {
        border-color: var(--border-color);
    }

    [data-theme="dark"] .modal-footer {
        border-color: var(--border-color);
    }

    [data-theme="dark"] .dropdown-menu {
        background-color: var(--dropdown-bg);
        border-color: var(--dropdown-border);
    }

    [data-theme="dark"] .dropdown-item {
        color: var(--text-color);
    }

    [data-theme="dark"] .dropdown-item:hover,
    [data-theme="dark"] .dropdown-item:focus {
        background-color: var(--dropdown-link-hover);
        color: var(--text-color);
    }

    [data-theme="dark"] .dropdown-divider {
        border-color: var(--border-color);
    }

    [data-theme="dark"] .table {
        --bs-table-bg: var(--table-bg);
        --bs-table-striped-bg: var(--table-striped-bg);
        --bs-table-hover-bg: var(--table-hover-bg);
        color: var(--text-color);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .table-light {
        --bs-table-bg: var(--modal-header-bg);
        color: var(--text-color);
    }

    [data-theme="dark"] .table > :not(caption) > * > * {
        border-color: var(--border-color);
        background-color: var(--table-bg);
        color: var(--text-color);
    }

    [data-theme="dark"] .table-hover > tbody > tr:hover > * {
        background-color: var(--table-hover-bg);
    }

    [data-theme="dark"] .alert-info {
        background-color: var(--alert-info-bg);
        border-color: var(--alert-info-border);
        color: var(--alert-info-text);
    }

    [data-theme="dark"] .alert-success {
        background-color: var(--alert-success-bg);
        border-color: var(--alert-success-border);
        color: var(--alert-success-text);
    }

    [data-theme="dark"] .alert-danger {
        background-color: #3a1a1a;
        border-color: #4a1d1d;
        color: #f8b4b4;
    }

    [data-theme="dark"] .list-group-item {
        background-color: var(--list-group-bg);
        border-color: var(--list-group-border);
        color: var(--text-color);
    }

    [data-theme="dark"] .meal-card {
        background-color: var(--meal-card-bg) !important;
        color: var(--text-color);
    }

    [data-theme="dark"] .btn-outline-secondary {
        color: var(--text-muted);
        border-color: var(--text-muted);
    }

    [data-theme="dark"] .btn-outline-secondary:hover {
        background-color: var(--text-muted);
        color: var(--body-bg);
    }

    [data-theme="dark"] .btn-outline-primary {
        color: #8ea8f0;
        border-color: #8ea8f0;
    }

    [data-theme="dark"] .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    [data-theme="dark"] hr {
        border-color: var(--border-color);
    }

    [data-theme="dark"] footer.bg-dark {
        background-color: #0d0f11 !important;
    }

    [data-theme="dark"] .toast {
        background-color: var(--card-bg);
        color: var(--text-color);
    }

    [data-theme="dark"] .toast-header {
        background-color: var(--modal-header-bg);
        color: var(--text-color);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .toast-body {
        color: var(--text-color);
    }

    /* Select2 dark mode */
    [data-theme="dark"] .select2-container--bootstrap-5 .select2-selection {
        background-color: var(--select2-bg) !important;
        border-color: var(--select2-border) !important;
        color: var(--input-text) !important;
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-dropdown {
        background-color: var(--dropdown-bg);
        border-color: var(--dropdown-border);
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-results__option {
        color: var(--text-color);
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-results__option--highlighted {
        background-color: #667eea !important;
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-search__field {
        background-color: var(--input-bg) !important;
        color: var(--input-text) !important;
    }

    /* Progress bar in dark mode */
    [data-theme="dark"] .progress {
        background-color: var(--input-bg);
    }

    /* Feature icons on home page */
    [data-theme="dark"] .feature-icon {
        color: #8ea8f0 !important;
    }

    /* Spinner */
    [data-theme="dark"] .spinner-border.text-primary {
        color: #8ea8f0 !important;
    }

    /* Tracking page specific styles */
    [data-theme="dark"] body {
        background: var(--body-bg) !important;
    }

    [data-theme="dark"] .macro-bar {
