<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="bi bi-heart-pulse"></i> AI Diet Planner
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'plan' ? 'active' : '' %>" href="/plan">Create Plan</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'tracking' ? 'active' : '' %>" href="/tracking">Tracking</a>
                </li>
                <% if (typeof user !== 'undefined' && user) { %>
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'weight' ? 'active' : '' %>" href="/weight">Weight</a>
                </li>
                <% } %>
            </ul>
            <ul class="navbar-nav">
                <% if (typeof user !== 'undefined' && user) { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" alt="" class="rounded-circle me-1" width="24" height="24" style="object-fit: cover;">
                        <% } else { %>
                            <i class="bi bi-person-circle me-1"></i>
                        <% } %>
                        <%= user.name %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i> Profile</a></li>
                        <li><a class="dropdown-item" href="/weight"><i class="bi bi-graph-up"></i> Weight Tracking</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="navLogoutBtn"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                    </ul>
                </li>
                <% } else { %>
                <li class="nav-item">
                    <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link btn btn-outline-light btn-sm ms-2" href="/register">Sign Up</a>
                </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const logoutBtn = document.getElementById('navLogoutBtn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
                window.location.href = '/';
            } catch (error) {
                console.error('Logout failed:', error);
            }
        });
    }
});
</script>
