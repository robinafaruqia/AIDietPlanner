<style>
    /* Theme CSS Variables */
    :root {
        --body-bg: #ffffff;
        --body-bg-secondary: #f8f9fa;
        --text-color: #212529;
        --text-muted: #6c757d;
        --card-bg: #ffffff;
        --card-border: rgba(0, 0, 0, 0.125);
        --input-bg: #ffffff;
        --input-border: #ced4da;
        --input-text: #212529;
        --modal-bg: #ffffff;
        --modal-header-bg: #f8f9fa;
        --dropdown-bg: #ffffff;
        --dropdown-border: rgba(0, 0, 0, 0.15);
        --dropdown-link-hover: #f8f9fa;
        --table-bg: #ffffff;
        --table-striped-bg: rgba(0, 0, 0, 0.05);
        --table-hover-bg: rgba(0, 0, 0, 0.075);
        --border-color: #dee2e6;
        --alert-info-bg: #cff4fc;
        --alert-info-border: #b6effb;
        --alert-info-text: #055160;
        --alert-success-bg: #d1e7dd;
        --alert-success-border: #badbcc;
        --alert-success-text: #0f5132;
        --list-group-bg: #ffffff;
        --list-group-border: rgba(0, 0, 0, 0.125);
        --shadow-color: rgba(0, 0, 0, 0.2);
        --meal-card-bg: #f8f9fa;
        --select2-bg: #ffffff;
        --select2-border: #ced4da;
    }

    [data-theme="dark"] {
        --body-bg: #1a1d21;
        --body-bg-secondary: #212529;
        --text-color: #e9ecef;
        --text-muted: #adb5bd;
        --card-bg: #2b3035;
        --card-border: rgba(255, 255, 255, 0.1);
        --input-bg: #343a40;
        --input-border: #495057;
        --input-text: #e9ecef;
        --modal-bg: #2b3035;
        --modal-header-bg: #343a40;
        --dropdown-bg: #2b3035;
        --dropdown-border: rgba(255, 255, 255, 0.15);
        --dropdown-link-hover: #343a40;
        --table-bg: #2b3035;
        --table-striped-bg: rgba(255, 255, 255, 0.05);
        --table-hover-bg: rgba(255, 255, 255, 0.075);
        --border-color: #495057;
        --alert-info-bg: #1a3a4a;
        --alert-info-border: #1d4a5a;
        --alert-info-text: #8ecae6;
        --alert-success-bg: #1a3a2a;
        --alert-success-border: #1d4a3a;
        --alert-success-text: #8ecaaf;
        --list-group-bg: #2b3035;
        --list-group-border: rgba(255, 255, 255, 0.1);
        --shadow-color: rgba(0, 0, 0, 0.5);
        --meal-card-bg: #343a40;
        --select2-bg: #343a40;
        --select2-border: #495057;
    }

    /* Apply theme variables to Bootstrap components */
    [data-theme="dark"] body {
        background-color: var(--body-bg) !important;
        color: var(--text-color);
    }

    [data-theme="dark"] .card {
        background-color: var(--card-bg) !important;
        border-color: var(--card-border) !important;
        color: var(--text-color);
    }

    [data-theme="dark"] .card-body,
    [data-theme="dark"] .card-header,
    [data-theme="dark"] .card-footer {
        color: var(--text-color);
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: var(--input-bg) !important;
        border-color: var(--input-border) !important;
        color: var(--input-text) !important;
    }

    [data-theme="dark"] .form-control:focus,
    [data-theme="dark"] .form-select:focus {
        background-color: var(--input-bg) !important;
        border-color: #667eea !important;
        color: var(--input-text) !important;
        box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
    }

    [data-theme="dark"] .form-control::placeholder {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .form-label {
        color: var(--text-color);
    }

    [data-theme="dark"] .form-text,
    [data-theme="dark"] .text-muted {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .form-check-label {
        color: var(--text-color);
    }

    [data-theme="dark"] .modal-content {
        background-color: var(--modal-bg);
        color: var(--text-color);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .modal-header {
        border-color: var(--border-color);
    }

    [data-theme="dark"] .modal-footer {
        border-color: var(--border-color);
    }

    [data-theme="dark"] .dropdown-menu {
        background-color: var(--dropdown-bg);
        border-color: var(--dropdown-border);
    }

    [data-theme="dark"] .dropdown-item {
        color: var(--text-color);
    }

    [data-theme="dark"] .dropdown-item:hover,
    [data-theme="dark"] .dropdown-item:focus {
        background-color: var(--dropdown-link-hover);
        color: var(--text-color);
    }

    [data-theme="dark"] .dropdown-divider {
        border-color: var(--border-color);
    }

    [data-theme="dark"] .table {
        --bs-table-bg: var(--table-bg);
        --bs-table-striped-bg: var(--table-striped-bg);
        --bs-table-hover-bg: var(--table-hover-bg);
        color: var(--text-color);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .table-light {
        --bs-table-bg: var(--modal-header-bg);
        color: var(--text-color);
    }

    [data-theme="dark"] .table > :not(caption) > * > * {
        border-color: var(--border-color);
        background-color: var(--table-bg);
        color: var(--text-color);
    }

    [data-theme="dark"] .table-hover > tbody > tr:hover > * {
        background-color: var(--table-hover-bg);
    }

    [data-theme="dark"] .alert-info {
        background-color: var(--alert-info-bg);
        border-color: var(--alert-info-border);
        color: var(--alert-info-text);
    }

    [data-theme="dark"] .alert-success {
        background-color: var(--alert-success-bg);
        border-color: var(--alert-success-border);
        color: var(--alert-success-text);
    }

    [data-theme="dark"] .alert-danger {
        background-color: #3a1a1a;
        border-color: #4a1d1d;
        color: #f8b4b4;
    }

    [data-theme="dark"] .list-group-item {
        background-color: var(--list-group-bg);
        border-color: var(--list-group-border);
        color: var(--text-color);
    }

    [data-theme="dark"] .meal-card {
        background-color: var(--meal-card-bg) !important;
        color: var(--text-color);
    }

    [data-theme="dark"] .btn-outline-secondary {
        color: var(--text-muted);
        border-color: var(--text-muted);
    }

    [data-theme="dark"] .btn-outline-secondary:hover {
        background-color: var(--text-muted);
        color: var(--body-bg);
    }

    [data-theme="dark"] .btn-outline-primary {
        color: #8ea8f0;
        border-color: #8ea8f0;
    }

    [data-theme="dark"] .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    [data-theme="dark"] hr {
        border-color: var(--border-color);
    }

    [data-theme="dark"] footer.bg-dark {
        background-color: #0d0f11 !important;
    }

    [data-theme="dark"] .toast {
        background-color: var(--card-bg);
        color: var(--text-color);
    }

    [data-theme="dark"] .toast-header {
        background-color: var(--modal-header-bg);
        color: var(--text-color);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .toast-body {
        color: var(--text-color);
    }

    /* Select2 dark mode */
    [data-theme="dark"] .select2-container--bootstrap-5 .select2-selection {
        background-color: var(--select2-bg) !important;
        border-color: var(--select2-border) !important;
        color: var(--input-text) !important;
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-dropdown {
        background-color: var(--dropdown-bg);
        border-color: var(--dropdown-border);
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-results__option {
        color: var(--text-color);
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-results__option--highlighted {
        background-color: #667eea !important;
    }

    [data-theme="dark"] .select2-container--bootstrap-5 .select2-search__field {
        background-color: var(--input-bg) !important;
        color: var(--input-text) !important;
    }

    /* Progress bar in dark mode */
    [data-theme="dark"] .progress {
        background-color: var(--input-bg);
    }

    /* Feature icons on home page */
    [data-theme="dark"] .feature-icon {
        color: #8ea8f0 !important;
    }

    /* Spinner */
    [data-theme="dark"] .spinner-border.text-primary {
        color: #8ea8f0 !important;
    }

    /* Tracking page specific styles */
    [data-theme="dark"] body {
        background: var(--body-bg) !important;
    }

    [data-theme="dark"] .macro-bar {
        background: var(--input-bg) !important;
    }

    [data-theme="dark"] .macro-bar .progress {
        background: var(--border-color) !important;
    }

    [data-theme="dark"] .circular-progress .progress-bg {
        stroke: var(--border-color) !important;
    }

    [data-theme="dark"] .circular-progress .progress-label {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .stat-card {
        background: var(--card-bg) !important;
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .food-item {
        border-bottom-color: var(--border-color) !important;
    }

    [data-theme="dark"] .water-glass {
        border-color: #60a5fa !important;
    }

    [data-theme="dark"] .mood-btn {
        background: var(--card-bg) !important;
        border-color: var(--border-color) !important;
    }

    [data-theme="dark"] .mood-btn:hover,
    [data-theme="dark"] .mood-btn.active {
        border-color: #667eea !important;
        background: rgba(102, 126, 234, 0.2) !important;
    }

    /* Chart.js dark mode support */
    [data-theme="dark"] .card canvas {
        filter: none;
    }

    /* Date nav stays gradient, works in both modes */

    /* Badge colors in dark mode */
    [data-theme="dark"] .badge.bg-secondary {
        background-color: #495057 !important;
    }

    /* Login/Register card styles for dark mode */
    [data-theme="dark"] .login-card,
    [data-theme="dark"] .register-card {
        background: var(--card-bg) !important;
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .login-card .form-label,
    [data-theme="dark"] .register-card .form-label {
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .login-card h2,
    [data-theme="dark"] .register-card h2 {
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .btn-google {
        background: var(--input-bg) !important;
        border-color: var(--border-color) !important;
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .btn-google:hover {
        background: var(--dropdown-link-hover) !important;
    }

    [data-theme="dark"] .divider::before,
    [data-theme="dark"] .divider::after {
        border-color: var(--border-color) !important;
    }

    [data-theme="dark"] .divider span {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .register-link {
        color: var(--text-muted) !important;
    }

    /* Profile page styles */
    [data-theme="dark"] .profile-header {
        background: var(--card-bg) !important;
    }

    [data-theme="dark"] .nav-tabs .nav-link {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .nav-tabs .nav-link.active {
        background-color: var(--card-bg) !important;
        color: var(--text-color) !important;
        border-color: var(--border-color) !important;
        border-bottom-color: var(--card-bg) !important;
    }

    [data-theme="dark"] .tab-content {
        background-color: var(--card-bg) !important;
    }

    /* Weight page chart support */
    [data-theme="dark"] .chart-container {
        background: var(--card-bg) !important;
    }

    /* Weight & Profile page stat cards */
    [data-theme="dark"] .stat-card {
        background: var(--card-bg) !important;
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .stat-label {
        color: var(--text-muted) !important;
    }

    [data-theme="dark"] .quick-stat {
        background: var(--input-bg) !important;
    }

    [data-theme="dark"] .quick-stat .label {
        color: var(--text-muted) !important;
    }

    /* History table dark mode */
    [data-theme="dark"] .history-table {
        background: var(--card-bg);
    }

    /* Provider badge dark mode */
    [data-theme="dark"] .provider-badge {
        background: var(--input-bg) !important;
        color: var(--text-color) !important;
    }

    [data-theme="dark"] .provider-badge.google {
        background: rgba(66, 133, 244, 0.2) !important;
        color: #8ab4f8 !important;
    }

    [data-theme="dark"] .provider-badge.local {
        background: rgba(46, 125, 50, 0.2) !important;
        color: #81c784 !important;
    }

    /* Welcome card on home page */
    [data-theme="dark"] .welcome-card {
        background: rgba(0, 0, 0, 0.2) !important;
    }

    /* Theme toggle button styles */
    .theme-toggle {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.85);
        font-size: 1.2rem;
        padding: 0.375rem 0.5rem;
        cursor: pointer;
        transition: color 0.2s ease, transform 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .theme-toggle:hover {
        color: #ffffff;
        transform: scale(1.1);
    }

    .theme-toggle .bi-sun-fill {
        display: none;
    }

    .theme-toggle .bi-moon-fill {
        display: inline-block;
    }

    [data-theme="dark"] .theme-toggle .bi-sun-fill {
        display: inline-block;
    }

    [data-theme="dark"] .theme-toggle .bi-moon-fill {
        display: none;
    }
</style>

<script>
    // Initialize theme immediately to prevent flash
    (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    })();
</script>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="bi bi-heart-pulse"></i> AI Diet Planner
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'plan' ? 'active' : '' %>" href="/plan">Create Plan</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'tracking' ? 'active' : '' %>" href="/tracking">Tracking</a>
                </li>
                <% if (typeof user !== 'undefined' && user) { %>
                <li class="nav-item">
                    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'weight' ? 'active' : '' %>" href="/weight">Weight</a>
                </li>
                <% } %>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <button class="theme-toggle" id="themeToggle" title="Toggle dark/light mode" aria-label="Toggle theme">
                        <i class="bi bi-moon-fill"></i>
                        <i class="bi bi-sun-fill"></i>
                    </button>
                </li>
                <% if (typeof user !== 'undefined' && user) { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" alt="" class="rounded-circle me-1" width="24" height="24" style="object-fit: cover;">
                        <% } else { %>
                            <i class="bi bi-person-circle me-1"></i>
                        <% } %>
                        <%= user.name %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i> Profile</a></li>
                        <li><a class="dropdown-item" href="/weight"><i class="bi bi-graph-up"></i> Weight Tracking</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="navLogoutBtn"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                    </ul>
                </li>
                <% } else { %>
                <li class="nav-item">
                    <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link btn btn-outline-light btn-sm ms-2" href="/register">Sign Up</a>
                </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Logout functionality
    const logoutBtn = document.getElementById('navLogoutBtn');
    if (logoutBtn) {
        logoutBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
                window.location.href = '/';
            } catch (error) {
                console.error('Logout failed:', error);
            }
        });
    }

    // Theme toggle functionality
    const themeToggle = document.getElementById('themeToggle');
    
    function setTheme(theme) {
        if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.removeAttribute('data-theme');
        }
        localStorage.setItem('theme', theme);
    }

    function toggleTheme() {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
    }

    if (themeToggle) {
        themeToggle.addEventListener('click', toggleTheme);
    }

    // Listen for system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
            setTheme(e.matches ? 'dark' : 'light');
        }
    });
});
</script>
