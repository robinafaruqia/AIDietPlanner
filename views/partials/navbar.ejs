<!-- Google Fonts - Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* Theme CSS Variables - Warm Food App Design (Naluri Masak Inspired) */
    :root {
        /* Primary Colors - Warm Coral/Orange */
        --primary-color: #E85D3B;
        --primary-dark: #D14B2A;
        --primary-light: #F07253;
        --primary-gradient: linear-gradient(135deg, #E85D3B 0%, #D14B2A 100%);
        --primary-gradient-hover: linear-gradient(135deg, #F07253 0%, #E85D3B 100%);
        
        /* Accent Colors - Warm & Natural */
        --accent-coral: #E85D3B;
        --accent-gold: #F5A623;
        --accent-green: #4CAF50;
        --accent-blue: #5B9BD5;
        --accent-cream: #FDF6E3;
        
        /* Backgrounds - Warm Cream/White */
        --body-bg: #FDFCFA;
        --body-bg-secondary: #F8F5F0;
        --card-bg: #ffffff;
        --card-border: rgba(0, 0, 0, 0.05);
        --sidebar-bg: #FDF6E3;
        
        /* Text Colors - Warm & Readable */
        --text-color: #2D2D2D;
        --text-secondary: #5C5C5C;
        --text-muted: #8C8C8C;
        
        /* Form Elements */
        --input-bg: #ffffff;
        --input-border: #E8E4DE;
        --input-text: #2D2D2D;
        --input-focus-border: #E85D3B;
        
        /* Components */
        --modal-bg: #ffffff;
        --modal-header-bg: #FDFCFA;
        --dropdown-bg: #ffffff;
        --dropdown-border: rgba(0, 0, 0, 0.06);
        --dropdown-link-hover: #FDF6E3;
        --table-bg: #ffffff;
        --table-striped-bg: rgba(232, 93, 59, 0.02);
        --table-hover-bg: rgba(232, 93, 59, 0.04);
        --border-color: #E8E4DE;
        
        /* Alerts - Warm Tones */
        --alert-info-bg: #EBF5FF;
        --alert-info-border: #90CDF4;
        --alert-info-text: #2B6CB0;
        --alert-success-bg: #E8F5E9;
        --alert-success-border: #A5D6A7;
        --alert-success-text: #2E7D32;
        
        /* Misc */
        --list-group-bg: #ffffff;
        --list-group-border: rgba(0, 0, 0, 0.05);
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.03);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.08);
        --shadow-color: rgba(0, 0, 0, 0.05);
        --meal-card-bg: #ffffff;
        --select2-bg: #ffffff;
        --select2-border: #E8E4DE;
        
        /* Chart Colors - Food-Inspired */
        --chart-primary: #E85D3B;
        --chart-secondary: #F5A623;
        --chart-success: #4CAF50;
        --chart-warning: #FFC107;
        --chart-danger: #EF5350;
    }

    /* ========================================
       GLOBAL UI IMPROVEMENTS
       ======================================== */
    
    /* Inter Font Family */
    body, .btn, .form-control, .form-select, input, select, textarea {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    }

    /* Smooth Scrolling */
    html {
        scroll-behavior: smooth;
    }

    /* Page Load Animation */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    @keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Clean Life Style Cards - Soft & Minimal */
    .card {
        animation: fadeInUp 0.4s ease-out;
        transition: all 0.2s ease;
        border: 1px solid var(--card-border);
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
        background: var(--card-bg);
    }

    .card:hover {
        box-shadow: var(--shadow-md);
        border-color: rgba(232, 93, 59, 0.1);
    }

    .card.no-hover:hover {
        transform: none;
        box-shadow: var(--shadow-sm);
    }

    .card-header {
        background: transparent;
        border-bottom: 1px solid var(--border-color);
        padding: 18px 24px;
        font-weight: 600;
        font-size: 1rem;
        color: var(--text-color);
        border-radius: 12px 12px 0 0 !important;
    }

    .card-body {
        padding: 24px;
    }

    .card-footer {
        background: transparent;
        border-top: 1px solid var(--border-color);
        padding: 16px 24px;
        border-radius: 0 0 12px 12px !important;
    }

    /* Staggered Animation for Multiple Cards */
    .card:nth-child(1) { animation-delay: 0s; }
    .card:nth-child(2) { animation-delay: 0.1s; }
    .card:nth-child(3) { animation-delay: 0.2s; }
    .card:nth-child(4) { animation-delay: 0.3s; }
    .card:nth-child(5) { animation-delay: 0.4s; }

    /* Stat Cards - Clean & Simple */
    .stat-card {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 20px;
        border: 1px solid var(--card-border);
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        display: none;
    }

    .stat-card .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: 14px;
    }

    .stat-card .stat-icon.primary {
        background: rgba(232, 93, 59, 0.1);
        color: var(--primary-color);
    }

    .stat-card .stat-icon.success {
        background: rgba(76, 175, 80, 0.1);
        color: #4CAF50;
    }

    .stat-card .stat-icon.warning {
        background: rgba(245, 166, 35, 0.12);
        color: #F5A623;
    }

    .stat-card .stat-icon.danger {
        background: rgba(239, 83, 80, 0.1);
        color: #EF5350;
    }

    .stat-card .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-color);
        line-height: 1.2;
    }

    .stat-card .stat-label {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .stat-card .stat-change {
        font-size: 0.8rem;
        font-weight: 600;
        margin-top: 8px;
    }

    .stat-card .stat-change.positive {
        color: #10B981;
    }

    .stat-card .stat-change.negative {
        color: var(--accent-coral);
    }

    /* Clean Buttons - Soft & Friendly */
    .btn {
        transition: all 0.2s ease;
        font-weight: 500;
        border-radius: 8px;
        padding: 10px 18px;
        letter-spacing: 0.01em;
        font-size: 0.9rem;
    }

    .btn:active {
        transform: scale(0.98);
    }

    .btn-primary {
        background: var(--primary-color);
        border: none;
        box-shadow: none;
        color: white;
    }

    .btn-primary:hover, .btn-primary:focus {
        background: var(--primary-dark);
        box-shadow: 0 4px 12px rgba(45, 157, 143, 0.25);
        color: white;
    }

    .btn-primary:active {
        transform: scale(0.98);
        box-shadow: none;
    }

    .btn-success {
        background: #4CAF50;
        border: none;
        box-shadow: none;
    }

    .btn-success:hover {
        background: #43A047;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.25);
    }

    .btn-danger {
        background: #EF5350;
        border: none;
        box-shadow: none;
    }

    .btn-danger:hover {
        background: #E53935;
        box-shadow: 0 4px 12px rgba(239, 83, 80, 0.25);
    }

    .btn-warning {
        background: #FFC107;
        border: none;
        color: #5D4E00;
        box-shadow: none;
    }

    .btn-warning:hover {
        background: #FFB300;
        box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        color: #5D4E00;
    }

    .btn-info {
        background: #5B9BD5;
        border: none;
        color: white;
        box-shadow: none;
    }

    .btn-info:hover {
        background: #4A8AC4;
        box-shadow: 0 4px 12px rgba(91, 155, 213, 0.25);
        color: white;
    }

    .btn-outline-primary {
        border: 1.5px solid var(--primary-color);
        color: var(--primary-color);
        background: transparent;
    }

    .btn-outline-primary:hover {
        background: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }

    .btn-outline-secondary {
        border: 1.5px solid var(--border-color);
        color: var(--text-secondary);
        background: transparent;
    }

    .btn-outline-secondary:hover {
        background: var(--body-bg-secondary);
        border-color: var(--text-muted);
        color: var(--text-color);
    }

    .btn-light {
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: var(--text-color);
        box-shadow: none;
    }

    .btn-light:hover {
        background: var(--body-bg-secondary);
        border-color: var(--border-color);
    }

    /* Clean Form Inputs - Simple & Clear */
    .form-control, .form-select {
        border-radius: 8px;
        padding: 10px 14px;
        border: 1px solid var(--input-border);
        transition: all 0.15s ease;
        font-size: 0.9rem;
        background: var(--input-bg);
        color: var(--input-text);
    }

    .form-control:hover, .form-select:hover {
        border-color: #CBD5E0;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(232, 93, 59, 0.1);
        outline: none;
        background: var(--input-bg);
    }

    .form-control::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 8px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .form-text {
        color: var(--text-muted);
        font-size: 0.8rem;
        margin-top: 6px;
    }

    /* Form floating labels */
    .form-floating > .form-control,
    .form-floating > .form-select {
        height: calc(3.5rem + 2px);
        padding: 1rem 1rem;
    }

    .form-floating > label {
        padding: 1rem;
        color: var(--text-muted);
    }

    /* Checkbox and Radio - Custom */
    .form-check-input {
        width: 1.15em;
        height: 1.15em;
        border: 2px solid var(--border-color);
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .form-check-input:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .form-check-input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(232, 93, 59, 0.12);
    }

    .form-check-input[type="radio"] {
        border-radius: 50%;
    }

    .form-check-label {
        color: var(--text-color);
        font-weight: 500;
    }

    /* Input Groups */
    .input-group .form-control {
        border-radius: 10px;
    }

    .input-group > :not(:first-child):not(.dropdown-menu):not(.valid-tooltip):not(.valid-feedback):not(.invalid-tooltip):not(.invalid-feedback) {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .input-group:not(.has-validation) > :not(:last-child):not(.dropdown-toggle):not(.dropdown-menu):not(.form-floating) {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    /* Skeleton Loading */
    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 8px;
    }

    .skeleton-text {
        height: 16px;
        margin-bottom: 8px;
    }

    .skeleton-text.short {
        width: 60%;
    }

    .skeleton-title {
        height: 24px;
        width: 40%;
        margin-bottom: 16px;
    }

    .skeleton-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
    }

    .skeleton-card {
        height: 150px;
    }

    [data-theme="dark"] .skeleton {
        background: linear-gradient(90deg, #2b3035 25%, #343a40 50%, #2b3035 75%);
        background-size: 200% 100%;
    }

    /* Empty State Component */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        animation: fadeIn 0.5s ease;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: var(--text-muted);
        opacity: 0.5;
        margin-bottom: 20px;
    }

    .empty-state h5 {
        font-weight: 600;
        color: var(--text-color);
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--text-muted);
        margin-bottom: 20px;
        max-width: 300px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Enhanced Toast Notifications */
    .toast-container {
        z-index: 9999;
    }

    .toast {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        animation: slideInRight 0.3s ease;
    }

    .toast-success {
        background: linear-gradient(135deg, #10b981, #059669) !important;
        color: white !important;
    }

    .toast-success .toast-header {
        background: transparent !important;
        color: white !important;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-success .toast-body {
        color: white !important;
    }

    .toast-error {
        background: linear-gradient(135deg, #ef4444, #dc2626) !important;
        color: white !important;
    }

    .toast-error .toast-header {
        background: transparent !important;
        color: white !important;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-error .toast-body {
        color: white !important;
    }

    .toast-info {
        background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
        color: white !important;
    }

    .toast-info .toast-header {
        background: transparent !important;
        color: white !important;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .toast-info .toast-body {
        color: white !important;
    }

    /* Enhanced Progress Bars */
    .progress {
        border-radius: 10px;
        overflow: hidden;
        height: 10px;
    }

    .progress-bar {
        transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 10px;
    }

    /* Loading Spinner Enhancement */
    .spinner-border {
        animation: spin 0.8s linear infinite;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease;
    }

    [data-theme="dark"] .loading-overlay {
        background: rgba(26, 29, 33, 0.9);
    }

    /* Badge Enhancements */
    .badge {
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
    }

    /* Modal Enhancements */
    .modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
        animation: fadeInUp 0.3s ease;
    }

    .modal-header {
        border-radius: 16px 16px 0 0;
        padding: 20px 24px;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        border-radius: 0 0 16px 16px;
        padding: 16px 24px;
    }

    /* Dropdown Enhancements - Finance Dashboard Style */
    .dropdown-menu {
        border-radius: 14px;
        border: 1px solid var(--dropdown-border);
        box-shadow: var(--shadow-lg);
        padding: 10px;
        animation: fadeInUp 0.2s ease;
        background: var(--dropdown-bg);
    }

    .dropdown-item {
        border-radius: 10px;
        padding: 12px 16px;
        font-weight: 500;
        transition: all 0.2s ease;
        color: var(--text-color);
    }

    .dropdown-item:hover {
        background: rgba(63, 54, 155, 0.08);
        color: var(--primary-color);
        transform: translateX(2px);
    }

    .dropdown-item:active {
        background: rgba(63, 54, 155, 0.15);
    }

    .dropdown-item i {
        margin-right: 12px;
        width: 20px;
        text-align: center;
        color: var(--text-muted);
        transition: color 0.2s ease;
    }

    .dropdown-item:hover i {
        color: var(--primary-color);
    }

    .dropdown-divider {
        border-color: var(--border-color);
        margin: 8px 0;
    }

    /* Table Enhancements */
    .table {
        border-radius: 12px;
        overflow: hidden;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        padding: 16px;
    }

    .table td {
        padding: 16px;
        vertical-align: middle;
    }

    .table-hover tbody tr {
        transition: background-color 0.15s ease;
    }

    /* Alert Enhancements */
    .alert {
        border-radius: 12px;
        border: none;
        padding: 16px 20px;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));
        color: #059669;
    }

    .alert-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.1));
        color: #dc2626;
    }

    .alert-info {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(37, 99, 235, 0.1));
        color: #2563eb;
    }

    .alert-warning {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.1));
        color: #d97706;
    }

    /* List Group Enhancements */
    .list-group {
        border-radius: 12px;
        overflow: hidden;
    }

    .list-group-item {
        border-left: none;
        border-right: none;
        padding: 16px 20px;
        transition: background-color 0.15s ease;
    }

    .list-group-item:first-child {
        border-top: none;
    }

    .list-group-item:last-child {
        border-bottom: none;
    }

    .list-group-item-action:hover {
        background-color: rgba(102, 126, 234, 0.05);
    }

    /* Navbar - Warm & Inviting */
    .navbar {
        padding: 12px 0;
        transition: all 0.2s ease;
        background: var(--primary-color) !important;
    }

    .navbar-brand {
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
    }

    .navbar-brand i {
        color: #FFF3E0;
    }

    .nav-link {
        font-weight: 500;
        padding: 8px 14px !important;
        border-radius: 6px;
        transition: all 0.15s ease;
        font-size: 0.9rem;
    }

    .nav-link:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .nav-link.active {
        background: rgba(255, 255, 255, 0.2);
    }

    .navbar-nav .nav-item {
        margin: 0 2px;
    }

    /* User dropdown in navbar */
    .navbar .dropdown-toggle::after {
        margin-left: 8px;
        vertical-align: middle;
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: var(--body-bg-secondary);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: var(--text-muted);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--primary-color);
    }

    /* Focus States */
    *:focus-visible {
        outline: 2px solid var(--primary-color);
        outline-offset: 2px;
    }

    /* Selection Color */
    ::selection {
        background: rgba(232, 93, 59, 0.15);
        color: var(--text-color);
    }

    [data-theme="dark"] ::selection {
        background: rgba(240, 114, 83, 0.25);
    }

    /* Ripple Effect for Buttons */
    .btn-ripple {
        position: relative;
        overflow: hidden;
    }

    .btn-ripple::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.3s ease, height 0.3s ease;
    }

    .btn-ripple:active::after {
        width: 200px;
        height: 200px;
    }

    /* Tooltip Enhancement */
    .tooltip {
        font-family: 'Inter', sans-serif;
    }

    .tooltip-inner {
        border-radius: 8px;
        padding: 8px 12px;
        font-weight: 500;
    }

    /* Mobile Responsive Improvements */
    @media (max-width: 768px) {
        .card {
            margin-bottom: 16px;
        }

        .btn {
            padding: 10px 20px;
        }

        .form-control, .form-select {
            padding: 10px 14px;
        }

        .modal-content {
            margin: 10px;
            border-radius: 12px;
        }

        h1, .h1 { font-size: 1.75rem; }
        h2, .h2 { font-size: 1.5rem; }
        h3, .h3 { font-size: 1.25rem; }
    }

    [data-theme="dark"] {
        /* Primary Colors - Warm Coral for dark mode */
        --primary-color: #F07253;
        --primary-dark: #E85D3B;
        --primary-light: #FF8A6D;
        --primary-gradient: linear-gradient(135deg, #F07253 0%, #E85D3B 100%);
        --primary-gradient-hover: linear-gradient(135deg, #FF8A6D 0%, #F07253 100%);
        
