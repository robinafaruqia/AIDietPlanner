{
  "name": "ai-diet-planner",
  "version": "1.0.0",
  "description": "AI-powered diet planner with health condition considerations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:clean": "bash -c 'lsof -ti tcp:3000 | xargs kill -9 2>/dev/null || true; node server.js'",
    "dev": "nodemon server.js",
    "verify": "node verify-setup.js",
    "logs": "docker compose logs -f",
    "logs:app": "docker compose logs -f app"
  },
  "keywords": [
    "diet",
    "meal-plan",
    "health",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.101.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
